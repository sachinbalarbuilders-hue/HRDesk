# .gitignore for HRDesk

# Build artifacts
bin/
obj/
publish/
*.exe
*.dll
*.pdb

# IDE
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/

# Packages
packages/
node_modules/

# Logs
*.log
logs/
build_output*.txt

# Local settings (contain credentials — never commit)
# appsettings.json is tracked with local localhost defaults
appsettings.Development.json
appsettings.Production.json
appsettings.SmarterAsp.json

# Database files
*.sql
*.db
*.sqlite

# Deployment artifacts
cloud-publish/
publish_temp/
HRDesk.Web/publish/
HRDesk.Web/publish_temp/
HRDesk.Web/HRDesk_SmarterASP_Deployment.zip
HRDesk.Web/wwwroot/attendance_photos/
HRDesk.Web/wwwroot/assets/
*.zip

# Credentials / publish profiles (contain server passwords)
site1.PublishSettings
*.PublishSettings

# ONNX model files — large binaries (38 MB+), copy manually to App_Data/models/
# See tools/convert_spoof_to_onnx.py for conversion instructions
HRDesk.Web/App_Data/models/*.onnx

# Test/diagnostic output files
tools/*.txt
tools/spoof_test_images/
hrdesk_mobile/flutter_analyze*.txt
client/
web-client/dist/
