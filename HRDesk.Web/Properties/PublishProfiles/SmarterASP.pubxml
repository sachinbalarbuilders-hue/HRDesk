<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://hrdeskhrms-001-site1.htempurl.com/</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <MSDeployServiceURL>https://win8167.site4now.net:8172/msdeploy.axd</MSDeployServiceURL>
    <DeployIisAppPath>hrdeskhrms-001-site1</DeployIisAppPath>
    <UserName>hrdeskhrms-001</UserName>
    <AllowUntrustedCertificate>true</AllowUntrustedCertificate>
    <EnableMSDeployAppOffline>true</EnableMSDeployAppOffline>
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <TargetFramework>net8.0</TargetFramework>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
