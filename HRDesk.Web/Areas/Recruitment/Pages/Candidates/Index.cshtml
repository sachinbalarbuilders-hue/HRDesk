@page
@model HRDesk.Web.Areas.Recruitment.Pages.Candidates.IndexModel
@{
    ViewData["Title"] = "Candidates";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0">Candidates Pipeline</h2>
    <a asp-page="./Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Candidate
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Applied For</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Candidates)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@item.CandidateName</div>
                                <div class="text-muted small">@item.Email</div>
                                @if (item.ResumeData != null)
                                {
                                    <div class="mt-1">
                                        <a href="/api/Resume/@item.CandidateId" target="_blank" class="text-decoration-none small" title="View Resume">
                                            <i class="bi bi-file-earmark-person"></i> Resume
                                        </a>
                                    </div>
                                }
                            </td>
                            <td>@item.AppliedFor</td>
                            <td>@item.ApplicationDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (item.Status == "Hired")
                                {
                                    <span class="badge bg-success">Hired</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a class="dropdown-item" asp-page="./Details" asp-route-id="@item.CandidateId">
                                                <i class="bi bi-eye text-info me-2"></i> View Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Recruitment" asp-page="/Interviews/Schedule" asp-route-candidateId="@item.CandidateId">
                                                <i class="bi bi-calendar-plus text-primary me-2"></i> Schedule Interview
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-page="./Edit" asp-route-id="@item.CandidateId">
                                                <i class="bi bi-pencil text-secondary me-2"></i> Edit
                                            </a>
                                        </li>
                                        @if (item.Status != "Hired" && item.Status != "Rejected")
                                        {
                                            <li>
                                                <a class="dropdown-item fw-semibold text-success" asp-page="./Hire" asp-route-id="@item.CandidateId">
                                                    <i class="bi bi-person-plus me-2"></i> Hire Candidate
                                                </a>
                                            </li>
                                        }
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item text-danger" asp-page="./Delete" asp-route-id="@item.CandidateId">
                                                <i class="bi bi-trash me-2"></i> Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Candidates.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No candidates found in the pipeline.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
