@page "{id:int}"
@model HRDesk.Web.Areas.Recruitment.Pages.Candidates.DetailsModel
@{
    ViewData["Title"] = "Candidate Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0">
        <a asp-page="./Index" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-2"></i></a>
        Candidate Profile
    </h2>
    <div>
        <a asp-page="./Edit" asp-route-id="@Model.Candidate.CandidateId" class="btn btn-outline-secondary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        @if (Model.Candidate.Status != "Hired" && Model.Candidate.Status != "Rejected")
        {
            <a asp-page="./Hire" asp-route-id="@Model.Candidate.CandidateId" class="btn btn-success ms-2">
                <i class="bi bi-person-plus"></i> Hire Candidate
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Personal Info & Resume -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body text-center pt-5 pb-4">
                <div class="avatar bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                    @Model.Candidate.CandidateName.Substring(0, 1).ToUpper()
                </div>
                <h4 class="mb-1">@Model.Candidate.CandidateName</h4>
                <p class="text-muted mb-3">@Model.Candidate.AppliedFor</p>
                
                <div class="d-flex justify-content-center gap-2 mb-4">
                    @if (Model.Candidate.Status == "Hired")
                    {
                        <span class="badge bg-success px-3 py-2">Hired</span>
                    }
                    else if (Model.Candidate.Status == "Rejected")
                    {
                        <span class="badge bg-danger px-3 py-2">Rejected</span>
                    }
                    else
                    {
                        <span class="badge bg-info px-3 py-2">@Model.Candidate.Status</span>
                    }
                </div>

                @if (Model.Candidate.ResumeData != null)
                {
                    <a href="/api/Resume/@Model.Candidate.CandidateId" target="_blank" class="btn btn-primary w-100">
                        <i class="bi bi-file-earmark-person"></i> View Resume
                    </a>
                }
            </div>
            <ul class="list-group list-group-flush border-top">
                <li class="list-group-item px-4 py-3 d-flex align-items-center">
                    <i class="bi bi-envelope text-muted me-3 fs-5"></i>
                    <div>
                        <small class="d-block text-muted">Email</small>
                        <a href="mailto:@Model.Candidate.Email" class="text-decoration-none text-dark">@(string.IsNullOrEmpty(Model.Candidate.Email) ? "N/A" : Model.Candidate.Email)</a>
                    </div>
                </li>
                <li class="list-group-item px-4 py-3 d-flex align-items-center">
                    <i class="bi bi-telephone text-muted me-3 fs-5"></i>
                    <div>
                        <small class="d-block text-muted">Phone</small>
                        <a href="tel:@Model.Candidate.Phone" class="text-decoration-none text-dark">@(string.IsNullOrEmpty(Model.Candidate.Phone) ? "N/A" : Model.Candidate.Phone)</a>
                    </div>
                </li>
                <li class="list-group-item px-4 py-3 d-flex align-items-center">
                    <i class="bi bi-calendar-date text-muted me-3 fs-5"></i>
                    <div>
                        <small class="d-block text-muted">Application Date</small>
                        <span>@Model.Candidate.ApplicationDate.ToString("MMM dd, yyyy")</span>
                    </div>
                </li>
                <li class="list-group-item px-4 py-3 d-flex align-items-center">
                    <i class="bi bi-box-arrow-in-right text-muted me-3 fs-5"></i>
                    <div>
                        <small class="d-block text-muted">Source</small>
                        <span>@(string.IsNullOrEmpty(Model.Candidate.Source) ? "-" : Model.Candidate.Source)</span>
                    </div>
                </li>
                <li class="list-group-item px-4 py-3 d-flex align-items-center">
                    <i class="bi bi-cash text-muted me-3 fs-5"></i>
                    <div>
                        <small class="d-block text-muted">Current Salary</small>
                        <span>@(Model.Candidate.CurrentSalary.HasValue ? "₹" + Model.Candidate.CurrentSalary.Value.ToString("N0") : "-")</span>
                    </div>
                </li>
                <li class="list-group-item px-4 py-3 d-flex align-items-center">
                    <i class="bi bi-cash-stack text-muted me-3 fs-5"></i>
                    <div>
                        <small class="d-block text-muted">Expected Salary</small>
                        <span>@(Model.Candidate.ExpectedSalary.HasValue ? "₹" + Model.Candidate.ExpectedSalary.Value.ToString("N0") : "-")</span>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <!-- Right Column: Details & Interviews -->
    <div class="col-md-8">
        
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0"><i class="bi bi-card-text text-primary me-2"></i> Notes</h5>
            </div>
            <div class="card-body p-4">
                @if (string.IsNullOrWhiteSpace(Model.Candidate.Notes))
                {
                    <p class="text-muted mb-0 fst-italic">No notes provided for this candidate.</p>
                }
                else
                {
                    <p class="mb-0" style="white-space: pre-wrap;">@Model.Candidate.Notes</p>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-calendar-check text-primary me-2"></i> Interviews</h5>
                <a asp-area="Recruitment" asp-page="/Interviews/Schedule" asp-route-candidateId="@Model.Candidate.CandidateId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-calendar-plus"></i> Schedule New
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.Interviews.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Date</th>
                                    <th>Round</th>
                                    <th>Interviewer</th>
                                    <th>Status</th>
                                    <th>Result</th>
                                    <th>Feedback</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var interview in Model.Interviews)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold">@interview.InterviewDateTime.ToString("MMM dd, yyyy")</div>
                                            <div class="text-muted small">@interview.InterviewDateTime.ToString("hh:mm tt")</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@interview.Round</span><br/>
                                            <small class="text-muted">@interview.InterviewType</small>
                                        </td>
                                        <td>@interview.InterviewerName</td>
                                        <td>
                                            @if (interview.Status == "Completed")
                                            {
                                                <span class="text-success fw-semibold"><i class="bi bi-check-circle"></i> Completed</span>
                                            }
                                            else if (interview.Status == "Cancelled")
                                            {
                                                <span class="text-danger fw-semibold"><i class="bi bi-x-circle"></i> Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="text-info fw-semibold"><i class="bi bi-clock"></i> @interview.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @if (interview.Result == "Pass")
                                            {
                                                <span class="badge bg-success">Pass</span>
                                            }
                                            else if (interview.Result == "Fail")
                                            {
                                                <span class="badge bg-danger">Fail</span>
                                            }
                                            else if (interview.Result == "Hold")
                                            {
                                                <span class="badge bg-warning text-dark">Hold</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(interview.Feedback))
                                            {
                                                <small class="text-muted d-inline-block text-truncate" style="max-width: 200px;" title="@interview.Feedback">@interview.Feedback</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        <p class="mb-0">No interviews have been scheduled yet.</p>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
