@page
@model HRDesk.Web.Areas.Recruitment.Pages.Candidates.HireModel
@{
    ViewData["Title"] = "Hire Candidate";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0">Hire Candidate</h2>
    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Cancel
    </a>
</div>

<div class="alert alert-success">
    <i class="bi bi-info-circle-fill"></i> You are about to hire <strong>@Model.Candidate.CandidateName</strong>. 
    This will create a new Employee record in the system.
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Candidate.CandidateId" />
            
            <h5 class="mb-3">Employee Details</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Employee.EmployeeId" class="form-label">Employee ID (Machine ID) *</label>
                    <input asp-for="Employee.EmployeeId" class="form-control" type="number" required />
                    <span asp-validation-for="Employee.EmployeeId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Employee.EmployeeName" class="form-label">Employee Name *</label>
                    <input asp-for="Employee.EmployeeName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Employee.Phone" class="form-label">Phone</label>
                    <input asp-for="Employee.Phone" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Employee.DepartmentId" class="form-label">Department</label>
                    <select asp-for="Employee.DepartmentId" asp-items="Model.Departments" class="form-select">
                        <option value="">-- Select Department --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Employee.DesignationId" class="form-label">Designation</label>
                    <select asp-for="Employee.DesignationId" asp-items="Model.Designations" class="form-select">
                        <option value="">-- Select Designation --</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="Employee.JoiningDate" class="form-label">Joining Date *</label>
                    <input asp-for="Employee.JoiningDate" type="date" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="ProbationDays" class="form-label">Probation Period (Days)</label>
                    <input asp-for="ProbationDays" class="form-control" type="number" min="0" max="365" />
                    <span asp-validation-for="ProbationDays" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Employee.Status" class="form-label">Status</label>
                    <select asp-for="Employee.Status" class="form-select">
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                        <option value="suspended">Suspended</option>
                    </select>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-person-check-fill"></i> Confirm Hire
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var empIdInput = document.getElementById('Employee_EmployeeId');
            var errorSpan = document.querySelector('span[data-valmsg-for="Employee.EmployeeId"]');
            
            if (empIdInput) {
                empIdInput.addEventListener('input', function () {
                    var id = this.value;
                    if (!id) {
                        errorSpan.textContent = '';
                        empIdInput.classList.remove('is-invalid', 'is-valid');
                        return;
                    }

                    fetch('/api/EmployeeApi/check-id?id=' + id)
                        .then(response => response.json())
                        .then(data => {
                            if (data.exists) {
                                errorSpan.textContent = 'Employee ID ' + id + ' is already taken.';
                                errorSpan.className = 'text-danger small';
                                empIdInput.classList.add('is-invalid');
                                empIdInput.classList.remove('is-valid');
                            } else {
                                errorSpan.textContent = 'Available';
                                errorSpan.className = 'text-success small fw-bold';
                                empIdInput.classList.remove('is-invalid');
                                empIdInput.classList.add('is-valid');
                            }
                        });
                });
            }
        });
    </script>
}
