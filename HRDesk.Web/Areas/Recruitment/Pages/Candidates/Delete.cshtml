@page
@model HRDesk.Web.Areas.Recruitment.Pages.Candidates.DeleteModel
@{
    ViewData["Title"] = "Delete Candidate";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0 text-danger">Delete Candidate</h2>
    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Cancel
    </a>
</div>

<div class="alert alert-danger">
    <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Are you sure you want to delete this candidate?</h5>
    <p class="mb-0">This action cannot be undone. All notes and history associated with this candidate will be permanently removed.</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Candidate.CandidateName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Candidate.Email</dd>

            <dt class="col-sm-3">Applied For</dt>
            <dd class="col-sm-9">@Model.Candidate.AppliedFor</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">@Model.Candidate.Status</span>
            </dd>

            <dt class="col-sm-3">Application Date</dt>
            <dd class="col-sm-9">@Model.Candidate.ApplicationDate.ToString("MMM dd, yyyy")</dd>
        </dl>
    </div>
    <div class="card-footer bg-white mt-2">
        <form method="post">
            <input type="hidden" asp-for="Candidate.CandidateId" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Confirm Delete
            </button>
        </form>
    </div>
</div>
