@page
@model HRDesk.Web.Pages.Portal.MyAttendanceModel
@{
    ViewData["Title"] = "My Attendance Sheet";
    var monthDate = new DateTime(Model.SelectedYear, Model.SelectedMonth, 1);
}

<div class="container-fluid px-0 pb-5">
    <!-- Header & Month Filter -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 mt-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-page="/Portal/Dashboard" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h4 class="mb-0 fw-bold">My Attendance Records</h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">
                    @monthDate.ToString("MMMM yyyy")
                </span>
            </div>
            <p class="text-muted mb-0 small">Review daily biometric punches, recorded working hours, and monthly attendance breakdown.</p>
        </div>

        <form method="get" class="d-flex align-items-center gap-2">
            <select name="month" class="form-select form-select-sm shadow-sm" style="width: 140px;">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == Model.SelectedMonth)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                }
            </select>
            <select name="year" class="form-select form-select-sm shadow-sm" style="width: 100px;">
                @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
                {
                    <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-primary shadow-sm">
                <i class="bi bi-filter me-1"></i>View
            </button>
        </form>
    </div>

    <!-- Monthly Summary Badges -->
    <div class="row g-2 mb-4">
        <div class="col-6 col-md-3 col-lg-2">
            <div class="p-3 rounded-3 bg-success-subtle text-success border border-success-subtle text-center">
                <div class="fs-4 fw-bold">@Model.Summary.PresentCount</div>
                <div class="small fw-semibold">Present Days</div>
            </div>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <div class="p-3 rounded-3 bg-danger-subtle text-danger border border-danger-subtle text-center">
                <div class="fs-4 fw-bold">@Model.Summary.AbsentCount</div>
                <div class="small fw-semibold">Absent</div>
            </div>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <div class="p-3 rounded-3 bg-warning-subtle text-warning border border-warning-subtle text-center">
                <div class="fs-4 fw-bold">@Model.Summary.HalfDayCount</div>
                <div class="small fw-semibold">Half Days</div>
            </div>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <div class="p-3 rounded-3 bg-info-subtle text-info border border-info-subtle text-center">
                <div class="fs-4 fw-bold">@Model.Summary.LeaveCount</div>
                <div class="small fw-semibold">Paid Leaves</div>
            </div>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <div class="p-3 rounded-3 bg-secondary-subtle text-secondary border rounded-center text-center">
                <div class="fs-4 fw-bold">@Model.Summary.WeekoffCount</div>
                <div class="small fw-semibold">Week Off / CO</div>
            </div>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <div class="p-3 rounded-3 bg-primary text-white text-center shadow-sm">
                <div class="fs-4 fw-bold">@Model.Summary.PayableDays</div>
                <div class="small fw-semibold">Payable Days</div>
            </div>
        </div>
    </div>

    <!-- Attendance Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Date</th>
                            <th>Day</th>
                            <th>Shift</th>
                            <th>In-Time</th>
                            <th>Out-Time</th>
                            <th>Work Hours</th>
                            <th>Late / Early</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.AttendanceLogs.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-x fs-2 d-block mb-2 text-muted"></i>
                                    No attendance records found for @monthDate.ToString("MMMM yyyy").
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Model.AttendanceLogs)
                            {
                                var isWeekend = log.RecordDate.DayOfWeek == DayOfWeek.Sunday || log.Status?.Contains("Weekoff") == true;
                                <tr class="@(isWeekend ? "table-light" : "")">
                                    <td class="ps-4 fw-bold">@log.RecordDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge bg-body-secondary text-body-secondary">
                                            @log.RecordDate.ToString("ddd")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="small">@(log.Shift?.ShiftName ?? "Regular")</span>
                                    </td>
                                    <td>
                                        @if (log.InTime.HasValue)
                                        {
                                            <span class="fw-semibold text-success">@log.InTime.Value.ToString(@"hh\:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">--:--</span>
                                        }
                                    </td>
                                    <td>
                                        @if (log.OutTime.HasValue)
                                        {
                                            <span class="fw-semibold text-primary">@log.OutTime.Value.ToString(@"hh\:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">--:--</span>
                                        }
                                    </td>
                                    <td>
                                        @if (log.WorkMinutes > 0)
                                        {
                                            <span>@((log.WorkMinutes / 60.0).ToString("0.00")) hrs</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0.00 hrs</span>
                                        }
                                    </td>
                                    <td>
                                        @if (log.LateMinutes > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle small me-1">
                                                Late: @log.LateMinutes min
                                            </span>
                                        }
                                        @if (log.EarlyMinutes > 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">
                                                Early: @log.EarlyMinutes min
                                            </span>
                                        }
                                        @if (log.LateMinutes <= 0 && log.EarlyMinutes <= 0)
                                        {
                                            <span class="text-muted small">On Time</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var status = log.Status ?? "Absent";
                                            var badgeClass = status switch
                                            {
                                                "Present" => "bg-success text-white",
                                                "Weekoff" or "W/O" or "CO" => "bg-secondary text-white",
                                                "COHF" or "PHF" or "SHF" or "Half Day" => "bg-warning text-dark",
                                                "Holiday" => "bg-info text-dark",
                                                "Absent" => "bg-danger text-white",
                                                _ => "bg-primary text-white"
                                            };
                                        }
                                        <span class="badge @badgeClass rounded-pill px-3 py-1">
                                            @status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
