@page
@model HRDesk.Web.Pages.Portal.MyPayslipsModel
@{
    ViewData["Title"] = "My Payslips";
}

<div class="container-fluid px-0 pb-5">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 mt-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-page="/Portal/Dashboard" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h4 class="mb-0 fw-bold">My Monthly Payslips</h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">
                    Salary Statements
                </span>
            </div>
            <p class="text-muted mb-0 small">View your monthly salary statements, gross earnings, standard deductions, and net payable amounts.</p>
        </div>
    </div>

    <!-- Payslips List -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Month / Year</th>
                            <th>Payable Days</th>
                            <th>Gross Earnings</th>
                            <th>Total Deductions</th>
                            <th>Net Pay</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Payslips.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt fs-2 d-block mb-2 text-muted"></i>
                                    No processed payslips found for your account.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var slip in Model.Payslips)
                            {
                                var displayMonth = DateTime.TryParseExact(slip.Month + "-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsedDate) 
                                    ? parsedDate.ToString("MMMM yyyy") 
                                    : slip.Month;
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-sm rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                                <i class="bi bi-file-earmark-text"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-body-emphasis">@displayMonth</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">@slip.Month</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@slip.PayableDays days</span>
                                    </td>
                                    <td>
                                        <span class="text-success fw-semibold">₹@slip.GrossSalary.ToString("N2")</span>
                                    </td>
                                    <td>
                                        <span class="text-danger fw-semibold">₹@slip.TotalDeductions.ToString("N2")</span>
                                    </td>
                                    <td>
                                        <span class="fs-6 fw-bold text-primary">₹@slip.NetSalary.ToString("N2")</span>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = slip.Status switch
                                            {
                                                "Paid" => "bg-success text-white",
                                                "Processed" => "bg-primary text-white",
                                                _ => "bg-secondary text-white"
                                            };
                                        }
                                        <span class="badge @badgeClass rounded-pill px-3 py-1">
                                            @slip.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-page="/Payroll/Payslip" asp-route-id="@slip.Id" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm">
                                            <i class="bi bi-eye"></i>
                                            <span>View Payslip</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
