@page
@model HRDesk.Web.Pages.Portal.DashboardModel
@{
    ViewData["Title"] = "My Self-Service Portal";
}

<div class="container-fluid px-0 pb-5">
    @if (Model.CurrentEmployee == null)
    {
        <div class="alert alert-warning shadow-sm border-0 d-flex align-items-center gap-3 p-4 my-4" role="alert">
            <i class="bi bi-person-exclamation fs-2 text-warning"></i>
            <div>
                <h5 class="fw-bold mb-1">Employee Profile Not Linked</h5>
                <p class="mb-0 text-muted">Your user account is not linked to an Employee record yet. Please ask HR/Admin to map your user account under <strong>Employees > Edit Profile</strong>.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Welcome Banner -->
        <div class="card border-0 shadow-sm mb-4 bg-primary text-white overflow-hidden position-relative" style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
            <div class="card-body p-4 position-relative" style="z-index: 1;">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-lg rounded-circle bg-white text-primary d-flex align-items-center justify-content-center fw-bold fs-3 shadow-sm" style="width: 64px; height: 64px;">
                            @(Model.CurrentEmployee.EmployeeName.Length > 0 ? Model.CurrentEmployee.EmployeeName.Substring(0, 1).ToUpper() : "E")
                        </div>
                        <div>
                            <span class="badge bg-white text-primary rounded-pill px-3 py-1 mb-1 fw-bold small">Employee Portal</span>
                            <h3 class="fw-bold mb-0 text-white">Welcome back, @Model.CurrentEmployee.EmployeeName!</h3>
                            <p class="mb-0 text-white-50 small">
                                <span>ID: #@Model.CurrentEmployee.EmployeeId</span>
                                @if (Model.CurrentEmployee.Department != null)
                                {
                                    <span> &bull; @Model.CurrentEmployee.Department.DepartmentName</span>
                                }
                                @if (Model.CurrentEmployee.Designation != null)
                                {
                                    <span> &bull; @Model.CurrentEmployee.Designation.DesignationName</span>
                                }
                            </p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-page="/Portal/MyLeaves" class="btn btn-light text-primary fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                            <i class="bi bi-calendar-plus"></i>
                            <span>Apply for Leave</span>
                        </a>
                        <a asp-page="/Portal/MyAttendance" class="btn btn-outline-light d-inline-flex align-items-center gap-2">
                            <i class="bi bi-clock-history"></i>
                            <span>My Attendance</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 1: Today's Status & Shift Info -->
        <div class="row g-3 mb-4">
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-body-emphasis">Today's Punch Status</h6>
                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1 small">
                                @DateTime.Today.ToString("dd MMM yyyy")
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="avatar-md rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center fs-3" style="width: 52px; height: 52px;">
                                <i class="bi bi-fingerprint"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Status</div>
                                <div class="fs-5 fw-bold text-body-emphasis">
                                    @(Model.TodayAttendance?.Status ?? "Not Punched Yet")
                                </div>
                            </div>
                        </div>
                        <div class="row g-2 pt-2 border-top text-center">
                            <div class="col-6 border-end">
                                <div class="text-muted small">In-Time</div>
                                <div class="fw-bold text-success">
                                    @(Model.TodayAttendance?.InTime?.ToString(@"hh\:mm") ?? "--:--")
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Out-Time</div>
                                <div class="fw-bold text-primary">
                                    @(Model.TodayAttendance?.OutTime?.ToString(@"hh\:mm") ?? "--:--")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-body-emphasis">Assigned Shift</h6>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
                                Schedule
                            </span>
                        </div>
                        @if (Model.TodayShift != null)
                        {
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="avatar-md rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center fs-3" style="width: 52px; height: 52px;">
                                    <i class="bi bi-clock"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-body-emphasis fs-5">@Model.TodayShift.ShiftName</div>
                                    <div class="text-muted small">@Model.TodayShift.ShiftCode</div>
                                </div>
                            </div>
                            <div class="p-2 bg-body-tertiary rounded-3 text-center small fw-semibold">
                                <span>@Model.TodayShift.StartTime.ToString(@"hh\:mm")</span>
                                <span class="mx-2 text-muted">&rarr;</span>
                                <span>@Model.TodayShift.EndTime.ToString(@"hh\:mm")</span>
                                <span class="text-muted ms-2">(@Model.TodayShift.WorkingHours hrs)</span>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3 text-muted small">
                                <i class="bi bi-calendar-event fs-3 d-block mb-1 text-muted"></i>
                                General Regular Shift
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-12 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-body-emphasis">Month-To-Date Summary</h6>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small">
                                @DateTime.Today.ToString("MMMM yyyy")
                            </span>
                        </div>
                        <div class="row g-2 text-center">
                            <div class="col-4">
                                <div class="p-2 rounded-3 bg-success-subtle text-success">
                                    <div class="fs-4 fw-bold">@(Model.MonthlySummary?.PresentCount ?? 0)</div>
                                    <div class="small fw-semibold" style="font-size: 0.75rem;">Present</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded-3 bg-danger-subtle text-danger">
                                    <div class="fs-4 fw-bold">@(Model.MonthlySummary?.AbsentCount ?? 0)</div>
                                    <div class="small fw-semibold" style="font-size: 0.75rem;">Absent</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                                    <div class="fs-4 fw-bold">@(Model.MonthlySummary?.PayableDays ?? 0)</div>
                                    <div class="small fw-semibold" style="font-size: 0.75rem;">Payable</div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 text-center">
                            <a asp-page="/Portal/MyAttendance" class="small text-decoration-none fw-semibold text-primary">
                                View Full Month Sheet &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: Leave Quotas & Upcoming Holidays -->
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header py-3 bg-transparent d-flex align-items-center justify-content-between border-bottom">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-briefcase text-primary me-2"></i>My Leave Balances (@DateTime.Today.Year)</h6>
                        <a asp-page="/Portal/MyLeaves" class="btn btn-sm btn-outline-primary">Apply Leave</a>
                    </div>
                    <div class="card-body p-4">
                        @if (!Model.LeaveBalances.Any())
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-card-checklist fs-2 d-block mb-1 text-muted"></i>
                                No leave allocations recorded for this year.
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                @foreach (var alloc in Model.LeaveBalances)
                                {
                                    var remaining = alloc.TotalAllocated + alloc.OpeningBalance - alloc.UsedCount;
                                    var percentage = alloc.TotalAllocated > 0 ? (int)((remaining / alloc.TotalAllocated) * 100) : 0;
                                    <div class="col-sm-6">
                                        <div class="p-3 border rounded-3 bg-body-tertiary">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="fw-bold text-body-emphasis">@(alloc.LeaveType?.Name ?? "Leave")</span>
                                                <span class="badge bg-primary rounded-pill">@remaining Days Left</span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @percentage%"></div>
                                            </div>
                                            <div class="d-flex justify-content-between text-muted small mt-2" style="font-size: 0.75rem;">
                                                <span>Used: @alloc.UsedCount</span>
                                                <span>Total: @alloc.TotalAllocated</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header py-3 bg-transparent border-bottom">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-gift text-primary me-2"></i>Upcoming Holidays</h6>
                    </div>
                    <div class="card-body p-4">
                        @if (!Model.UpcomingHolidays.Any())
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-calendar2-check fs-2 d-block mb-1 text-muted"></i>
                                No upcoming public holidays scheduled.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var hol in Model.UpcomingHolidays)
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 border bg-body-surface">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-sm rounded-3 bg-danger-subtle text-danger d-flex flex-column align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px; line-height: 1;">
                                                <span style="font-size: 0.7rem;">@hol.StartDate.ToString("MMM")</span>
                                                <span class="fs-6">@hol.StartDate.Day</span>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-body-emphasis small">@hol.HolidayName</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">@hol.StartDate.ToString("dddd, dd MMM yyyy")</div>
                                            </div>
                                        </div>
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill small">Holiday</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
