@page
@model HRDesk.Web.Pages.Portal.MyLeavesModel
@{
    ViewData["Title"] = "My Leaves & Applications";
}

<div class="container-fluid px-0 pb-5">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 mt-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-page="/Portal/Dashboard" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h4 class="mb-0 fw-bold">My Leaves & Quotas</h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">
                    Year @DateTime.Today.Year
                </span>
            </div>
            <p class="text-muted mb-0 small">Track remaining leave balances, apply for paid/sick leaves, and monitor approval status.</p>
        </div>

        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#applyLeaveModal">
            <i class="bi bi-plus-lg"></i>
            <span>Apply for Leave</span>
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Leave Balances Quota Cards -->
    <div class="row g-3 mb-4">
        @if (!Model.Allocations.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm p-4 text-center text-muted small">
                    <i class="bi bi-info-circle fs-3 d-block mb-2 text-primary"></i>
                    No leave quotas configured for your profile in @DateTime.Today.Year. Please contact HR.
                </div>
            </div>
        }
        else
        {
            @foreach (var alloc in Model.Allocations)
            {
                var remaining = alloc.TotalAllocated + alloc.OpeningBalance - alloc.UsedCount;
                var pct = alloc.TotalAllocated > 0 ? (int)((remaining / alloc.TotalAllocated) * 100) : 0;
                <div class="col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-body-emphasis">@(alloc.LeaveType?.Name ?? "Leave")</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                                    @remaining Left
                                </span>
                            </div>
                            <div class="fs-3 fw-bold text-body-emphasis mb-2">
                                @remaining <span class="fs-6 text-muted fw-normal">/ @alloc.TotalAllocated days</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @pct%"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted small" style="font-size: 0.75rem;">
                                <span>Used: @alloc.UsedCount</span>
                                <span>Opening: @alloc.OpeningBalance</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Submitted Applications Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header py-3 bg-transparent border-bottom">
            <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history text-primary me-2"></i>My Leave Application History</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Application #</th>
                            <th>Leave Type</th>
                            <th>Date Range</th>
                            <th>Total Days</th>
                            <th>Reason</th>
                            <th>Submitted On</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Applications.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-check fs-2 d-block mb-2 text-muted"></i>
                                    You haven't submitted any leave applications yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var app in Model.Applications)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#@app.Id</td>
                                    <td>
                                        <span class="badge bg-body-secondary text-body-emphasis">
                                            @(app.LeaveType?.Name ?? "Leave")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@app.StartDate.ToString("dd MMM yyyy")</span>
                                        @if (app.EndDate != app.StartDate)
                                        {
                                            <span class="text-muted mx-1">&rarr;</span>
                                            <span class="fw-semibold">@app.EndDate.ToString("dd MMM yyyy")</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-bold">@app.TotalDays day(s)</span>
                                    </td>
                                    <td>
                                        <span class="small text-muted text-truncate d-inline-block" style="max-width: 250px;">
                                            @app.Reason
                                        </span>
                                    </td>
                                    <td>
                                        <span class="small text-muted">@app.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = app.Status switch
                                            {
                                                "Approved" => "bg-success text-white",
                                                "Rejected" => "bg-danger text-white",
                                                _ => "bg-warning text-dark"
                                            };
                                        }
                                        <span class="badge @badgeClass rounded-pill px-3 py-1">
                                            @app.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Apply Leave Modal -->
<div class="modal fade" id="applyLeaveModal" tabindex="-1" aria-labelledby="applyLeaveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post">
                <div class="modal-header py-3">
                    <h5 class="modal-title fw-bold" id="applyLeaveModalLabel">
                        <i class="bi bi-calendar-plus text-primary me-2"></i>Apply for Leave
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label asp-for="Input.LeaveTypeId" class="form-label fw-bold small text-muted">Leave Type <span class="text-danger">*</span></label>
                        <select asp-for="Input.LeaveTypeId" class="form-select shadow-sm" required>
                            <option value="">-- Select Leave Type --</option>
                            @foreach (var lt in Model.AvailableLeaveTypes)
                            {
                                <option value="@lt.Id">@lt.Name (@lt.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="Input.LeaveTypeId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="Input.StartDate" class="form-label fw-bold small text-muted">Start Date <span class="text-danger">*</span></label>
                            <input asp-for="Input.StartDate" type="date" class="form-control shadow-sm" required />
                            <span asp-validation-for="Input.StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Input.EndDate" class="form-label fw-bold small text-muted">End Date <span class="text-danger">*</span></label>
                            <input asp-for="Input.EndDate" type="date" class="form-control shadow-sm" required />
                            <span asp-validation-for="Input.EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Reason" class="form-label fw-bold small text-muted">Reason <span class="text-danger">*</span></label>
                        <textarea asp-for="Input.Reason" class="form-control shadow-sm" rows="3" placeholder="Provide a brief explanation for your leave request..." required></textarea>
                        <span asp-validation-for="Input.Reason" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer py-3 bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-send me-1"></i>Submit Application
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
