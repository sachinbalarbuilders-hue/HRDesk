@page "{id:int}"
@model HRDesk.Web.Pages.Employees.EditModel
@{
    ViewData["Title"] = "Edit Employee";
    var isActive = string.Equals(Model.Input.Status, "active", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Edit Employee</h4>
        <p class="text-muted mb-0 small">Update employee record — ID: <code>@Model.Id</code></p>
    </div>
    <div class="d-flex gap-2">
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger py-1 px-3 mb-0 d-flex align-items-center small shadow-sm">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
    </div>
}
        <form method="post" asp-page-handler="ToggleStatus">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn @(isActive ? "btn-outline-secondary" : "btn-outline-success")">
                <i class="bi @(isActive ? "bi-slash-circle" : "bi-check-circle") me-1"></i>
                @(isActive ? "Deactivate" : "Activate")
            </button>
        </form>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0"><i class="bi bi-person-gear me-2 text-primary"></i>Employee Details</h5>
        <span class="badge @(isActive ? "text-bg-success" : "text-bg-secondary")">
            @(isActive ? "ACTIVE" : "INACTIVE")
        </span>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" style="display:none;"></div>

            <div class="row g-4">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Machine / Employee ID</label>
                    <input class="form-control font-monospace" value="@Model.Id" readonly />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.BiometricCode" class="form-label fw-semibold">HiveStaff Code (with Prefix)</label>
                    <input asp-for="Input.BiometricCode" class="form-control font-monospace" placeholder="e.g. EMP#001" />
                    <span class="text-muted extra-small">Leave blank if identical to Machine ID</span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.EmployeeName" class="form-label fw-semibold"></label>
                    <input asp-for="Input.EmployeeName" class="form-control" />
                    <span asp-validation-for="Input.EmployeeName" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.DepartmentId" class="form-label fw-semibold"></label>
                    <select asp-for="Input.DepartmentId" class="form-select" asp-items="Model.DepartmentOptions">
                        <option value="">(None)</option>
                    </select>
                    <span asp-validation-for="Input.DepartmentId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.DesignationId" class="form-label fw-semibold"></label>
                    <select asp-for="Input.DesignationId" class="form-select" asp-items="Model.DesignationOptions">
                        <option value="">(None)</option>
                    </select>
                    <span asp-validation-for="Input.DesignationId" class="text-danger small"></span>
                </div>


                <div class="col-md-4">
                    <label asp-for="Input.Weekoff" class="form-label fw-semibold"></label>
                    <select asp-for="Input.Weekoff" class="form-select" asp-items="Model.WeekoffOptions">
                        <option value="">Select weekoff</option>
                    </select>
                    <span asp-validation-for="Input.Weekoff" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.JoiningDate" class="form-label fw-semibold"></label>
                    <input asp-for="Input.JoiningDate" class="form-control" type="date" />
                    <span asp-validation-for="Input.JoiningDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.ProbationDays" class="form-label fw-semibold"></label>
                    <input asp-for="Input.ProbationDays" class="form-control" type="number" min="0" max="365" />
                    <span asp-validation-for="Input.ProbationDays" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.ResignationDate" class="form-label fw-semibold"></label>
                    <input asp-for="Input.ResignationDate" class="form-control" type="date" />
                    <div class="form-text text-muted">Benefits like grace period & paid leave restricted from this date.</div>
                    <span asp-validation-for="Input.ResignationDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.LastWorkingDate" class="form-label fw-semibold"></label>
                    <input asp-for="Input.LastWorkingDate" class="form-control" type="date" />
                    <div class="form-text text-muted">Leave blank if still active. Weekoffs/absents won't be generated after this date.</div>
                    <span asp-validation-for="Input.LastWorkingDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.DateOfBirth" class="form-label fw-semibold"></label>
                    <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="Input.DateOfBirth" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.PhotoUpload" class="form-label fw-semibold"></label>
                    @if (!string.IsNullOrEmpty(Model.CurrentPhotoPath))
                    {
                        <div class="mb-2 d-flex align-items-center gap-2">
                            <span class="badge text-bg-info">Current Photo: Loaded from Database</span>
                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" id="btnCropExisting" data-url="/api/Thumbnail?employeeId=@Model.Id&width=800&height=800">
                                <i class="bi bi-crop"></i> Re-crop
                            </button>
                        </div>
                    }
                    <input asp-for="Input.PhotoUpload" class="form-control" type="file" accept="image/jpeg,image/png" />
                    <input type="hidden" asp-for="Input.CroppedPhotoBase64" />
                    <div class="form-text text-muted">Upload a new photo to replace the existing one. You can crop it after selecting.</div>
                    <span asp-validation-for="Input.PhotoUpload" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.Phone" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Phone" class="form-control" />
                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Status" class="form-label fw-semibold"></label>
                    <select asp-for="Input.Status" class="form-select" asp-items="Model.StatusOptions"></select>
                    <span asp-validation-for="Input.Status" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>Save Changes
                </button>
                <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<!-- Cropper Modal -->
<div class="modal fade" id="cropperModal" tabindex="-1" aria-labelledby="cropperModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="cropperModalLabel">Crop Profile Photo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="img-container" style="max-height: 500px; display:flex; justify-content:center; background-color: #f8f9fa;">
          <img id="imageToCrop" src="" style="max-width: 100%; display:block;" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="btnCropAndSave">Crop & Save</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var photoInput = document.getElementById('Input_PhotoUpload');
            var image = document.getElementById('imageToCrop');
            var cropperModalEl = document.getElementById('cropperModal');
            var cropperModal = new bootstrap.Modal(cropperModalEl);
            var cropper;
            var croppedBase64Input = document.getElementById('Input_CroppedPhotoBase64');

            if (photoInput && cropperModalEl) {
                photoInput.addEventListener('change', function (e) {
                    var files = e.target.files;
                    if (files && files.length > 0) {
                        var reader = new FileReader();
                        reader.onload = function (event) {
                            image.src = event.target.result;
                            cropperModal.show();
                        };
                        reader.readAsDataURL(files[0]);
                    }
                });

                cropperModalEl.addEventListener('shown.bs.modal', function () {
                    cropper = new Cropper(image, {
                        aspectRatio: 1,
                        viewMode: 1,
                        autoCropArea: 1,
                    });
                });

                var btnCropExisting = document.getElementById('btnCropExisting');
                if (btnCropExisting) {
                    btnCropExisting.addEventListener('click', function() {
                        image.src = this.getAttribute('data-url');
                        cropperModal.show();
                    });
                }

                cropperModalEl.addEventListener('hidden.bs.modal', function () {
                    if (cropper) {
                        cropper.destroy();
                        cropper = null;
                    }
                    if (!croppedBase64Input.value) {
                        photoInput.value = "";
                    }
                });

                var btnCrop = document.getElementById('btnCropAndSave');
                if(btnCrop) {
                    btnCrop.addEventListener('click', function () {
                        if (cropper) {
                            var canvas = cropper.getCroppedCanvas({ width: 500, height: 500 });
                            var base64 = canvas.toDataURL('image/jpeg', 0.9);
                            croppedBase64Input.value = base64;
                            cropperModal.hide();
                            
                            var previewDiv = document.getElementById('photoPreviewContainer');
                            if (!previewDiv) {
                                previewDiv = document.createElement('div');
                                previewDiv.id = 'photoPreviewContainer';
                                previewDiv.className = 'mt-3 d-flex align-items-center gap-3 p-3 border rounded bg-light';
                                previewDiv.innerHTML = '<img id="photoPreviewImg" src="" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid white; box-shadow: 0 0 10px rgba(0,0,0,0.1);" /><div class="fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> Cropped photo ready to upload</div>';
                                photoInput.parentNode.appendChild(previewDiv);
                            }
                            document.getElementById('photoPreviewImg').src = base64;
                        }
                    });
                }
            }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const statusSelect = document.querySelector('select[name="Input.Status"]');
            const lastWorkingDateInput = document.querySelector('input[name="Input.LastWorkingDate"]');

            function updateValidation() {
                if (statusSelect.value.toLowerCase() === 'inactive') {
                    lastWorkingDateInput.setAttribute('required', 'required');
                    lastWorkingDateInput.closest('.col-md-4').querySelector('label').innerHTML += ' <span class="text-danger">*</span>';
                } else {
                    lastWorkingDateInput.removeAttribute('required');
                    const label = lastWorkingDateInput.closest('.col-md-4').querySelector('label');
                    label.innerHTML = label.innerHTML.replace(' <span class="text-danger">*</span>', '');
                }
            }

            if (statusSelect && lastWorkingDateInput) {
                statusSelect.addEventListener('change', updateValidation);
                updateValidation();
            }
        });
    </script>
}
