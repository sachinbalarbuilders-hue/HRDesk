@page "{id:int}"
@model HRDesk.Web.Pages.Employees.DetailsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Employee Profile";
    var emp = Model.EmployeeData;
    var token = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}
<input type="hidden" id="afToken" value="@token" />

<style>
    .employee-sidebar {
        height: calc(100vh - 140px);
        overflow-y: auto;
    }
    
    .employee-item {
        transition: all 0.2s ease;
        border-left: 3px solid transparent;
        border-bottom: 1px solid var(--border-color) !important;
    }
    
    .employee-item:hover {
        background-color: rgba(var(--bs-primary-rgb), 0.05);
    }
    
    .employee-item.active {
        background-color: rgba(var(--bs-primary-rgb), 0.1);
        border-left-color: var(--bs-primary);
    }
    
    .profile-header-banner {
        height: 120px;
        background: linear-gradient(135deg, rgba(var(--bs-primary-rgb), 0.8) 0%, rgba(var(--bs-primary-rgb), 1) 100%);
        border-radius: 0.5rem 0.5rem 0 0;
    }
    
    .profile-avatar-container {
        margin-top: -60px;
        position: relative;
        z-index: 2;
    }
    
    .profile-avatar {
        width: 120px;
        height: 120px;
        border: 4px solid var(--bg-surface);
        border-radius: 50%;
        object-fit: cover;
        background-color: var(--bg-surface);
    }
    
    .profile-initials {
        width: 120px;
        height: 120px;
        border: 4px solid var(--bg-surface);
        border-radius: 50%;
        background-color: var(--bs-primary);
        color: white;
        font-size: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    [data-bs-theme="dark"] .nav-tabs .nav-link.active {
        background-color: var(--bg-surface);
        color: var(--text-main);
        border-color: var(--border-color) var(--border-color) var(--bg-surface);
    }
</style>

<div class="row g-4">
    <!-- Left Sidebar: Employee List -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-transparent border-bottom-0 pt-3 pb-0">
                <h6 class="mb-0 fw-bold">Employees Directory</h6>
                <div class="mt-2 mb-3">
                    <input type="text" class="form-control form-control-sm bg-light" id="searchEmployee" placeholder="Search..." />
                </div>
            </div>
            <div class="card-body p-0 employee-sidebar" id="employeeList">
                @foreach (var e in Model.AllEmployees)
                {
                    <a asp-page="./Details" asp-route-id="@e.EmployeeId" class="text-decoration-none text-body">
                        <div class="employee-item p-3 d-flex align-items-center @(e.EmployeeId == Model.Id ? "active" : "")">
                            <div class="avatar-circle me-3 flex-shrink-0" style="width: 40px; height: 40px; border-radius: 50%; overflow: hidden; background: rgba(var(--bs-primary-rgb), 0.1); color: var(--bs-primary); display: flex; align-items: center; justify-content: center;">
                                @if (!string.IsNullOrEmpty(e.PhotoPath))
                                {
                                    <img src="/api/Thumbnail?filename=@e.PhotoPath&width=100&height=100" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="fw-bold">@e.EmployeeName.Substring(0, 1).ToUpper()</span>
                                }
                            </div>
                            <div class="overflow-hidden">
                                <h6 class="mb-0 text-truncate fw-semibold" style="font-size: 0.9rem;">@e.EmployeeName</h6>
                                <small class="text-muted text-truncate d-block" style="font-size: 0.75rem;">@(e.DesignationName ?? "No Designation")</small>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Right Side: Employee Profile -->
    <div class="col-md-9">
        @if (emp == null)
        {
            <div class="alert alert-danger shadow-sm border-0">Employee not found.</div>
        }
        else
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="profile-header-banner"></div>
                <div class="card-body pt-0 pb-4 px-4">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div class="d-flex">
                            <div class="profile-avatar-container shadow-sm rounded-circle me-4">
                                @if (!string.IsNullOrEmpty(emp.PhotoPath))
                                {
                                    <img src="/api/Thumbnail?filename=@emp.PhotoPath&width=300&height=300" class="profile-avatar" alt="@emp.EmployeeName" />
                                }
                                else
                                {
                                    <div class="profile-initials">
                                        @emp.EmployeeName.Substring(0, 1).ToUpper()
                                    </div>
                                }
                            </div>
                            <div class="pt-3 mt-1">
                                <h3 class="mb-1 fw-bold">@emp.EmployeeName</h3>
                                <div class="d-flex align-items-center gap-3 text-muted">
                                    <span><i class="bi bi-briefcase me-1"></i> @(emp.Designation?.DesignationName ?? "—")</span>
                                    <span><i class="bi bi-building me-1"></i> @(emp.Department?.DepartmentName ?? "—")</span>
                                </div>
                            </div>
                        </div>
                        <div class="pt-3">
                            <a asp-page="./Edit" asp-route-id="@emp.EmployeeId" class="btn btn-outline-primary btn-sm shadow-sm rounded-pill px-3">
                                <i class="bi bi-pencil me-1"></i> Edit Profile
                            </a>
                        </div>
                    </div>

                    <!-- Tabs -->
                    <ul class="nav nav-tabs nav-tabs-custom border-bottom" id="profileTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-semibold pb-3" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab">
                                <i class="bi bi-person-lines-fill me-2"></i>Profile Overview
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold pb-3" id="leaves-tab" data-bs-toggle="tab" data-bs-target="#leaves" type="button" role="tab">
                                <i class="bi bi-calendar2-heart me-2"></i>Leave Management
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Tab Content -->
            <div class="tab-content" id="profileTabsContent">
                
                <!-- OVERVIEW TAB -->
                <div class="tab-pane fade show active" id="overview" role="tabpanel">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-transparent border-bottom-0 pb-0 pt-4 px-4">
                                    <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-info-circle me-2"></i>Work Information</h6>
                                </div>
                                <div class="card-body px-4">
                                    <table class="table table-borderless table-sm mb-0">
                                        <tbody>
                                            <tr>
                                                <td class="text-muted w-50">Employee ID</td>
                                                <td class="fw-semibold">@emp.EmployeeId</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Status</td>
                                                <td>
                                                    @if(string.Equals(emp.Status, "active", StringComparison.OrdinalIgnoreCase)) {
                                                        <span class="badge bg-soft-success text-success rounded-pill px-2">Active</span>
                                                    } else {
                                                        <span class="badge bg-soft-secondary text-secondary rounded-pill px-2">Inactive</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Contact Number</td>
                                                <td class="fw-semibold">@(emp.Phone ?? "—")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Date of Birth</td>
                                                <td class="fw-semibold">@(emp.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-transparent border-bottom-0 pb-0 pt-4 px-4">
                                    <h6 class="fw-bold mb-0 text-info"><i class="bi bi-calendar-event me-2"></i>Important Dates</h6>
                                </div>
                                <div class="card-body px-4">
                                    <table class="table table-borderless table-sm mb-0">
                                        <tbody>
                                            <tr>
                                                <td class="text-muted w-50">Joining Date</td>
                                                <td class="fw-semibold">@(emp.JoiningDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Probation Start</td>
                                                <td class="fw-semibold">@(emp.ProbationStart?.ToString("dd MMM yyyy") ?? "—")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Probation End</td>
                                                <td class="fw-semibold">@(emp.ProbationEnd?.ToString("dd MMM yyyy") ?? "—")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Last Working Date</td>
                                                <td class="fw-semibold">@(emp.LastWorkingDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="card shadow-sm border-0">
                                <div class="card-header bg-transparent border-bottom-0 pb-0 pt-4 px-4">
                                    <h6 class="fw-bold mb-0 text-secondary"><i class="bi bi-gear me-2"></i>System Configuration</h6>
                                </div>
                                <div class="card-body px-4">
                                    <table class="table table-borderless table-sm mb-0" style="max-width: 500px;">
                                        <tbody>
                                            <tr>
                                                <td class="text-muted w-50">Weekly Off</td>
                                                <td class="fw-semibold">@(emp.Weekoff ?? "—")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted">Device Sync Status</td>
                                                <td>
                                                    @if (emp.DeviceSynced == 1) {
                                                        <span class="badge text-bg-success"><i class="bi bi-check-circle me-1"></i> Synced</span>
                                                    } else {
                                                        <span class="badge text-bg-secondary"><i class="bi bi-x-circle me-1"></i> Not Synced</span>
                                                        @if(!string.IsNullOrEmpty(emp.DeviceSyncError)) {
                                                            <div class="small text-danger mt-1">@emp.DeviceSyncError</div>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- LEAVES TAB -->
                <div class="tab-pane fade" id="leaves" role="tabpanel">
                    
                    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                        @{
                            var todayDate = DateOnly.FromDateTime(System.DateTime.Today);
                            int uiLeaveYear = todayDate.Month >= 11 ? todayDate.Year : todayDate.Year - 1;
                        }
                        <h5 class="fw-bold mb-0">Leave Balances (@uiLeaveYear)</h5>
                        <button type="button" class="btn btn-primary shadow-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#applyLeaveModal">
                            <i class="bi bi-plus-lg me-2"></i>Apply Leave
                        </button>
                    </div>

                    @if (!Model.LeaveAllocations.Any())
                    {
                        <div class="alert alert-light border rounded shadow-sm">
                            <i class="bi bi-info-circle me-2"></i> No leave allocations found for the current year.
                        </div>
                    }
                    else
                    {
                        <div class="row g-3 mb-5">
                            @foreach (var allocation in Model.LeaveAllocations)
                            {
                                <div class="col-md-4 col-sm-6">
                                    <div class="card shadow-sm border-0 bg-soft-primary h-100">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div class="fw-bold text-body-emphasis">@(allocation.LeaveType?.Name ?? "Leave")</div>
                                                <div class="badge bg-white text-dark shadow-sm border">@(allocation.LeaveType?.Code)</div>
                                            </div>
                                            <h3 class="fw-bold mb-0 text-primary">@allocation.RemainingCount.ToString("0.#") <span class="fs-6 fw-normal text-muted">left</span></h3>
                                            <div class="small text-muted mt-2">
                                                Total: <strong>@((allocation.TotalAllocated + allocation.OpeningBalance).ToString("0.#"))</strong> | 
                                                Used: <strong>@allocation.UsedCount.ToString("0.#")</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <h5 class="fw-bold mb-3">Leave History</h5>
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">Dates</th>
                                            <th>Type</th>
                                            <th>Days</th>
                                            <th>Reason</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!Model.LeaveHistory.Any())
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-4">No leave applications found.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var leave in Model.LeaveHistory)
                                            {
                                                <tr>
                                                    <td class="ps-4">
                                                        <div class="fw-semibold">@leave.StartDate.ToString("dd MMM yyyy")</div>
                                                        @if (leave.StartDate != leave.EndDate)
                                                        {
                                                            <div class="small text-muted">to @leave.EndDate.ToString("dd MMM yyyy")</div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-light text-dark border shadow-sm">
                                                            @(leave.LeaveType?.Code ?? "—")
                                                        </span>
                                                        @if (leave.DayType != "Full Day")
                                                        {
                                                            <div class="small text-muted mt-1">@leave.DayType</div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="fw-semibold">@leave.TotalDays.ToString("0.#")</div>
                                                    </td>
                                                    <td>
                                                        <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@leave.Reason">
                                                            @(leave.Reason ?? "—")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (leave.Status == "Approved")
                                                        {
                                                            <span class="badge bg-soft-success text-success">Approved</span>
                                                        }
                                                        else if (leave.Status == "Rejected")
                                                        {
                                                            <span class="badge bg-soft-danger text-danger">Rejected</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-soft-warning text-warning">@leave.Status</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

<!-- Apply Leave Modal (inline, reuses existing Leave Applications handler via AJAX) -->
<div class="modal fade" id="applyLeaveModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-calendar-plus me-2 text-primary"></i>Apply Leave</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div id="leaveFormAlert" class="alert d-none mb-3" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Leave Type</label>
                        <select id="leaveTypeSelect" class="form-select" required>
                            <option value="">— Loading... —</option>
                        </select>
                        <div id="leaveBalanceInfo" class="mt-1 small text-muted" style="display:none;">
                            Balance: <span id="leaveBalanceVal" class="fw-bold text-success">0</span> days remaining
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Duration</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="leaveDuration" id="leaveSingleDay" value="single" checked>
                                <label class="form-check-label" for="leaveSingleDay">Single Day</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="leaveDuration" id="leaveMultipleDays" value="multiple">
                                <label class="form-check-label" for="leaveMultipleDays">Multiple Days</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <label class="form-label fw-semibold" id="startDateLabel">Date</label>
                        <input type="date" id="leaveStartDate" class="form-control" required />
                    </div>
                    <div class="col-6" id="endDateContainer" style="display:none;">
                        <label class="form-label fw-semibold">To Date</label>
                        <input type="date" id="leaveEndDate" class="form-control" />
                    </div>

                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Application Number</label>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="leaveAutoGenerate" checked>
                                <label class="form-check-label small" for="leaveAutoGenerate">Auto-generate</label>
                            </div>
                        </div>
                        <input type="text" id="leaveAppNumber" class="form-control" placeholder="e.g. JUL 1" />
                        <div class="form-text">Leave blank if tracking number is not required.</div>
                    </div>

                    <div class="col-6">
                        <label class="form-label fw-semibold">Day Type</label>
                        <select id="leaveDayType" class="form-select">
                            <option value="Full Day">Full Day</option>
                            <option value="First Half">First Half</option>
                            <option value="Second Half">Second Half</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Reason / Remarks</label>
                        <textarea id="leaveReason" class="form-control" rows="3" placeholder="Enter reason for leave..."></textarea>
                    </div>

                    <div id="sandwichWarning" class="col-12 d-none">
                        <div class="alert alert-warning py-2 mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <span id="sandwichWarningText"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="saveLeaveBtn" class="btn btn-primary px-4">
                    <span id="saveLeaveBtnText"><i class="bi bi-check-lg me-1"></i>Save Leave Record</span>
                    <span id="saveLeaveBtnSpinner" class="d-none spinner-border spinner-border-sm" role="status"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const EMPLOYEE_ID = @emp?.EmployeeId;
    const LEAVE_URL = '/Leaves/Applications';

    document.addEventListener("DOMContentLoaded", function() {
        // ── Sidebar search ──────────────────────────────────
        const searchInput = document.getElementById("searchEmployee");
        const employeeList = document.getElementById("employeeList");
        if (searchInput && employeeList) {
            const items = employeeList.querySelectorAll(".employee-item");
            searchInput.addEventListener("keyup", function() {
                const term = this.value.toLowerCase();
                items.forEach(item => {
                    const name = item.querySelector("h6").textContent.toLowerCase();
                    item.parentElement.style.display = name.includes(term) ? "" : "none";
                });
            });
        }

        // ── Apply Leave Modal ──────────────────────────────
        const modal = document.getElementById('applyLeaveModal');
        if (!modal) return;

        // Load eligible leave types when modal opens
        modal.addEventListener('show.bs.modal', async function () {
            resetLeaveForm();
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('leaveStartDate').value = today;
            document.getElementById('leaveEndDate').value = today;

            // Fetch eligible leave types for this employee
            const resp = await fetch(`${LEAVE_URL}?handler=GetEligibleLeaveTypes&employeeId=${EMPLOYEE_ID}&date=${today}`);
            const types = await resp.json();
            const sel = document.getElementById('leaveTypeSelect');
            sel.innerHTML = '<option value="">— Select Leave Type —</option>';
            types.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.id;
                opt.text = `${t.name} (${t.code})`;
                if (t.isDisabled) { opt.disabled = true; opt.text += ` — Not allowed (${t.disabledReason})`; }
                sel.appendChild(opt);
            });
        });

        // Show/hide end date on duration change
        document.querySelectorAll('input[name="leaveDuration"]').forEach(r => {
            r.addEventListener('change', function() {
                const isMultiple = this.value === 'multiple';
                document.getElementById('endDateContainer').style.display = isMultiple ? '' : 'none';
                document.getElementById('startDateLabel').textContent = isMultiple ? 'From Date' : 'Date';
                if (!isMultiple) document.getElementById('leaveEndDate').value = document.getElementById('leaveStartDate').value;
            });
        });

        // Sync end date when start date changes in single-day mode
        document.getElementById('leaveStartDate').addEventListener('change', function() {
            if (document.getElementById('leaveSingleDay').checked) {
                document.getElementById('leaveEndDate').value = this.value;
            }
            loadBalance();
        });

        // Load balance when leave type changes
        document.getElementById('leaveTypeSelect').addEventListener('change', loadBalance);

        async function loadBalance() {
            const typeId = document.getElementById('leaveTypeSelect').value;
            const date = document.getElementById('leaveStartDate').value;
            if (!typeId || !date) return;
            const resp = await fetch(`${LEAVE_URL}?handler=CheckBalance&employeeId=${EMPLOYEE_ID}&leaveTypeId=${typeId}&date=${date}`);
            const data = await resp.json();
            document.getElementById('leaveBalanceVal').textContent = data.remaining;
            document.getElementById('leaveBalanceVal').className = `fw-bold ${data.remaining > 0 ? 'text-success' : 'text-danger'}`;
            document.getElementById('leaveBalanceInfo').style.display = '';
        }

        // Auto-generate toggle: disable/enable the app number input
        document.getElementById('leaveAutoGenerate').addEventListener('change', function() {
            const input = document.getElementById('leaveAppNumber');
            input.disabled = this.checked;
            if (this.checked) input.value = '';
        });
        // Disable by default since auto-generate is checked
        document.getElementById('leaveAppNumber').disabled = true;

        // Save leave via AJAX using the existing Leave Applications handler
        document.getElementById('saveLeaveBtn').addEventListener('click', async function() {
            const leaveTypeId = document.getElementById('leaveTypeSelect').value;
            const startDate = document.getElementById('leaveStartDate').value;
            const endDate = document.getElementById('leaveEndDate').value || startDate;
            const dayType = document.getElementById('leaveDayType').value;
            const reason = document.getElementById('leaveReason').value;
            const autoGenerate = document.getElementById('leaveAutoGenerate').checked;
            const appNumber = document.getElementById('leaveAppNumber').value.trim();

            if (!leaveTypeId || !startDate) {
                showAlert('danger', 'Please select a leave type and date.');
                return;
            }

            setLoading(true);

            // Build form data matching the existing Razor Page handler's model binding
            const formData = new FormData();
            formData.append('NewApplication.EmployeeId', EMPLOYEE_ID);
            formData.append('NewApplication.LeaveTypeId', leaveTypeId);
            formData.append('NewApplication.StartDate', startDate);
            formData.append('NewApplication.EndDate', endDate);
            formData.append('NewApplication.DayType', dayType);
            formData.append('NewApplication.Reason', reason);
            formData.append('AutoGenerate', autoGenerate ? 'true' : 'false');
            if (!autoGenerate && appNumber) formData.append('NewApplication.ApplicationNumber', appNumber);

            // Get CSRF token from the hidden field injected by server
            const token = document.getElementById('afToken')?.value || '';

            try {
                const resp = await fetch(`${LEAVE_URL}?handler=Add`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: formData
                });

                if (resp.ok && resp.redirected) {
                    // Success — the server redirected (standard Razor Pages behavior after successful POST)
                    showAlert('success', '✅ Leave applied successfully! Refreshing...');
                    setTimeout(() => window.location.reload(), 1200);
                } else if (resp.ok) {
                    // Check if we got an error back in the page HTML (ModelState errors returned as Page())
                    const html = await resp.text();
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const errors = doc.querySelectorAll('.validation-summary-errors li, .alert-danger li');
                    if (errors.length > 0) {
                        const msgs = Array.from(errors).map(e => e.textContent).join(' ');
                        showAlert('danger', msgs);
                    } else {
                        // Assume success if no errors found in the response
                        showAlert('success', '✅ Leave applied successfully! Refreshing...');
                        setTimeout(() => window.location.reload(), 1200);
                    }
                } else {
                    showAlert('danger', 'Something went wrong. Please try again.');
                }
            } catch (e) {
                showAlert('danger', 'Network error. Please check your connection.');
            }

            setLoading(false);
        });

        function showAlert(type, msg) {
            const el = document.getElementById('leaveFormAlert');
            el.className = `alert alert-${type} mb-3`;
            el.textContent = msg;
        }

        function setLoading(on) {
            document.getElementById('saveLeaveBtnText').classList.toggle('d-none', on);
            document.getElementById('saveLeaveBtnSpinner').classList.toggle('d-none', !on);
            document.getElementById('saveLeaveBtn').disabled = on;
        }

        function resetLeaveForm() {
            document.getElementById('leaveTypeSelect').innerHTML = '<option value="">— Loading... —</option>';
            document.getElementById('leaveReason').value = '';
            document.getElementById('leaveSingleDay').checked = true;
            document.getElementById('endDateContainer').style.display = 'none';
            document.getElementById('leaveBalanceInfo').style.display = 'none';
            document.getElementById('leaveFormAlert').className = 'alert d-none mb-3';
            document.getElementById('sandwichWarning').classList.add('d-none');
        }
    });
</script>
