<!DOCTYPE html>
@inject HRDesk.Web.Data.BiometricAttendanceDbContext DbContext
@inject HRDesk.Web.Services.ICurrentTenantProvider TenantProvider
<html lang="en">
<head>
    <script>
        const storedTheme = localStorage.getItem('theme') || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (storedTheme) document.documentElement.setAttribute('data-bs-theme', storedTheme);
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HRDesk</title>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="dashboard-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-brand">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 36 36" style="flex-shrink:0;">
                        <defs>
                            <linearGradient id="lg1" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#4f46e5"/>
                                <stop offset="100%" stop-color="#06b6d4"/>
                            </linearGradient>
                        </defs>
                        <!-- Outer rounded bg -->
                        <rect width="36" height="36" rx="9" fill="url(#lg1)"/>
                        <!-- Center person -->
                        <circle cx="18" cy="12" r="4" fill="white" opacity="1"/>
                        <path d="M10 26 Q10 20 18 20 Q26 20 26 26" fill="white" opacity="1"/>
                        <!-- Left dot -->
                        <circle cx="9" cy="16" r="2.5" fill="white" opacity="0.7"/>
                        <!-- Right dot -->
                        <circle cx="27" cy="16" r="2.5" fill="white" opacity="0.7"/>
                        <!-- Connecting lines -->
                        <line x1="11" y1="16" x2="14" y2="16.5" stroke="white" stroke-width="1.2" opacity="0.5"/>
                        <line x1="25" y1="16" x2="22" y2="16.5" stroke="white" stroke-width="1.2" opacity="0.5"/>
                    </svg>
                    <span>HRDesk</span>
                </div>
            </div>

            <div class="sidebar-content">
                <!-- Dashboard -->
                <a asp-page="/Index" class="nav-link">
                    <i class="bi bi-house-door"></i> Dashboard
                </a>

                <!-- Attendance Section -->
                <div class="nav-section-title mt-3">Attendance</div>
                <a asp-page="/AttendanceLogs/Index" class="nav-link">
                    <i class="bi bi-list-ul"></i> Attendance Logs
                </a>
                <a asp-page="/Attendance/Process" class="nav-link">
                    <i class="bi bi-gear"></i> Process Attendance
                </a>
                <a asp-page="/Attendance/Roster" class="nav-link">
                    <i class="bi bi-calendar-range"></i> Shift Roster
                </a>
                <a asp-page="/Attendance/MonthlyAttendanceSheet" class="nav-link">
                    <i class="bi bi-table"></i> Monthly Sheet
                </a>
                <a asp-page="/Regularizations/Index" class="nav-link">
                    <i class="bi bi-pencil-square"></i> Regularization
                </a>

                <!-- Masters Section -->
                <div class="nav-section-title mt-3">Masters</div>
                <a asp-page="/Employees/Index" class="nav-link">
                    <i class="bi bi-people"></i> Employees
                </a>
                <a asp-page="/Departments/Index" class="nav-link">
                    <i class="bi bi-building"></i> Departments
                </a>
                <a asp-page="/Designations/Index" class="nav-link">
                    <i class="bi bi-award"></i> Designations
                </a>
                <a asp-page="/Shifts/Index" class="nav-link">
                    <i class="bi bi-clock"></i> Shifts
                </a>
                <a asp-page="/Holidays/Index" class="nav-link">
                    <i class="bi bi-calendar-event"></i> Holidays
                </a>
                <a asp-page="/Masters/DeviceSettings" class="nav-link">
                    <i class="bi bi-hdd-network"></i> Device Settings
                </a>

                <!-- HR & Payroll Section -->
                <div class="nav-section-title mt-3">HR & Payroll</div>
                <a asp-page="/Leaves/Applications/Index" class="nav-link">
                    <i class="bi bi-file-earmark-text"></i> Leave Applications
                </a>
                <a asp-page="/CompOff/Requests/Index" class="nav-link">
                    <i class="bi bi-calendar-plus"></i> Comp Off Requests
                </a>
                <a asp-page="/Leaves/Allocations/Index" class="nav-link">
                    <i class="bi bi-calendar-check"></i> Leave Allocations
                </a>
                <a asp-page="/Leaves/Types/Index" class="nav-link">
                    <i class="bi bi-tags"></i> Leave Types
                </a>
                <a asp-page="/Loans/Applications/Index" class="nav-link">
                    <i class="bi bi-wallet2"></i> Loan Applications
                </a>
                <a asp-page="/Payroll/EmployeeSalary/Index" class="nav-link">
                    <i class="bi bi-currency-rupee"></i> Employee Salaries
                </a>
                <a asp-page="/Payroll/Process" class="nav-link">
                    <i class="bi bi-calculator"></i> Process Payroll
                </a>

                <!-- System Section -->
                <div class="nav-section-title mt-3">System</div>
                <a asp-page="/ServiceLogs/Index" class="nav-link">
                    <i class="bi bi-terminal"></i> Service Logs
                </a>
                <a asp-page="/WhatsApp/Index" class="nav-link">
                    <i class="bi bi-whatsapp"></i> WhatsApp Status
                </a>

                <!-- Reports Section -->
                <div class="nav-section-title mt-3">Reports</div>
                <a asp-page="/Reports/LateIn" class="nav-link">
                    <i class="bi bi-clock-history"></i> Late In Report
                </a>
                <a asp-page="/Reports/EarlyGo" class="nav-link">
                    <i class="bi bi-door-open"></i> Early Go Report
                </a>
                <a asp-page="/Reports/MissingPunch" class="nav-link">
                    <i class="bi bi-exclamation-triangle"></i> Missing Punch
                </a>
                <a asp-page="/Reports/ApplicationTracking" class="nav-link">
                    <i class="bi bi-list-ol"></i> Application Tracking
                </a>
                <a asp-page="/Reports/EmployeeLeaveReport" class="nav-link">
                    <i class="bi bi-file-earmark-bar-graph"></i> Employee Leave Report
                </a>

                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="nav-section-title mt-3">Super Admin</div>
                    <a asp-page="/Organizations/Index" class="nav-link">
                        <i class="bi bi-diagram-3"></i> Organizations
                    </a>
                }
            </div>

            <div class="sidebar-footer">
                <small class="text-muted">&copy; 2026 HRDesk.Web</small>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-content">
            <!-- Topbar -->
            <header class="topbar">
                <div class="d-flex align-items-center">
                    <button class="topbar-toggler" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <h5 class="mb-0 ms-2 fw-semibold text-body-emphasis">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            var organizations = DbContext.Organizations.Where(o => o.IsActive).ToList();
                            var currentTenantId = TenantProvider.TenantId;
                            
                            <div class="dropdown me-3">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="tenantDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-building"></i> @(organizations.FirstOrDefault(o => o.Id == currentTenantId)?.Name ?? "Switch Org")
                                </button>
                                <ul class="dropdown-menu shadow" aria-labelledby="tenantDropdown">
                                    @foreach (var org in organizations)
                                    {
                                        <li>
                                            <form method="post" asp-page="/Account/SwitchTenant">
                                                <input type="hidden" name="tenantId" value="@org.Id" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="dropdown-item @(org.Id == currentTenantId ? "active" : "")">
                                                    @org.Name
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <button id="themeToggle" class="btn btn-sm btn-outline-secondary" type="button" title="Toggle Dark/Light Mode">
                            <i class="bi bi-circle-half"></i>
                        </button>

                        <span class="text-secondary">
                            <i class="bi bi-person-circle"></i>
                            @(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name)
                        </span>
                        <form method="post" asp-page="/Account/Logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/Account/Login" class="btn btn-primary btn-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    }
                </div>
            </header>

            <!-- Page Content -->
            <div class="content-wrapper">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="footer-content">
                &copy; 2026 - HRDesk.Web
            </footer>
        </div>
    </div>

    <!-- Global Loading Overlay -->
    <div id="loadingOverlay" class="loading-overlay">
        <div class="spinner-container">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div id="loadingText" class="loading-text">Processing... Please wait</div>
            <div class="text-muted small mt-2">This may take a few seconds.</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Sidebar toggle for mobile
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('show');
        });
        // Highlight active sidebar link
        document.querySelectorAll('.sidebar-content .nav-link').forEach(link => {
            if (link.getAttribute('href') === window.location.pathname) {
                link.classList.add('active');
                // Auto-scroll the sidebar to ensure the active item is visible
                link.scrollIntoView({ behavior: 'instant', block: 'center' });
            }
        });

        // Global loading function
        function showLoading(text) {
            if (text) {
                document.getElementById('loadingText').innerText = text;
            }
            document.getElementById('loadingOverlay').style.display = 'flex';
            return true;
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
