<!DOCTYPE html>
@inject HRDesk.Web.Data.BiometricAttendanceDbContext DbContext
@inject HRDesk.Web.Services.ICurrentTenantProvider TenantProvider
@inject HRDesk.Web.Services.Infrastructure.IPermissionService NavPermSvc
<html lang="en">
<head>
    <script>
        const storedTheme = localStorage.getItem('theme') || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (storedTheme) document.documentElement.setAttribute('data-bs-theme', storedTheme);
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HRDesk</title>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="dashboard-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-brand">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 36 36" style="flex-shrink:0;">
                        <defs>
                            <linearGradient id="lg1" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#4f46e5"/>
                                <stop offset="100%" stop-color="#06b6d4"/>
                            </linearGradient>
                        </defs>
                        <!-- Outer rounded bg -->
                        <rect width="36" height="36" rx="9" fill="url(#lg1)"/>
                        <!-- Center person -->
                        <circle cx="18" cy="12" r="4" fill="white" opacity="1"/>
                        <path d="M10 26 Q10 20 18 20 Q26 20 26 26" fill="white" opacity="1"/>
                        <!-- Left dot -->
                        <circle cx="9" cy="16" r="2.5" fill="white" opacity="0.7"/>
                        <!-- Right dot -->
                        <circle cx="27" cy="16" r="2.5" fill="white" opacity="0.7"/>
                        <!-- Connecting lines -->
                        <line x1="11" y1="16" x2="14" y2="16.5" stroke="white" stroke-width="1.2" opacity="0.5"/>
                        <line x1="25" y1="16" x2="22" y2="16.5" stroke="white" stroke-width="1.2" opacity="0.5"/>
                    </svg>
                    <span>HRDesk</span>
                </div>
            </div>

            <div class="sidebar-content">
                @{
                    bool _canViewEmployees   = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.EmployeesView);
                    bool _canAttendView      = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.AttendanceView);
                    bool _canAttendProcess   = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.AttendanceProcess);
                    bool _canAttendRoster    = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.AttendanceRoster);
                    bool _canMonthlySheet    = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.AttendanceMonthlySheet);
                    bool _canRegularize      = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.AttendanceRegularize);
                    bool _canLeavesView      = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.LeavesView);
                    bool _canLeavesApprove   = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.LeavesApprove);
                    bool _canCompOff         = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.CompOffApprove);
                    bool _canLeaveTypes      = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.LeavesManageTypes);
                    bool _canLeaveAlloc      = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.LeavesManageAllocations);
                    bool _canPayrollView     = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.PayrollView);
                    bool _canPayrollProcess  = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.PayrollProcess);
                    bool _canSalary          = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.PayrollManageSalary);
                    bool _canLoans           = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.PayrollManageLoans);
                    bool _canDepts           = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.MastersDepartments);
                    bool _canDesigs          = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.MastersDesignations);
                    bool _canShifts          = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.ShiftsManage);
                    bool _canHolidays        = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.HolidaysManage);
                    bool _canDevices         = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.SystemDevices);
                    bool _canRoles           = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.SystemRoles);
                    bool _canLogs            = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.SystemLogs);
                    bool _canRecruit         = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.RecruitmentCandidates);
                    bool _canInterviews      = await NavPermSvc.HasPermissionAsync(User, HRDesk.Web.Constants.AppPermissions.Keys.RecruitmentInterviews);

                    bool _isEmployeeOnly = User.IsInRole("Employee");
                }


                @if (_isEmployeeOnly)
                {
                    <!-- ESS-only sidebar -->
                    <div class="nav-section-title">My Self-Service</div>
                    <a asp-page="/Portal/Dashboard" class="nav-link"><i class="bi bi-speedometer2"></i> My Dashboard</a>
                    <a asp-page="/Portal/MyAttendance" class="nav-link"><i class="bi bi-clock-history"></i> My Attendance</a>
                    <a asp-page="/Portal/MyLeaves" class="nav-link"><i class="bi bi-calendar-plus"></i> My Leaves &amp; Quotas</a>
                    <a asp-page="/Portal/MyPayslips" class="nav-link"><i class="bi bi-wallet2"></i> My Payslips</a>
                }
                else
                {
                    <!-- Dashboard always visible for non-employees -->
                    <a asp-page="/Index" class="nav-link"><i class="bi bi-house-door"></i> Dashboard</a>

                    <!-- Attendance Section -->
                    @if (_canAttendView || _canAttendProcess || _canAttendRoster || _canMonthlySheet || _canRegularize)
                    {
                        <div class="nav-section-title mt-3">Attendance</div>
                        @if (_canAttendView)    { <a asp-page="/AttendanceLogs/Index" class="nav-link"><i class="bi bi-list-ul"></i> Attendance Logs</a> }
                        @if (_canAttendProcess) { <a asp-page="/Attendance/Process" class="nav-link"><i class="bi bi-gear"></i> Process Attendance</a> }
                        @if (_canAttendRoster)  { <a asp-page="/Attendance/Roster" class="nav-link"><i class="bi bi-calendar-range"></i> Shift Roster</a> }
                        @if (_canMonthlySheet)  { <a asp-page="/Attendance/MonthlyAttendanceSheet" class="nav-link"><i class="bi bi-table"></i> Monthly Sheet</a> }
                        @if (_canRegularize)    { <a asp-page="/Regularizations/Index" class="nav-link"><i class="bi bi-pencil-square"></i> Regularization</a> }
                    }

                    <!-- Masters Section -->
                    @if (_canViewEmployees || _canDepts || _canDesigs || _canShifts || _canHolidays || _canDevices)
                    {
                        <div class="nav-section-title mt-3">Masters</div>
                        @if (_canViewEmployees) { <a asp-page="/Employees/Index" class="nav-link"><i class="bi bi-people"></i> Employees</a> }
                        @if (_canDepts)         { <a asp-page="/Departments/Index" class="nav-link"><i class="bi bi-building"></i> Departments</a> }
                        @if (_canDesigs)        { <a asp-page="/Designations/Index" class="nav-link"><i class="bi bi-award"></i> Designations</a> }
                        @if (_canShifts)        { <a asp-page="/Shifts/Index" class="nav-link"><i class="bi bi-clock"></i> Shifts</a> }
                        @if (_canHolidays)      { <a asp-page="/Holidays/Index" class="nav-link"><i class="bi bi-calendar-event"></i> Holidays</a> }
                        @if (_canDevices)       { <a asp-page="/Masters/DeviceSettings" class="nav-link"><i class="bi bi-hdd-network"></i> Device Settings</a> }
                    }

                    <!-- HR & Payroll Section -->
                    @if (_canLeavesView || _canLeavesApprove || _canCompOff || _canLeaveTypes || _canLeaveAlloc || _canPayrollView || _canPayrollProcess || _canSalary || _canLoans)
                    {
                        <div class="nav-section-title mt-3">HR &amp; Payroll</div>
                        @if (_canLeavesView || _canLeavesApprove) { <a asp-page="/Leaves/Applications/Index" class="nav-link"><i class="bi bi-file-earmark-text"></i> Leave Applications</a> }
                        @if (_canCompOff)       { <a asp-page="/CompOff/Requests/Index" class="nav-link"><i class="bi bi-calendar-plus"></i> Comp Off Requests</a> }
                        @if (_canLeaveAlloc)    { <a asp-page="/Leaves/Allocations/Index" class="nav-link"><i class="bi bi-calendar-check"></i> Leave Allocations</a> }
                        @if (_canLeaveTypes)    { <a asp-page="/Leaves/Types/Index" class="nav-link"><i class="bi bi-tags"></i> Leave Types</a> }
                        @if (_canLoans)         { <a asp-page="/Loans/Applications/Index" class="nav-link"><i class="bi bi-wallet2"></i> Loan Applications</a> }
                        @if (_canSalary)        { <a asp-page="/Payroll/EmployeeSalary/Index" class="nav-link"><i class="bi bi-currency-rupee"></i> Employee Salaries</a> }
                        @if (_canPayrollProcess){ <a asp-page="/Payroll/Process" class="nav-link"><i class="bi bi-calculator"></i> Process Payroll</a> }
                    }

                    <!-- Recruitment Section -->
                    @if (_canRecruit || _canInterviews)
                    {
                        <div class="nav-section-title mt-3">Recruitment</div>
                        @if (_canRecruit)    { <a asp-area="Recruitment" asp-page="/Candidates/Index" class="nav-link"><i class="bi bi-person-lines-fill"></i> Candidates</a> }
                        @if (_canInterviews) { <a asp-area="Recruitment" asp-page="/Interviews/Calendar" class="nav-link"><i class="bi bi-calendar3"></i> Interview Calendar</a> }
                    }

                    <!-- System Section -->
                    @if (_canRoles || _canLogs)
                    {
                        <div class="nav-section-title mt-3">System &amp; Access</div>
                        @if (_canRoles)      { <a asp-page="/Roles/Index" class="nav-link"><i class="bi bi-shield-lock"></i> Roles &amp; Permissions</a> }
                        @if (_canRoles)      { <a asp-page="/Users/Index" class="nav-link"><i class="bi bi-person-gear"></i> User Accounts</a> }
                        @if (_canLogs)       { <a asp-page="/ServiceLogs/Index" class="nav-link"><i class="bi bi-terminal"></i> Service Logs</a> }
                        @if (_canLogs)       { <a asp-page="/WhatsApp/Index" class="nav-link"><i class="bi bi-whatsapp"></i> WhatsApp Status</a> }
                    }

                    <!-- Reports Section -->
                    @if (_canAttendView || _canLeavesView)
                    {
                        <div class="nav-section-title mt-3">Reports</div>
                        @if (_canAttendView) { <a asp-page="/Reports/LateIn" class="nav-link"><i class="bi bi-clock-history"></i> Late In Report</a> }
                        @if (_canAttendView) { <a asp-page="/Reports/EarlyGo" class="nav-link"><i class="bi bi-door-open"></i> Early Go Report</a> }
                        @if (_canAttendView) { <a asp-page="/Reports/MissingPunch" class="nav-link"><i class="bi bi-exclamation-triangle"></i> Missing Punch</a> }
                        @if (_canLeavesView) { <a asp-page="/Reports/ApplicationTracking" class="nav-link"><i class="bi bi-list-ol"></i> Application Tracking</a> }
                        @if (_canLeavesView) { <a asp-page="/Reports/EmployeeLeaveReport" class="nav-link"><i class="bi bi-file-earmark-bar-graph"></i> Employee Leave Report</a> }
                    }

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="nav-section-title mt-3">Super Admin</div>
                        <a asp-page="/Organizations/Index" class="nav-link"><i class="bi bi-diagram-3"></i> Organizations</a>
                    }
                }
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-content">
            <!-- Topbar -->
            <header class="topbar">
                <div class="d-flex align-items-center">
                    <button class="topbar-toggler" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <h5 class="mb-0 ms-2 fw-semibold text-body-emphasis">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            var organizations = DbContext.Organizations.Where(o => o.IsActive).ToList();
                            var currentTenantId = TenantProvider.TenantId;
                            
                            <div class="dropdown me-3">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="tenantDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-building"></i> @(organizations.FirstOrDefault(o => o.Id == currentTenantId)?.Name ?? "Switch Org")
                                </button>
                                <ul class="dropdown-menu shadow" aria-labelledby="tenantDropdown">
                                    @foreach (var org in organizations)
                                    {
                                        <li>
                                            <form method="post" asp-page="/Account/SwitchTenant">
                                                <input type="hidden" name="tenantId" value="@org.Id" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="dropdown-item @(org.Id == currentTenantId ? "active" : "")">
                                                    @org.Name
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <button id="themeToggle" class="btn btn-sm btn-outline-secondary" type="button" title="Toggle Dark/Light Mode">
                            <i class="bi bi-circle-half"></i>
                        </button>

                        <span class="text-secondary">
                            <i class="bi bi-person-circle"></i>
                            @(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name)
                        </span>
                        <form method="post" asp-page="/Account/Logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/Account/Login" class="btn btn-primary btn-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    }
                </div>
            </header>

            <!-- Page Content -->
            <div class="content-wrapper">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="footer-content">
                &copy; 2026 - HRDesk.Web
            </footer>
        </div>
    </div>

    <!-- Global Loading Overlay -->
    <div id="loadingOverlay" class="loading-overlay">
        <div class="spinner-container">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div id="loadingText" class="loading-text">Processing... Please wait</div>
            <div class="text-muted small mt-2">This may take a few seconds.</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Sidebar toggle for mobile
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('show');
        });
        // Highlight active sidebar link
        document.querySelectorAll('.sidebar-content .nav-link').forEach(link => {
            if (link.getAttribute('href') === window.location.pathname) {
                link.classList.add('active');
                // Auto-scroll the sidebar to ensure the active item is visible
                link.scrollIntoView({ behavior: 'instant', block: 'center' });
            }
        });

        // Global loading function
        function showLoading(text) {
            if (text) {
                document.getElementById('loadingText').innerText = text;
            }
            document.getElementById('loadingOverlay').style.display = 'flex';
            return true;
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
