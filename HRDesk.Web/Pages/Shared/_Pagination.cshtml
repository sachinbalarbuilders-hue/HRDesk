@using HRDesk.Web.Models
@model PaginationViewModel
@{
    var paginatedList = Model.List;
    var queryParams = Model.QueryParams ?? new Dictionary<string, string?>();
    var pageName = Model.PageName ?? "./Index";
}

@if (paginatedList.TotalPages > 1 || paginatedList.TotalCount > 0)
{
    <div class="card-footer d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <div class="small text-muted">
            Showing @paginatedList.Count of @paginatedList.TotalCount records
        </div>
        @if (paginatedList.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!paginatedList.HasPreviousPage ? "disabled" : "")">
                        @{ queryParams["pageNum"] = (paginatedList.PageIndex - 1).ToString(); }
                        <a class="page-link" href="@Url.Page(pageName, queryParams)">« Prev</a>
                    </li>
                    @{
                        int start = Math.Max(1, paginatedList.PageIndex - 2);
                        int end = Math.Min(paginatedList.TotalPages, paginatedList.PageIndex + 2);
                        for (int i = start; i <= end; i++)
                        {
                            queryParams["pageNum"] = i.ToString();
                            <li class="page-item @(i == paginatedList.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Page(pageName, queryParams)">@i</a>
                            </li>
                        }
                    }
                    <li class="page-item @(!paginatedList.HasNextPage ? "disabled" : "")">
                        @{ queryParams["pageNum"] = (paginatedList.PageIndex + 1).ToString(); }
                        <a class="page-link" href="@Url.Page(pageName, queryParams)">Next »</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
