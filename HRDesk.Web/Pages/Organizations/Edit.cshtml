@page
@model HRDesk.Web.Pages.Organizations.EditModel
@{
    ViewData["Title"] = "Edit Organization";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
    <style>
        #orgMap {
            height: 350px;
            width: 100%;
            border-radius: 0.375rem;
            border: 1px solid #ced4da;
        }
    </style>
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Edit Organization</h1>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Organization.Id" />
            
            <div class="form-group mb-3">
                <label asp-for="Organization.Name" class="control-label"></label>
                <input asp-for="Organization.Name" class="form-control" />
                <span asp-validation-for="Organization.Name" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Organization.WhatsAppGroupId" class="form-label fw-bold">WhatsApp Group</label>
                @if (Model.AvailableGroups.Any())
                {
                    <select asp-for="Organization.WhatsAppGroupId" class="form-select">
                        <option value="">-- No Group Selected --</option>
                        @foreach (var group in Model.AvailableGroups)
                        {
                            <option value="@group.Value">@group.Text</option>
                        }
                    </select>
                }
                else
                {
                    <div class="input-group">
                        <input asp-for="Organization.WhatsAppGroupId" class="form-control" placeholder="e.g. 120363xxxxxx@g.us" />
                    </div>
                    <small class="form-text text-muted">WhatsApp microservice returned no groups. Ensure WhatsApp is connected and you are a group participant.</small>
                }
                <span asp-validation-for="Organization.WhatsAppGroupId" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Organization.Address" class="control-label fw-bold"></label>
                <textarea asp-for="Organization.Address" class="form-control" rows="2" placeholder="Full physical address"></textarea>
                <span asp-validation-for="Organization.Address" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label class="control-label fw-bold">Organization Location (Pin on Map)</label>
                <p class="small text-muted mb-2">Drag the pin or click on the map to set the precise location. This will be sent to candidates for in-person interviews.</p>
                <div id="orgMap"></div>
                <input type="hidden" asp-for="Organization.Latitude" id="hiddenLat" />
                <input type="hidden" asp-for="Organization.Longitude" id="hiddenLng" />
            </div>
            
            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Organization.IsActive" /> @Html.DisplayNameFor(model => model.Organization.IsActive)
                </label>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Default to center of India if no coordinates exist
            let lat = parseFloat(document.getElementById('hiddenLat').value) || 20.5937;
            let lng = parseFloat(document.getElementById('hiddenLng').value) || 78.9629;
            let hasLocation = !!document.getElementById('hiddenLat').value;
            let zoomLevel = hasLocation ? 15 : 5;

            let streetMap = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            });

            let satelliteMap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri'
            });

            let map = L.map('orgMap', {
                center: [lat, lng],
                zoom: zoomLevel,
                layers: [streetMap]
            });

            let baseMaps = {
                "Street View": streetMap,
                "Satellite View": satelliteMap
            };

            L.control.layers(baseMaps).addTo(map);

            let marker = L.marker([lat, lng], { draggable: true }).addTo(map);

            // Add Search Box (Geocoder)
            L.Control.geocoder({
                defaultMarkGeocode: false,
                geocoder: L.Control.Geocoder.nominatim({
                    geocodingQueryParams: {
                        countrycodes: 'in' // Restrict search to India
                    }
                })
            }).on('markgeocode', function(e) {
                let newPos = e.geocode.center;
                map.setView(newPos, 16);
                marker.setLatLng(newPos);
                document.getElementById('hiddenLat').value = newPos.lat;
                document.getElementById('hiddenLng').value = newPos.lng;
            }).addTo(map);

            // Update hidden inputs when marker is dragged
            marker.on('dragend', function (e) {
                let position = marker.getLatLng();
                document.getElementById('hiddenLat').value = position.lat;
                document.getElementById('hiddenLng').value = position.lng;
            });

            // Move marker and update inputs when map is clicked
            map.on('click', function (e) {
                let newPos = e.latlng;
                marker.setLatLng(newPos);
                document.getElementById('hiddenLat').value = newPos.lat;
                document.getElementById('hiddenLng').value = newPos.lng;
            });
            
            // Fix map rendering issue in some Bootstrap tabs/cards
            setTimeout(function(){ map.invalidateSize()}, 500);
        });
    </script>
}
