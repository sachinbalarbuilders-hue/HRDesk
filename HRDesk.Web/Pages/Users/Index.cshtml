@page
@model HRDesk.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "User Accounts Management";
}

<div class="container-fluid px-0 pb-5">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 mt-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h4 class="mb-0 fw-bold">User Accounts & Access</h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">
                    Security & Identity
                </span>
            </div>
            <p class="text-muted mb-0 small">Create system users, assign custom roles, and link employee profiles for Self-Service access.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="bi bi-person-plus"></i>
                <span>Create User Account</span>
            </button>
            <a asp-page="/Roles/Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <i class="bi bi-shield-lock"></i>
                <span>Roles & Permissions</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Users Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">User</th>
                            <th>Role</th>
                            <th>Linked Employee</th>
                            <th>Status</th>
                            <th>Created On</th>
                            <th>Last Login</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.UsersList)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-sm rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                            @(user.Username.Length > 0 ? user.Username.Substring(0, 1).ToUpper() : "U")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-body-emphasis">@user.Username</div>
                                            <div class="text-muted small">@(user.FullName ?? user.Username)</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-shield me-1"></i>@user.RoleName
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.LinkedEmployeeName))
                                    {
                                        <div class="d-flex align-items-center gap-1">
                                            <i class="bi bi-person-check text-success"></i>
                                            <span class="fw-semibold">@user.LinkedEmployeeName</span>
                                            <span class="text-muted small">(#@user.LinkedEmployeeId)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>Not linked</em></span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Disabled</span>
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted">@user.CreatedAt.ToString("dd MMM yyyy")</span>
                                </td>
                                <td>
                                    <span class="small text-muted">
                                        @(user.LastLogin.HasValue ? user.LastLogin.Value.ToString("dd MMM yyyy, hh:mm tt") : "Never")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex align-items-center justify-content-end gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-edit-user"
                                            data-user-id="@user.Id"
                                            data-username="@user.Username"
                                            data-fullname="@(user.FullName ?? user.Username)"
                                            data-employee-id="@(user.LinkedEmployeeId?.ToString() ?? "")"
                                            data-role-id="@(user.RoleId?.ToString() ?? "")"
                                            title="Edit User">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openResetPasswordModal(@user.Id, '@user.Username')" title="Reset Password">
                                            <i class="bi bi-key"></i>
                                        </button>
                                        @if (user.Username != "admin")
                                        {
                                            <form method="post" asp-page-handler="ToggleActive" asp-route-id="@user.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(user.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="bi @(user.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header py-3">
                    <h5 class="modal-title fw-bold" id="createUserModalLabel">
                        <i class="bi bi-person-plus text-primary me-2"></i>Create New User Account
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label asp-for="CreateInput.Username" class="form-label fw-bold small text-muted">Username <span class="text-danger">*</span></label>
                        <input asp-for="CreateInput.Username" class="form-control shadow-sm" placeholder="e.g., john.doe, emp101" required />
                        <span asp-validation-for="CreateInput.Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreateInput.FullName" class="form-label fw-bold small text-muted">Full Name</label>
                        <input asp-for="CreateInput.FullName" class="form-control shadow-sm" placeholder="e.g., John Doe" />
                        <span asp-validation-for="CreateInput.FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreateInput.Password" class="form-label fw-bold small text-muted">Initial Password <span class="text-danger">*</span></label>
                        <input asp-for="CreateInput.Password" type="password" class="form-control shadow-sm" placeholder="Minimum 4 characters" required />
                        <span asp-validation-for="CreateInput.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreateInput.RoleId" class="form-label fw-bold small text-muted">Assigned Role <span class="text-danger">*</span></label>
                        <select asp-for="CreateInput.RoleId" class="form-select shadow-sm" required>
                            <option value="">-- Select Role --</option>
                            @foreach (var role in Model.RolesList)
                            {
                                <option value="@role.Id">@role.Name @(role.IsSystemRole ? "(System)" : "(Custom)")</option>
                            }
                        </select>
                        <span asp-validation-for="CreateInput.RoleId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CreateInput.EmployeeId" class="form-label fw-bold small text-muted">Link to Employee Profile</label>
                        <select asp-for="CreateInput.EmployeeId" class="form-select shadow-sm">
                            <option value="">-- No Employee Link (Admin Only) --</option>
                            @foreach (var emp in Model.EmployeesList)
                            {
                                <option value="@emp.EmployeeId">@emp.EmployeeName (#@emp.EmployeeId)</option>
                            }
                        </select>
                        <div class="form-text small text-muted">Required for employees to view their own attendance and submit leaves.</div>
                    </div>
                </div>
                <div class="modal-footer py-3 bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i>Create Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Edit">
                <input type="hidden" id="editUserId" name="EditInput.Id" />
                <div class="modal-header py-3">
                    <h5 class="modal-title fw-bold" id="editUserModalLabel">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Edit User Account
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Username <span class="text-danger">*</span></label>
                        <input id="editUsername" name="EditInput.Username" class="form-control shadow-sm" required maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Full Name</label>
                        <input id="editFullName" name="EditInput.FullName" class="form-control shadow-sm" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Assigned Role <span class="text-danger">*</span></label>
                        <select id="editRoleId" name="EditInput.RoleId" class="form-select shadow-sm" required>
                            <option value="">-- Select Role --</option>
                            @foreach (var role in Model.RolesList)
                            {
                                <option value="@role.Id">@role.Name @(role.IsSystemRole ? "(System)" : "(Custom)")</option>
                            }
                        </select>
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-bold small text-muted">Linked Employee Profile</label>
                        <select id="editEmployeeId" name="EditInput.EmployeeId" class="form-select shadow-sm">
                            <option value="">-- No Employee Link (Admin Only) --</option>
                            @foreach (var emp in Model.EmployeesList)
                            {
                                <option value="@emp.EmployeeId">@emp.EmployeeName (#@emp.EmployeeId)</option>
                            }
                        </select>
                        <div class="form-text small text-muted">Required for employees to view their own attendance and submit leaves.</div>
                    </div>
                </div>
                <div class="modal-footer py-3 bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="ResetPassword">
                <input type="hidden" id="resetUserId" name="id" />
                <div class="modal-header py-3">
                    <h6 class="modal-title fw-bold">Reset Password</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="small text-muted mb-2">Enter new password for <strong id="resetUsername"></strong>:</p>
                    <input type="password" name="newPassword" class="form-control shadow-sm" placeholder="New Password" required />
                </div>
                <div class="modal-footer py-2 bg-body-tertiary">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openResetPasswordModal(id, username) {
            document.getElementById('resetUserId').value = id;
            document.getElementById('resetUsername').innerText = username;
            new bootstrap.Modal(document.getElementById('resetPasswordModal')).show();
        }

        // Use data-* attributes — avoids all quoting/escaping/type-coercion issues
        document.querySelectorAll('.btn-edit-user').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var d = btn.dataset;
                document.getElementById('editUserId').value = d.userId || '';
                document.getElementById('editUsername').value = d.username || '';
                document.getElementById('editFullName').value = d.fullname || '';

                var roleSelect = document.getElementById('editRoleId');
                roleSelect.value = d.roleId || '';

                var empSelect = document.getElementById('editEmployeeId');
                empSelect.value = d.employeeId || '';

                new bootstrap.Modal(document.getElementById('editUserModal')).show();
            });
        });
    </script>
}
