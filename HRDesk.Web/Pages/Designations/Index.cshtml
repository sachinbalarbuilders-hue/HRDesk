@page
@model HRDesk.Web.Pages.Designations.IndexModel
@{
    ViewData["Title"] = "Designations";
    var isArchivedTab = string.Equals(Model.Tab, "archived", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 class="mb-1 fw-bold">Designations</h4>
        <p class="text-muted mb-0 small">Manage organizational designations and archive records</p>
    </div>
    <a class="btn btn-primary" asp-page="./Create">
        <i class="bi bi-plus-lg me-1"></i>Add Designation
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Pill Tabs: Active vs Archived -->
<div class="mb-3">
    <ul class="nav nav-pills p-1 bg-white rounded-pill shadow-sm border d-inline-flex" id="desigTabs">
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 py-2 fw-semibold @(!isArchivedTab ? "active" : "")" 
               asp-page="./Index" asp-route-tab="active">
                <i class="bi bi-check2-circle me-2"></i>Active (@Model.ActiveDesignations.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 py-2 fw-semibold @(isArchivedTab ? "active text-bg-warning" : "text-muted")" 
               asp-page="./Index" asp-route-tab="archived">
                <i class="bi bi-archive me-2"></i>Archived (@Model.ArchivedDesignations.Count)
            </a>
        </li>
    </ul>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <h6 class="mb-0 fw-bold">
            <i class="bi @(!isArchivedTab ? "bi-award text-primary" : "bi-archive text-warning") me-2"></i>
            @(!isArchivedTab ? "Active Designations" : "Archived Designations")
        </h6>
        <span class="badge text-bg-secondary">@((!isArchivedTab ? Model.ActiveDesignations.Count : Model.ArchivedDesignations.Count)) total</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Designation Name</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (!isArchivedTab)
                {
                    if (Model.ActiveDesignations.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center py-5 text-muted">
                            <i class="bi bi-award fs-1 d-block mb-2 opacity-25"></i>No active designations found.
                        </td></tr>
                    }
                    else
                    {
                        foreach (var d in Model.ActiveDesignations)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">
                                    <i class="bi bi-award me-2 text-primary opacity-50"></i>@d.DesignationName
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        ACTIVE
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-page="./Edit" asp-route-id="@d.Id">
                                                    <i class="bi bi-pencil me-2 text-primary"></i>Edit
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form method="post" asp-page-handler="Archive" asp-route-id="@d.Id"
                                                      onsubmit="return confirm('Move designation \'@d.DesignationName\' to Archive? It can be restored later.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-archive me-2"></i>Archive (Soft Delete)
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
                else
                {
                    if (Model.ArchivedDesignations.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center py-5 text-muted">
                            <i class="bi bi-archive fs-1 d-block mb-2 opacity-25"></i>No archived designations.
                        </td></tr>
                    }
                    else
                    {
                        foreach (var d in Model.ArchivedDesignations)
                        {
                            <tr class="table-light">
                                <td class="ps-4 fw-semibold text-muted text-decoration-line-through">
                                    <i class="bi bi-award me-2 text-secondary opacity-50"></i>@d.DesignationName
                                </td>
                                <td>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        ARCHIVED
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <form method="post" asp-page-handler="Restore" asp-route-id="@d.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-success">
                                                        <i class="bi bi-arrow-counterclockwise me-2"></i>Restore
                                                    </button>
                                                </form>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form method="post" asp-page-handler="PermanentDelete" asp-route-id="@d.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-trash3-fill me-2"></i>Permanently Delete
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

