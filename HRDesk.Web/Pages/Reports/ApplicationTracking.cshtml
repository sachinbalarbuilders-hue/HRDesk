@page "{pageNum:int?}"
@using HRDesk.Web.Models
@model HRDesk.Web.Pages.Reports.ApplicationTrackingModel
@{
    ViewData["Title"] = "Application Tracking Report";
}

<div class="container-fluid pb-5">
    <div class="card border-0 shadow-sm mb-4 mt-4">
        <div class="card-body px-4 py-3 border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-1 fw-bold text-primary"><i class="bi bi-list-ol me-2"></i>Application Tracking Report</h4>
                <p class="text-muted mb-0 small">Master list of all application tracking numbers in the series</p>
            </div>
                <div class="col-auto">
                    <div class="d-flex gap-2">
                        <form method="get" class="row g-2 align-items-center">
                            <div class="col-auto">
                                <select asp-for="Month" class="form-select form-select-sm">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i">@System.Globalization.DateTimeFormatInfo.InvariantInfo.GetMonthName(i)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <select asp-for="Year" class="form-select form-select-sm">
                                    @for (int i = DateTime.Now.Year - 1; i <= DateTime.Now.Year + 1; i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                            </div>
                        </form>
                    </div>
                </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive border-top">
                <table class="table table-modern align-middle mb-0">
                    <thead class="bg-light text-uppercase small text-muted">
                        <tr>
                            <th class="ps-3" style="width: 150px;">App No</th>
                            <th>Date</th>
                            <th>Employee</th>
                            <th>Category</th>
                            <th>Details</th>
                            <th>Reason</th>
                            <th class="text-end pe-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Applications.Any())
                        {
                            foreach (var app in Model.Applications)
                            {
                                <tr>
                                    <td class="ps-3">
                                        @if (string.IsNullOrEmpty(app.ApplicationNumber))
                                        {
                                            <span class="badge bg-light text-muted border">No tracking</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-dark">@app.ApplicationNumber</span>
                                        }
                                    </td>
                                    <td>
                                        @app.Date.ToString("dd-MMM-yyyy")
                                        @if (app.EndDate.HasValue && app.EndDate.Value != app.Date)
                                        {
                                            <span class="text-muted">→ @app.EndDate.Value.ToString("dd-MMM")</span>
                                        }
                                    </td>
                                    <td>@app.EmployeeName</td>
                                    <td>
                                        @if (app.Category == "Leave")
                                        {
                                            <span class="badge bg-soft-info text-info border border-info border-opacity-25 rounded-pill px-3">Leave</span>
                                        }
                                        else if (app.Category == "Regularization")
                                        {
                                            <span class="badge bg-soft-warning text-dark border border-warning border-opacity-25 rounded-pill px-3">Regularization</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-soft-secondary text-secondary border border-secondary border-opacity-25 rounded-pill px-3">Manual Entry</span>
                                        }
                                    </td>
                                    <td>@app.Details</td>
                                    <td>
                                        @app.Reason
                                        @if (app.ChildItems != null && app.ChildItems.Any())
                                        {
                                            <button type="button" class="btn btn-sm btn-link text-info p-0 ms-2" data-bs-toggle="modal" data-bs-target="#modal-@app.Id">
                                                (View Details)
                                            </button>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        @if (app.Category == "Attendance Record")
                                        {
                                            <form method="post" asp-page-handler="Clear" class="d-inline">
                                                <input type="hidden" name="id" value="@app.Id" />
                                                <input type="hidden" name="category" value="@app.Category" />
                                                <button type="submit" class="btn btn-sm btn-soft-danger" onclick="return confirm('Clear this tracking number?')">
                                                    <i class="bi bi-trash me-1"></i>Clear
                                                </button>
                                            </form>
                                        }
                                        else if (app.Status == "Approved")
                                        {
                                            <span class="text-success small fw-medium"><i class="bi bi-check-circle-fill me-1"></i>Approved</span>
                                        }
                                        else if (app.Status == "Rejected")
                                        {
                                            <span class="text-danger small fw-medium"><i class="bi bi-x-circle-fill me-1"></i>Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small fw-medium"><i class="bi bi-clock-history me-1"></i>@app.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-info-circle mb-2 d-block fa-2x"></i>
                                    No applications found for the selected period.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-4 px-4 pb-4">
                <partial name="_Pagination" model="@(new PaginationViewModel { 
                    List = Model.Applications, 
                    PageName = "./ApplicationTracking",
                    QueryParams = new Dictionary<string, string?> {
                        { "Month", Model.Month.ToString() },
                        { "Year", Model.Year.ToString() }
                    } 
                })" />
            </div>
        </div>
    </div>
</div>

<!-- Modals for Grouped Tracking Requests -->
@if (Model.Applications != null && Model.Applications.Any())
{
    foreach (var app in Model.Applications.Where(a => a.ChildItems != null && a.ChildItems.Any()))
    {
        var count = app.ChildItems!.Count;
        var approvedCount = app.ChildItems.Count(x => x.Status == "Approved");
        var rejectedCount = app.ChildItems.Count(x => x.Status == "Rejected");
        var pendingCount = app.ChildItems.Count(x => x.Status == "Pending");

        <div class="modal fade" id="modal-@app.Id" tabindex="-1" aria-labelledby="modalLabel-@app.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-light border-bottom-0">
                        <div>
                            <h5 class="modal-title mb-1" id="modalLabel-@app.Id">
                                <i class="bi bi-stack me-2 text-primary"></i>Batch Request Details
                            </h5>
                            <p class="text-muted small mb-0">
                                App #: <strong>@(app.ApplicationNumber ?? "N/A")</strong> | 
                                Employee: <strong>@app.EmployeeName</strong>
                            </p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    
                    <div class="modal-body p-0">
                        <div id="carousel-@app.Id" class="carousel slide" data-bs-interval="false">
                            <div class="carousel-inner p-4">
                                @{ var index = 0; }
                                @foreach (var item in app.ChildItems)
                                {
                                    <div class="carousel-item @(index == 0 ? "active" : "")">
                                        <div class="d-flex justify-content-between mb-3">
                                            <h6 class="fw-bold text-primary">Day @(index + 1) of @count</h6>
                                            <span class="badge @(item.Status == "Approved" ? "bg-success" : (item.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark"))">
                                                @item.Status.ToUpper()
                                            </span>
                                        </div>
                                        
                                        <div class="bg-light p-3 rounded-3 border mb-3">
                                            <div class="row g-3">
                                                <div class="col-sm-6">
                                                    <label class="small text-muted mb-1">Date</label>
                                                    <div class="fw-medium">@item.Date.ToString("dd MMM yyyy")</div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="small text-muted mb-1">Type</label>
                                                    <div>@item.Details</div>
                                                </div>
                                                <div class="col-12">
                                                    <label class="small text-muted mb-1">Reason</label>
                                                    <div class="text-dark">@item.Reason</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    index++;
                                }
                            </div>
                            
                            @if (count > 1)
                            {
                                <div class="d-flex justify-content-between align-items-center bg-light p-3 border-top">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-target="#carousel-@app.Id" data-bs-slide="prev">
                                        <i class="bi bi-chevron-left"></i> Previous
                                    </button>
                                    <div class="small text-muted text-center flex-grow-1">
                                        <span class="fw-medium text-success">@approvedCount Approved</span> &middot; 
                                        <span class="fw-medium text-danger">@rejectedCount Rejected</span> &middot; 
                                        <span class="fw-medium text-warning">@pendingCount Pending</span>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-target="#carousel-@app.Id" data-bs-slide="next">
                                        Next <i class="bi bi-chevron-right"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
