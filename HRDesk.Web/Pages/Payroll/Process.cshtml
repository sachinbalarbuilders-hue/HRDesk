@page
@model HRDesk.Web.Pages.Payroll.ProcessModel
@using Microsoft.EntityFrameworkCore
@using HRDesk.Web.Models
@inject HRDesk.Web.Data.BiometricAttendanceDbContext _db

@section Styles {
    <style>
        .adjustment-badge {
            font-size: 0.65rem;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .badge-allowance { background: #ecfdf5; color: #059669; border: 1px solid #b7f4d8; }
        .badge-deduction { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
        .btn-adjust {
            padding: 0.25rem 0.75rem;
            font-size: 0.75rem;
            border-radius: 6px;
            font-weight: 600;
        }
    </style>
}

@{
    ViewData["Title"] = "Payroll";
}

<div class="container-fluid pb-5">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-1 fw-bold">Payroll Hub</h4>
            <p class="text-muted mb-0 small">Calculate monthly salaries, manage approvals, and track cohort disbursement registers</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Payroll/Compliance/Index" class="btn btn-outline-success btn-sm rounded-pill px-3">
                <i class="bi bi-shield-check me-1"></i>Statutory & ECR
            </a>
            <a asp-page="/Payroll/PayGroups/Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-diagram-3 me-1"></i>Pay Groups
            </a>
            <a asp-page="/Payroll/EmployeeSalary/Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-currency-rupee me-1"></i>Manage Salaries
            </a>
        </div>
    </div>

    <!-- Main Navigation Tabs -->
    <ul class="nav nav-pills mb-4 p-1 bg-white rounded-pill shadow-sm border d-inline-flex" id="payrollMainTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 py-2 fw-semibold @(Model.ActiveTab != "history" ? "active" : "")" 
                    id="worksheet-tab" data-bs-toggle="pill" data-bs-target="#worksheet-tab-pane" type="button" role="tab">
                <i class="bi bi-calculator me-2"></i>Monthly Worksheet
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 py-2 fw-semibold @(Model.ActiveTab == "history" ? "active" : "")" 
                    id="history-tab" data-bs-toggle="pill" data-bs-target="#history-tab-pane" type="button" role="tab">
                <i class="bi bi-journal-text me-2"></i>Runs & Audit Register
                @if (Model.TotalRunsCount > 0)
                {
                    <span class="badge bg-primary-subtle text-primary ms-2 rounded-pill">@Model.TotalRunsCount</span>
                }
            </button>
        </li>
    </ul>

    @if (!string.IsNullOrEmpty(Model.Message) || !string.IsNullOrEmpty(Model.StatusMessage))
    {
        var alertMsg = !string.IsNullOrEmpty(Model.Message) ? Model.Message : Model.StatusMessage;
        <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> @alertMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="tab-content" id="payrollMainTabsContent">
        <!-- Tab 1: Monthly Worksheet -->
        <div class="tab-pane fade @(Model.ActiveTab != "history" ? "show active" : "")" id="worksheet-tab-pane" role="tabpanel">

            <!-- Quick Stats Summary -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body p-4 text-center">
                    <p class="mb-1 small opacity-75 text-uppercase fw-bold">Total Net Payout</p>
                    <h2 class="mb-0 fw-bold">₹@Model.TotalNetPayout.ToString("N2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white">
                <div class="card-body p-4 text-center">
                    <p class="mb-1 small text-muted text-uppercase fw-bold">Employees Processed</p>
                    <h2 class="mb-0 fw-bold text-dark">@Model.ProcessedCount <span class="fs-6 text-muted fw-normal">/ @Model.AvailableEmployees.Count</span></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white border-start border-success border-4">
                <div class="card-body p-4 text-center">
                    <p class="mb-1 small text-muted text-uppercase fw-bold text-success">Total Allowances</p>
                    <h2 class="mb-0 fw-bold text-success">₹@Model.TotalManualAdjustments.ToString("N2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white border-start border-danger border-4">
                <div class="card-body p-4 text-center">
                    <p class="mb-1 small text-muted text-uppercase fw-bold text-danger">Total Deductions</p>
                    <h2 class="mb-0 fw-bold text-danger">₹@Model.TotalManualDeductions.ToString("N2")</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Pay Group Cohort Selector Bar -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="small fw-bold text-uppercase text-muted me-2"><i class="bi bi-diagram-3 me-1 text-primary"></i>Pay Cohort:</span>
                    <a href="?TargetProcessMonth=@Model.TargetProcessMonth@(Model.SelectedDepartmentId.HasValue ? "&SelectedDepartmentId=" + Model.SelectedDepartmentId : "")"
                       class="btn btn-sm @(!Model.SelectedPayGroupId.HasValue ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
                        <i class="bi bi-grid-fill me-1"></i> All Cohorts
                    </a>
                    @foreach (var pg in Model.PayGroupsList)
                    {
                        var isSelected = Model.SelectedPayGroupId == pg.Id;
                        var statusClass = pg.Status switch {
                            "Paid" => "text-bg-success",
                            "Approved" => "text-bg-primary",
                            "Review" => "text-bg-info text-dark",
                            "Draft" => "text-bg-warning text-dark",
                            _ => "text-bg-light border text-muted"
                        };
                        <a href="?TargetProcessMonth=@Model.TargetProcessMonth&SelectedPayGroupId=@pg.Id@(Model.SelectedDepartmentId.HasValue ? "&SelectedDepartmentId=" + Model.SelectedDepartmentId : "")"
                           class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3 d-inline-flex align-items-center gap-2">
                            <span>@pg.Name</span>
                            <span class="badge @(isSelected ? "bg-white text-primary" : "bg-primary-subtle text-primary") rounded-pill">
                                @pg.ProcessedCount / @pg.TotalEmployees
                            </span>
                            <span class="badge @statusClass rounded-pill" style="font-size: 0.7rem;">
                                @(pg.Status == "Approved" || pg.Status == "Paid" ? "🔒 " : "")@pg.Status
                            </span>
                        </a>
                    }
                </div>
                @if (Model.SelectedPayGroupId.HasValue && Model.SelectedPayGroupId.Value > 0)
                {
                    var selectedGroup = Model.PayGroupsList.FirstOrDefault(p => p.Id == Model.SelectedPayGroupId.Value);
                    if (selectedGroup != null)
                    {
                        @if (Model.IsCurrentCohortLocked)
                        {
                            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3 shadow-sm" disabled title="Cohort payroll is @Model.CurrentCohortRun?.Status and locked against recalculations">
                                <i class="bi bi-lock-fill me-1"></i> Locked (@Model.CurrentCohortRun?.Status)
                            </button>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="ProcessPayGroup" asp-route-payGroupId="@selectedGroup.Id" onsubmit="showLoading('Processing @selectedGroup.Name cohort...')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="TargetProcessMonth" />
                                <input type="hidden" asp-for="IncludeLoans" />
                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm">
                                    <i class="bi bi-play-circle-fill me-1"></i> Process All in @selectedGroup.Code (@selectedGroup.TotalEmployees)
                                </button>
                            </form>
                        }
                    }
                }
            </div>
        </div>
    </div>

    <!-- Cohort Workflow Action Banner -->
    @if (Model.SelectedPayGroupId.HasValue && Model.CurrentCohortRun != null)
    {
        var run = Model.CurrentCohortRun;
        var group = Model.PayGroupsList.FirstOrDefault(p => p.Id == Model.SelectedPayGroupId.Value);
        var isLocked = Model.IsCurrentCohortLocked;

        <div class="card border-0 shadow-sm mb-4 @(isLocked ? (run.Status == "Paid" ? "border-start border-success border-4" : "border-start border-primary border-4") : (run.Status == "Review" ? "border-start border-info border-4" : "border-start border-warning border-4"))">
            <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-2 @(run.Status == "Paid" ? "bg-success-subtle text-success" : run.Status == "Approved" ? "bg-primary-subtle text-primary" : run.Status == "Review" ? "bg-info-subtle text-info" : "bg-warning-subtle text-warning") fs-4">
                        <i class="bi @(run.Status == "Paid" ? "bi-check2-all" : run.Status == "Approved" ? "bi-lock-fill" : run.Status == "Review" ? "bi-clock-history" : "bi-pencil-square")"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h6 class="mb-0 fw-bold">@group?.Name — @Model.TargetProcessMonth Run</h6>
                            <span class="badge @(run.Status == "Paid" ? "text-bg-success" : run.Status == "Approved" ? "text-bg-primary" : run.Status == "Review" ? "text-bg-info" : "text-bg-warning") px-2 py-1">
                                @run.Status.ToUpper()
                            </span>
                            @if (isLocked)
                            {
                                <span class="badge text-bg-secondary"><i class="bi bi-lock-fill me-1"></i>LOCKED</span>
                            }
                        </div>
                        <small class="text-muted">
                            @if (run.Status == "Paid")
                            {
                                <span>Paid via @run.PaymentMethod on @(run.PaymentDate?.ToString("dd-MMM-yyyy") ?? "N/A") @(string.IsNullOrEmpty(run.PaymentReference) ? "" : $"• Ref: {run.PaymentReference}")</span>
                            }
                            else if (run.Status == "Approved")
                            {
                                <span>Approved by @(run.ApprovedBy ?? "Management") on @(run.ApprovedAt?.ToString("dd-MMM-yyyy HH:mm") ?? "N/A") • Calculations locked</span>
                            }
                            else if (run.Status == "Review")
                            {
                                <span>Submitted by @(run.SubmittedBy ?? "HR") on @(run.SubmittedAt?.ToString("dd-MMM-yyyy HH:mm") ?? "N/A") • Awaiting Manager sign-off</span>
                            }
                            else
                            {
                                <span>Draft status &mdash; Calculations and manual adjustments can be modified freely.</span>
                            }
                        </small>
                    </div>
                </div>

                <!-- Workflow Action Buttons -->
                <div class="d-flex align-items-center gap-2">
                    @if (run.Status == "Draft" || run.Status == "Not Started")
                    {
                        <form method="post" asp-page-handler="SubmitRun" asp-route-payGroupId="@group?.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="TargetProcessMonth" />
                            <button type="submit" class="btn btn-sm btn-info text-dark fw-semibold" @(group?.ProcessedCount == 0 ? "disabled" : "") title="Submit to management for review">
                                <i class="bi bi-send-check me-1"></i> Submit for Review
                            </button>
                        </form>
                    }
                    else if (run.Status == "Review")
                    {
                        <form method="post" asp-page-handler="ApproveRun" asp-route-payGroupId="@group?.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="TargetProcessMonth" />
                            <button type="submit" class="btn btn-sm btn-primary fw-semibold" title="Approve and freeze calculations">
                                <i class="bi bi-patch-check-fill me-1"></i> Approve & Lock
                            </button>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openUnlockModal(@group?.Id, '@Html.Raw(Html.Encode(group?.Name))', 'Review')">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Revert to Draft
                        </button>
                    }
                    else if (run.Status == "Approved")
                    {
                        <button type="button" class="btn btn-sm btn-success fw-semibold" onclick="openMarkPaidModal(@group?.Id, '@Html.Raw(Html.Encode(group?.Name))', '@group?.TotalNetPayout.ToString("N2")')">
                            <i class="bi bi-cash-stack me-1"></i> Mark as Paid / Disburse
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="openUnlockModal(@group?.Id, '@Html.Raw(Html.Encode(group?.Name))', 'Approved')">
                            <i class="bi bi-unlock me-1"></i> Unlock
                        </button>
                    }
                    else if (run.Status == "Paid")
                    {
                        <span class="badge text-bg-success px-3 py-2 fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Payout Completed</span>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="openUnlockModal(@group?.Id, '@Html.Raw(Html.Encode(group?.Name))', 'Paid')">
                            <i class="bi bi-unlock me-1"></i> Admin Unlock
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Selection Sidebar/Card -->
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2 text-primary"></i>Selection</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-page-handler="ProcessSelected" id="payrollForm" onsubmit="showLoading('Generating Payroll...')">
                        <input type="hidden" asp-for="TargetProcessMonth" />
                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-uppercase text-muted">Select Month</label>
                            <div class="input-group drop-shadow-sm mb-3">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar3 text-primary"></i></span>
                                <input type="month" asp-for="TargetProcessMonth" class="form-control border-start-0 ps-0" onchange="changeMonth(this.value)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-uppercase text-muted">Filter by Cohort</label>
                                <select class="form-select form-select-sm" onchange="filterByGroup(this.value)">
                                    <option value="">All Cohorts / Pay Groups</option>
                                    @foreach (var pg in Model.PayGroupsList)
                                    {
                                        <option value="@pg.Id" selected="@(Model.SelectedPayGroupId == pg.Id)">@pg.Name (@pg.Code)</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-uppercase text-muted">Filter by Department</label>
                                <select class="form-select form-select-sm" onchange="filterByDept(this.value)">
                                    <option value="">All Departments</option>
                                    @foreach (var dept in Model.DepartmentsList)
                                    {
                                        <option value="@dept.Id" selected="@(Model.SelectedDepartmentId == dept.Id)">@dept.DepartmentName</option>
                                    }
                                </select>
                            </div>

                            <div class="form-check form-switch bg-light p-3 rounded border shadow-sm">
                                <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IncludeLoans" id="includeLoansToggle">
                                <label class="form-check-label fw-bold small text-primary" for="includeLoansToggle">Include Loan Deductions</label>
                                <div class="form-text mt-1 extra-small">Uncheck this if you are settling loans manually (e.g., Foreclosure) this month.</div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-uppercase text-muted">Quick Actions</label>
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-sm btn-soft-primary text-start" onclick="selectAll()">
                                    <i class="bi bi-check-all me-2"></i>Select All Employees
                                </button>
                                <button type="button" class="btn btn-sm btn-soft-secondary text-start" onclick="deselectAll()">
                                    <i class="bi bi-x-circle me-2"></i>Deselect All
                                </button>
                                <button type="button" class="btn btn-sm btn-soft-info text-start" onclick="selectUnprocessed()">
                                    <i class="bi bi-arrow-repeat me-2"></i>Select Unprocessed
                                </button>
                            </div>
                        </div>

                        <div class="pt-2 border-top">
                            <button type="submit" id="processBtn" class="btn @(Model.IsCurrentCohortLocked ? "btn-secondary" : "btn-primary") w-100 py-2 mt-3" @(Model.AvailableEmployees.Any(e => e.HasSalary) && !Model.IsCurrentCohortLocked ? "" : "disabled")>
                                @if (Model.IsCurrentCohortLocked)
                                {
                                    <span><i class="bi bi-lock-fill me-2"></i>Cohort Locked (@Model.CurrentCohortRun?.Status)</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-calculator-fill me-2"></i>Process Selection</span>
                                }
                            </button>
                            @if (Model.IsCurrentCohortLocked)
                            {
                                <div class="alert alert-warning py-2 px-3 small mt-3 mb-0 border-0 shadow-sm">
                                    <i class="bi bi-lock-fill me-1"></i> This cohort is <strong>@Model.CurrentCohortRun?.Status</strong> and locked. Revert/Unlock above if you need to recalculate.
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mt-3 mb-0">
                                    <i class="bi bi-info-circle me-1"></i> Selection will process the calculated earnings and deductions for the chosen month.
                                </p>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Employee List Card -->
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pt-4 px-4">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-people me-2 text-primary"></i>Employee Status</h5>
                    <span class="badge bg-soft-primary text-primary px-3">@Model.AvailableEmployees.Count(e => e.HasSalary) Eligible</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.AvailableEmployees.Any())
                    {
                        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                            <table class="table table-modern align-middle mb-0">
                                <thead class="sticky-top bg-white" style="z-index: 10;">
                                    <tr>
                                        <th width="60" class="ps-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="masterCheckbox" onclick="toggleAll(this)">
                                            </div>
                                        </th>
                                        <th>Employee</th>
                                        <th>Cohort / Pay Group</th>
                                        <th>Department</th>
                                        <th>Gross Salary</th>
                                        <th style="min-width: 150px;">Adjustments</th>
                                        <th class="pe-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var emp in Model.AvailableEmployees)
                                {
                                    <tr class="@(!emp.HasSalary ? "opacity-75" : "")">
                                        <td class="ps-4">
                                            <div class="form-check">
                                                <input type="checkbox" 
                                                       name="EmployeeIdsToProcess" 
                                                       value="@emp.EmployeeId" 
                                                       class="form-check-input employee-checkbox"
                                                       onchange="updateProcessButton()"
                                                       form="payrollForm"
                                                       data-processed="@emp.AlreadyProcessed.ToString().ToLower()"
                                                       @(emp.AlreadyProcessed ? "checked" : "")
                                                       @(!emp.HasSalary ? "disabled" : "") />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="avatar-circle small">
                                                    @(string.IsNullOrEmpty(emp.EmployeeName) ? "?" : emp.EmployeeName[0].ToString().ToUpper())
                                                </div>
                                                <div class="fw-semibold">@emp.EmployeeName</div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                                                <i class="bi bi-diagram-3 me-1"></i>@emp.PayGroupName
                                            </span>
                                        </td>
                                        <td class="text-muted small">@emp.Department</td>
                                        <td><span class="fw-bold text-dark">₹@emp.GrossSalary.ToString("N2")</span></td>
                                        <td>
                                            <input type="hidden" name="AdjustmentData[@emp.EmployeeId]" id="adjData_@emp.EmployeeId" value='@System.Text.Json.JsonSerializer.Serialize(emp.Adjustments)' form="payrollForm" />
                                            
                                            <div class="d-flex flex-column gap-1">
                                                <div id="badgeContainer_@emp.EmployeeId" class="d-flex flex-wrap gap-1">
                                                    @foreach (var adj in emp.Adjustments)
                                                    {
                                                        var badgeClass = adj.Type == "Allowance" ? "badge-allowance" : "badge-deduction";
                                                        var icon = adj.Type == "Allowance" ? "bi-plus-circle-fill" : "bi-dash-circle-fill";
                                                        <span class="adjustment-badge @badgeClass" title="@adj.Name">
                                                            <i class="bi @icon"></i> ₹@adj.Amount.ToString("0.##")
                                                        </span>
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-adjust btn-outline-primary" onclick="openAdjustmentModal(@emp.EmployeeId, '@emp.EmployeeName.Replace("'", "\\'")')">
                                                    <i class="bi bi-plus-slash-minus me-1"></i> Adjust
                                                </button>
                                            </div>
                                        </td>
                                        <td class="pe-4">
                                            @if (!emp.HasSalary)
                                            {
                                                <span class="badge bg-soft-warning text-warning fw-semibold rounded-pill px-3">No Salary Set</span>
                                            }
                                            else if (emp.AlreadyProcessed)
                                            {
                                                <span class="badge bg-soft-success text-success fw-semibold rounded-pill px-3">Processed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-soft-secondary text-secondary fw-semibold rounded-pill px-3">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <partial name="_Pagination" model="@(new PaginationViewModel { List = Model.AvailableEmployees, QueryParams = new Dictionary<string, string?> { { "TargetProcessMonth", Model.TargetProcessMonth } }, PageName = "./Process" })" />
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-person-x text-secondary opacity-50 mb-3" style="font-size: 3rem;"></i>
                            <h6>No Employees Found</h6>
                            <p class="small mb-0">No active employees found for this month.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.PayrollRecords.Any())
    {
        <!-- Summary Dashboard -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pt-4 px-4">
                    <h5 class="mb-0 fw-bold">Payroll Summary <span class="text-muted fw-normal small">for @Model.TargetProcessMonth</span></h5>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="bulkPrintBtn" onclick="bulkPrintSelected()" disabled>
                            <i class="bi bi-printer me-1"></i> Bulk Print Selected
                        </button>
                        <div class="text-muted small">@Model.PayrollRecords.Count Records</div>
                    </div>
                </div>
                
                <div class="card border-0 shadow-sm overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-modern align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="small text-uppercase text-muted">
                                    <th class="ps-4" width="40">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" onclick="toggleSummaryAll(this)">
                                        </div>
                                    </th>
                                    <th>Employee</th>
                                    <th class="text-center">Days (P/A/L/W/H)</th>
                                    <th class="text-center">Payable</th>
                                    <th>Earnings</th>
                                    <th>Deductions</th>
                                    <th>Net Salary</th>
                                    <th class="pe-4">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.PayrollRecords)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input summary-checkbox" value="@item.Id" onchange="updateBulkPrintBtn()">
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold overflow-hidden text-nowrap" style="max-width: 150px;" title="@item.Employee?.EmployeeName">
                                            @item.Employee?.EmployeeName
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-soft-success text-success me-1" title="Present">@item.PresentDays.ToString("0.#") P</span>
                                        <span class="badge bg-soft-danger text-danger me-1" title="Absent">@item.AbsentDays.ToString("0.#") A</span>
                                        <span class="badge bg-soft-info text-info me-1" title="Paid Leave">@item.PaidLeaves.ToString("0.#") L</span>
                                        <span class="badge bg-soft-warning text-warning me-1" title="Weekoff">@item.Weekoffs.ToString("0.#") W</span>
                                        <span class="badge bg-soft-secondary text-secondary" title="Holiday">@item.Holidays.ToString("0.#") H</span>
                                    </td>
                                    <td class="text-center fw-bold text-primary">@item.PayableDays.ToString("0.#")</td>
                                    <td class="text-success small">
                                        ₹@item.TotalEarnings.ToString("N0")
                                        <button type="button" class="btn btn-sm p-0 ms-1 text-muted" onclick="showBreakdown(@item.Id, '@item.Employee?.EmployeeName', 'Earning')">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                    </td>
                                    <td class="text-danger small">
                                        ₹@item.TotalDeductions.ToString("N0")
                                        <button type="button" class="btn btn-sm p-0 ms-1 text-muted" onclick="showBreakdown(@item.Id, '@item.Employee?.EmployeeName', 'Deduction')">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                    </td>
                                    <td class="fw-bold">₹@item.NetSalary.ToString("N2")</td>
                                    <td class="pe-4">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="badge @(item.Status == "Processed" ? "bg-soft-success text-success" : 
                                                                  item.Status == "Approved" ? "bg-soft-primary text-primary" :
                                                                  item.Status == "Paid" ? "bg-soft-info text-info" : "bg-soft-secondary text-secondary") rounded-pill px-3 fw-semibold">
                                                @item.Status
                                            </span>
                                            <a asp-page="/Payroll/Payslip" asp-route-id="@item.Id" class="btn btn-icon-soft" title="View Payslip">
                                                <i class="bi bi-file-earmark-richtext"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                            <tfoot class="bg-light border-top-0">
                                <tr class="fw-bold align-middle">
                                    <td colspan="4" class="ps-4">
                                        <span class="text-uppercase small text-muted me-2">TOTALS</span>
                                    </td>
                                    <td class="text-success">₹@Model.PayrollRecords.Sum(p => p.TotalEarnings).ToString("N0")</td>
                                    <td class="text-danger">₹@Model.PayrollRecords.Sum(p => p.TotalDeductions).ToString("N0")</td>
                                    <td class="text-primary fs-5">₹@Model.PayrollRecords.Sum(p => p.NetSalary).ToString("N2")</td>
                                    <td class="pe-4 text-end">
                                        <span class="badge bg-white text-dark border rounded-pill">@Model.PayrollRecords.Count Records</span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <partial name="_Pagination" model="@(new PaginationViewModel { List = Model.PayrollRecords, QueryParams = new Dictionary<string, string?> { { "TargetProcessMonth", Model.TargetProcessMonth } }, PageName = "./Process" })" />
                </div>
            </div>
        </div>
    }
