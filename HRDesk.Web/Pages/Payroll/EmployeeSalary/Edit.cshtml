@page
@model HRDesk.Web.Pages.Payroll.EmployeeSalary.EditModel

@{
    ViewData["Title"] = "Edit Employee Salary";
}

<div class="container pb-5">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Salary Settings</h4>
            <p class="text-muted mb-0 small">Configure monthly pay components for Organization Employees</p>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="row g-0">
                    <!-- Form Side -->
                    <div class="col-md-7 p-4 p-lg-5">
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <div class="avatar-circle">
                                @(string.IsNullOrEmpty(Model.EmployeeName) ? "?" : Model.EmployeeName[0].ToString().ToUpper())
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold">@Model.EmployeeName</h5>
                                <span class="text-muted small">Update salary details</span>
                            </div>
                        </div>

                        <form method="post">
                            <input type="hidden" asp-for="EmployeeId" />
                            <input type="hidden" asp-for="EmployeeName" />

                            <div class="mb-4">
                                <label asp-for="EffectiveDate" class="form-label fw-semibold small text-uppercase text-muted">Effective Start Date</label>
                                <div class="input-group drop-shadow-sm">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar-event text-primary"></i></span>
                                    <input asp-for="EffectiveDate" class="form-control border-start-0 ps-0" type="date" />
                                </div>
                                <span asp-validation-for="EffectiveDate" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="BasicSalary" class="form-label fw-semibold small text-uppercase text-muted">Basic Salary (₹)</label>
                                <div class="input-group drop-shadow-sm">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-cash text-primary"></i></span>
                                    <input asp-for="BasicSalary" class="form-control border-start-0 ps-0" type="number" step="0.01" min="0" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="BasicSalary" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="SpecialAllowance" class="form-label fw-semibold small text-uppercase text-muted">Special Allowance (₹)</label>
                                <div class="input-group drop-shadow-sm">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-plus-circle text-success"></i></span>
                                    <input asp-for="SpecialAllowance" class="form-control border-start-0 ps-0" type="number" step="0.01" min="0" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="SpecialAllowance" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="ProvidentFund" class="form-label fw-semibold small text-uppercase text-muted">PF (₹)</label>
                                    <div class="input-group drop-shadow-sm">
                                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-bank text-primary"></i></span>
                                        <input asp-for="ProvidentFund" class="form-control border-start-0 ps-0 text-danger" type="number" step="0.01" min="0" placeholder="0.00" />
                                    </div>
                                    <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">0 = Auto 12% (₹1,800 max)</small>
                                    <span asp-validation-for="ProvidentFund" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="ESIC" class="form-label fw-semibold small text-uppercase text-muted">ESIC (₹)</label>
                                    <div class="input-group drop-shadow-sm">
                                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-heart-pulse text-success"></i></span>
                                        <input asp-for="ESIC" class="form-control border-start-0 ps-0 text-danger" type="number" step="0.01" min="0" placeholder="0.00" />
                                    </div>
                                    <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">0 = Auto 0.75% (&le; ₹21k)</small>
                                    <span asp-validation-for="ESIC" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="ProfessionalTax" class="form-label fw-semibold small text-uppercase text-muted">PT Gujarat (₹)</label>
                                    <div class="input-group drop-shadow-sm">
                                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-receipt text-warning"></i></span>
                                        <input asp-for="ProfessionalTax" class="form-control border-start-0 ps-0 text-danger" type="number" step="0.01" min="0" placeholder="0.00" />
                                    </div>
                                    <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">0 = Auto Gujarat slabs</small>
                                    <span asp-validation-for="ProfessionalTax" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="card bg-light border-0 shadow-none p-3 mb-4 rounded-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-bold small text-dark"><i class="bi bi-shield-check text-primary me-1"></i> Statutory Compliance Eligibility</span>
                                    <a class="small text-decoration-none" data-bs-toggle="collapse" href="#statutoryConfigCollapse" role="button" aria-expanded="false">
                                        Configure Details <i class="bi bi-chevron-down"></i>
                                    </a>
                                </div>
                                <div class="collapse" id="statutoryConfigCollapse">
                                    <div class="pt-2 border-top">
                                        <div class="row g-2 mb-2">
                                            <div class="col-6">
                                                <div class="form-check form-switch small">
                                                    <input class="form-check-input" type="checkbox" asp-for="IsPfEligible" role="switch" id="salaryPfEligible">
                                                    <label class="form-check-label" for="salaryPfEligible">PF Eligible (12%)</label>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="form-check form-switch small">
                                                    <input class="form-check-input" type="checkbox" asp-for="PfWageCap" role="switch" id="salaryPfCap">
                                                    <label class="form-check-label" for="salaryPfCap">Cap at ₹15k Ceiling</label>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="form-check form-switch small">
                                                    <input class="form-check-input" type="checkbox" asp-for="IsEsicEligible" role="switch" id="salaryEsicEligible">
                                                    <label class="form-check-label" for="salaryEsicEligible">ESIC Eligible</label>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="form-check form-switch small">
                                                    <input class="form-check-input" type="checkbox" asp-for="IsPtEligible" role="switch" id="salaryPtEligible">
                                                    <label class="form-check-label" for="salaryPtEligible">PT Eligible</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-md-4">
                                                <label class="form-label small mb-1" style="font-size:0.75rem;">UAN</label>
                                                <input asp-for="UanNumber" class="form-control form-control-sm" placeholder="EPFO UAN" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small mb-1" style="font-size:0.75rem;">ESIC IP No.</label>
                                                <input asp-for="EsicNumber" class="form-control form-control-sm" placeholder="ESIC Number" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small mb-1" style="font-size:0.75rem;">PAN</label>
                                                <input asp-for="PanNumber" class="form-control form-control-sm text-uppercase" placeholder="PAN" maxlength="10" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary px-4 py-2">
                                    <i class="bi bi-save me-2"></i>Save Configuration
                                </button>
                                <a asp-page="./Index" class="btn btn-soft-secondary px-4 py-2">Cancel</a>
                            </div>
                        </form>
                    </div>

                    <!-- Info/Summary Side -->
                    <div class="col-md-5 bg-light p-4 p-lg-5 border-start">
                        <h6 class="fw-bold text-uppercase small text-muted mb-4">Salary & Statutory Summary</h6>
                        <div class="mb-4 bg-white p-3 rounded border">
                                <span class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">Net Annual Projection</span>
                                <h3 class="mb-0 text-primary fw-bolder mt-1" id="annualProjection">
                                    @{ 
                                        var netAnnual = ((Model.BasicSalary + Model.SpecialAllowance) - (Model.ProvidentFund + Model.ESIC + Model.ProfessionalTax)) * 12;
                                        var formattedNetAnnual = netAnnual.ToString("C0", new System.Globalization.CultureInfo("en-IN"));
                                     }
                                    @formattedNetAnnual
                                </h3>
                            </div>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Monthly Gross</span>
                            <span class="fw-bold text-dark">₹<span id="grossSalary">@((Model.BasicSalary + Model.SpecialAllowance).ToString("N2"))</span></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">PF (EE 12%)</span>
                            <span class="text-danger small" id="pfEstDisplay">- ₹@Model.ProvidentFund.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">ESIC (EE 0.75%)</span>
                            <span class="text-danger small" id="esicEstDisplay">- ₹@Model.ESIC.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">PT (Gujarat)</span>
                            <span class="text-danger small" id="ptEstDisplay">- ₹@Model.ProfessionalTax.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2 pt-2 border-top">
                            <span class="text-muted fw-semibold">Total Deductions</span>
                            <span class="fw-bold text-danger">- ₹<span id="totalDeductions">@((Model.ProvidentFund + Model.ESIC + Model.ProfessionalTax).ToString("N2"))</span></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-0 mt-3 pt-3 border-top">
                            <span class="fw-bold text-dark">Estimated Net Take-Home</span>
                            <span class="fw-900 text-primary fs-5">₹<span id="totalSalary">@((Model.BasicSalary + Model.SpecialAllowance - Model.ProvidentFund - Model.ESIC - Model.ProfessionalTax).ToString("N2"))</span></span>
                        </div>
                        
                        <hr class="my-4">

                        <h6 class="fw-bold text-uppercase small text-muted mb-3">Policy Reminders</h6>
                        <ul class="list-unstyled small text-muted">
                            <li class="mb-3 d-flex gap-3">
                                <i class="bi bi-info-circle text-primary fs-5"></i>
                                <div><strong>Auto-Proration:</strong> Earnings are calculated based on monthly attendance logs.</div>
                            </li>
                            <li class="mb-3 d-flex gap-3">
                                <i class="bi bi-dash-circle text-danger fs-5"></i>
                                <div><strong>Deductions:</strong> Unpaid leaves or absent days will reduce net payout automatically.</div>
                            </li>
                            <li class="d-flex gap-3">
                                <i class="bi bi-shield-check text-success fs-5"></i>
                                <div><strong>Validation:</strong> Ensure basic salary follows regional statutory minimums.</div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Salary History Section -->
    <div class="row justify-content-center mt-4">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Salary Change History</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Component</th>
                                    <th>Amount</th>
                                    <th>Effective From</th>
                                    <th>Effective To</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.SalaryHistory != null && Model.SalaryHistory.Any())
                                {
                                    @foreach (var history in Model.SalaryHistory)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-medium text-dark">@history.ComponentName</td>
                                            <td>₹@history.Amount.ToString("N2")</td>
                                            <td>@history.EffectiveFrom.ToString("dd MMM yyyy")</td>
                                            <td>
                                                @(history.EffectiveTo.HasValue ? history.EffectiveTo.Value.ToString("dd MMM yyyy") : "-")
                                            </td>
                                            <td>
                                                @if (history.IsActive)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">Expired</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">No salary history found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const basicInput = document.querySelector('input[name="BasicSalary"]');
            const specialInput = document.querySelector('input[name="SpecialAllowance"]');
            const pfInput = document.querySelector('input[name="ProvidentFund"]');
            const esicInput = document.querySelector('input[name="ESIC"]');
            const ptInput = document.querySelector('input[name="ProfessionalTax"]');

            const pfEligibleSwitch = document.getElementById('salaryPfEligible');
            const pfCapSwitch = document.getElementById('salaryPfCap');
            const esicEligibleSwitch = document.getElementById('salaryEsicEligible');
            const ptEligibleSwitch = document.getElementById('salaryPtEligible');
            
            const grossSpan = document.getElementById('grossSalary');
            const deductionSpan = document.getElementById('totalDeductions');
            const netSpan = document.getElementById('totalSalary');
            const annualSpan = document.getElementById('annualProjection');

            const pfEstDisplay = document.getElementById('pfEstDisplay');
            const esicEstDisplay = document.getElementById('esicEstDisplay');
            const ptEstDisplay = document.getElementById('ptEstDisplay');

            function updateTotal() {
                const basic = parseFloat(basicInput?.value) || 0;
                const special = parseFloat(specialInput?.value) || 0;
                const gross = basic + special;

                let manualPf = parseFloat(pfInput?.value) || 0;
                let manualEsic = parseFloat(esicInput?.value) || 0;
                let manualPt = parseFloat(ptInput?.value) || 0;

                let effectivePf = manualPf;
                let isPfAuto = false;
                if (manualPf <= 0 && pfEligibleSwitch && pfEligibleSwitch.checked) {
                    let wages = basic;
                    if (pfCapSwitch && pfCapSwitch.checked) {
                        wages = Math.min(15000, wages);
                    }
                    effectivePf = Math.round(wages * 0.12);
                    isPfAuto = true;
                }

                let effectiveEsic = manualEsic;
                let isEsicAuto = false;
                if (manualEsic <= 0 && esicEligibleSwitch && esicEligibleSwitch.checked && gross <= 21000) {
                    effectiveEsic = Math.ceil(gross * 0.0075);
                    isEsicAuto = true;
                }

                let effectivePt = manualPt;
                let isPtAuto = false;
                if (manualPt <= 0 && ptEligibleSwitch && ptEligibleSwitch.checked) {
                    if (gross >= 12000) effectivePt = 200;
                    else if (gross >= 9000) effectivePt = 150;
                    else if (gross >= 6000) effectivePt = 80;
                    else effectivePt = 0;
                    isPtAuto = true;
                }

                if (pfEstDisplay) {
                    pfEstDisplay.innerHTML = `- ₹${effectivePf.toFixed(2)} ${isPfAuto ? '<span class="badge bg-primary-subtle text-primary border" style="font-size:0.65rem;">Auto</span>' : ''}`;
                }
                if (esicEstDisplay) {
                    esicEstDisplay.innerHTML = `- ₹${effectiveEsic.toFixed(2)} ${isEsicAuto ? '<span class="badge bg-success-subtle text-success border" style="font-size:0.65rem;">Auto</span>' : ''}`;
                }
                if (ptEstDisplay) {
                    ptEstDisplay.innerHTML = `- ₹${effectivePt.toFixed(2)} ${isPtAuto ? '<span class="badge bg-warning-subtle text-warning border" style="font-size:0.65rem;">Auto</span>' : ''}`;
                }

                const deductions = effectivePf + effectiveEsic + effectivePt;
                const net = Math.max(0, gross - deductions);
                const annual = net * 12;

                if (grossSpan) grossSpan.textContent = gross.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                if (deductionSpan) deductionSpan.textContent = deductions.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                if (netSpan) netSpan.textContent = net.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                if (annualSpan) annualSpan.textContent = annual.toLocaleString('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 });
            }

            [basicInput, specialInput, pfInput, esicInput, ptInput].forEach(inp => {
                if (inp) inp.addEventListener('input', updateTotal);
            });
            [pfEligibleSwitch, pfCapSwitch, esicEligibleSwitch, ptEligibleSwitch].forEach(sw => {
                if (sw) sw.addEventListener('change', updateTotal);
            });

            updateTotal();
        });
    </script>
}
