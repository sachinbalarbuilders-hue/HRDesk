@page
@model HRDesk.Web.Pages.Payroll.PayGroups.IndexModel
@{
    ViewData["Title"] = "Pay Groups";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Pay Groups</h4>
        <p class="text-muted mb-0 small">Organize employees into cohorts for structured, cohort-specific payroll processing</p>
    </div>
    <button class="btn btn-primary" type="button" onclick="openCreateModal()">
        <i class="bi bi-plus-lg me-1"></i>New Pay Group
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-stat border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-soft-primary text-primary me-3">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-semibold">Total Pay Groups</h6>
                    <h3 class="mb-0 fw-bold">@Model.PayGroups.Count</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-stat border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-soft-success text-success me-3">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-semibold">Active Cohorts</h6>
                    <h3 class="mb-0 fw-bold">@Model.PayGroups.Count(p => p.Status == "active")</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-stat border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-soft-warning text-warning me-3">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-semibold">Assigned Staff</h6>
                    <h3 class="mb-0 fw-bold">@Model.PayGroups.Sum(p => p.EmployeeCount)</h3>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var isArchivedTab = string.Equals(Model.Tab, "archived", StringComparison.OrdinalIgnoreCase);
    var displayGroups = isArchivedTab ? Model.ArchivedPayGroups : Model.ActivePayGroups;
}

<!-- Pill Tabs: Active vs Archived -->
<div class="mb-3">
    <ul class="nav nav-pills p-1 bg-white rounded-pill shadow-sm border d-inline-flex" id="payGroupTabs">
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 py-2 fw-semibold @(!isArchivedTab ? "active" : "")" 
               asp-page="./Index" asp-route-tab="active">
                <i class="bi bi-check2-circle me-2"></i>Active (@Model.ActivePayGroups.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 py-2 fw-semibold @(isArchivedTab ? "active text-bg-warning" : "text-muted")" 
               asp-page="./Index" asp-route-tab="archived">
                <i class="bi bi-archive me-2"></i>Archived (@Model.ArchivedPayGroups.Count)
            </a>
        </li>
    </ul>
</div>

<!-- Pay Groups Table -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-bottom d-flex align-items-center justify-content-between py-3 px-4">
        <h5 class="mb-0 fw-bold">
            <i class="bi @(!isArchivedTab ? "bi-diagram-3 text-primary" : "bi-archive text-warning") me-2"></i>
            @(!isArchivedTab ? "Active Pay Groups" : "Archived Pay Groups")
        </h5>
        <span class="badge text-bg-secondary">@displayGroups.Count groups</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Group Name & Code</th>
                        <th>Frequency</th>
                        <th>Cutoff Day</th>
                        <th>Assigned Staff</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (displayGroups.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi @(!isArchivedTab ? "bi-people" : "bi-archive") fs-1 d-block mb-2 opacity-25"></i>
                            @(!isArchivedTab ? "No active pay groups configured." : "No archived pay groups.")
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var g in displayGroups)
                    {
                        var isActive = string.Equals(g.Status, "active", StringComparison.OrdinalIgnoreCase);
                        <tr class="@(isArchivedTab ? "table-light" : "")">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(isArchivedTab ? "bg-secondary-subtle text-secondary" : "bg-primary-subtle text-primary") border px-2 py-1 fw-bold">@g.Code</span>
                                    <div>
                                        <div class="fw-semibold @(isArchivedTab ? "text-decoration-line-through text-muted" : "")">@g.Name</div>
                                        @if (!string.IsNullOrEmpty(g.Description))
                                        {
                                            <small class="text-muted">@g.Description</small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge text-bg-light border">@g.PaymentFrequency</span>
                            </td>
                            <td>
                                <span class="fw-semibold">Day @g.CutoffDay</span> <small class="text-muted">of month</small>
                            </td>
                            <td>
                                @if (!isArchivedTab)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                                            onclick="openAssignModal(@g.Id, '@Html.Raw(Html.Encode(g.Name))', '@g.Code')"
                                            title="Click to view and assign employees">
                                        <i class="bi bi-people-fill"></i>
                                        <span>@g.EmployeeCount Staff</span>
                                        <i class="bi bi-chevron-down ms-1 small opacity-75"></i>
                                    </button>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge bg-light text-muted border">@g.EmployeeCount Staff</span>
                                        @if (g.PayrollRunCount > 0)
                                        {
                                            <span class="badge @(g.HasRealPayrollRuns ? "bg-info-subtle text-info border border-info-subtle" : "bg-light text-muted border")" 
                                                  title="@(g.HasRealPayrollRuns ? $"{g.PayrollRunCount} historical payroll run(s) on record" : $"{g.PayrollRunCount} draft placeholder(s)")">
                                                <i class="bi bi-receipt me-1"></i>@g.PayrollRunCount Run@(g.PayrollRunCount > 1 ? "s" : "")
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="badge @(isArchivedTab ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : isActive ? "text-bg-success" : "text-bg-secondary")">
                                    @g.Status.ToUpper()
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                @if (!isArchivedTab)
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <button class="dropdown-item" type="button"
                                                        onclick="openAssignModal(@g.Id, '@Html.Raw(Html.Encode(g.Name))', '@g.Code')">
                                                    <i class="bi bi-person-plus text-primary me-2"></i>Assign Staff
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item" type="button"
                                                        onclick="openEditModal(@g.Id, '@Html.Raw(Html.Encode(g.Name))', '@g.Code', '@Html.Raw(Html.Encode(g.Description ?? ""))', '@g.PaymentFrequency', @g.CutoffDay, '@g.Status')">
                                                    <i class="bi bi-pencil-square text-secondary me-2"></i>Edit
                                                </button>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger"
                                                        onclick="openArchiveModal(@g.Id, '@Html.Raw(Html.Encode(g.Name))', '@g.Code', @g.EmployeeCount)">
                                                    <i class="bi bi-archive me-2"></i>Archive
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <form method="post" asp-page-handler="Restore" asp-route-id="@g.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-success">
                                                        <i class="bi bi-arrow-counterclockwise me-2"></i>Restore
                                                    </button>
                                                </form>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger"
                                                        onclick="openPermanentDeleteModal(@g.Id, '@Html.Raw(Html.Encode(g.Name))', '@g.Code', @g.EmployeeCount, @g.PayrollRunCount, @(g.HasRealPayrollRuns ? "true" : "false"))">
                                                    <i class="bi bi-trash3-fill me-2"></i>Permanently Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Assign Employees Popup / Modal -->
<div class="modal fade" id="assignEmployeesModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="AssignEmployees" id="assignEmployeesForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AssignPayGroupId" id="assignGroupId" />
                
                <div class="modal-header border-bottom bg-light">
                    <div>
                        <h5 class="modal-title fw-bold mb-1" id="assignModalLabel">Assign Employees to Cohort</h5>
                        <p class="text-muted small mb-0">Select all employees who belong to this pay group. Unchecked employees will be unassigned.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-3">
                    <!-- Controls Bar -->
                    <div class="row g-2 mb-3 align-items-center">
                        <div class="col-md-7">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="employeeSearchInput" class="form-control border-start-0" placeholder="Search by name, ID, or department..." onkeyup="filterEmployeeList()" />
                            </div>
                        </div>
                        <div class="col-md-5 d-flex align-items-center justify-content-end gap-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold" id="selectionCountBadge">
                                0 selected
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllVisible(true)">Select All</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllVisible(false)">Clear</button>
                        </div>
                    </div>

                    <!-- Scrollable Employee Table -->
                    <div class="border rounded" style="max-height: 420px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0" id="assignEmployeesTable">
                            <thead class="table-light sticky-top" style="z-index: 1;">
                                <tr>
                                    <th style="width: 45px;" class="text-center">
                                        <input type="checkbox" class="form-check-input" id="masterCheckbox" onchange="toggleMaster(this)" />
                                    </th>
                                    <th>Employee</th>
                                    <th>Department</th>
                                    <th>Designation</th>
                                    <th>Current Pay Group</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var emp in Model.AllEmployees)
                            {
                                <tr class="employee-row" 
                                    data-emp-id="@emp.EmployeeId"
                                    data-group-id="@(emp.PayGroupId?.ToString() ?? "")"
                                    data-group-code="@emp.CurrentPayGroupCode"
                                    data-search-text="@(emp.EmployeeName.ToLower()) @emp.EmployeeId @(emp.DepartmentName.ToLower()) @(emp.DesignationName.ToLower())">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input emp-checkbox" 
                                               name="SelectedEmployeeIds" 
                                               value="@emp.EmployeeId" 
                                               id="chk_@emp.EmployeeId"
                                               onchange="updateSelectionCount()" />
                                    </td>
                                    <td>
                                        <label for="chk_@emp.EmployeeId" class="fw-semibold d-block mb-0 cursor-pointer">
                                            @emp.EmployeeName
                                            <span class="text-muted small fw-normal ms-1">#@emp.EmployeeId</span>
                                        </label>
                                    </td>
                                    <td>
                                        <span class="badge text-bg-light border">@emp.DepartmentName</span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@emp.DesignationName</span>
                                    </td>
                                    <td>
                                        <span class="current-group-badge badge @(string.IsNullOrEmpty(emp.CurrentPayGroupCode) ? "text-bg-light border text-muted" : "bg-info-subtle text-info border border-info-subtle")">
                                            @(string.IsNullOrEmpty(emp.CurrentPayGroupCode) ? "Unassigned" : emp.CurrentPayGroupCode)
                                        </span>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i>Save Assignments
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Pay Group Modal (Create / Edit) -->
<div class="modal fade" id="payGroupModal" tabindex="-1" aria-labelledby="payGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Save">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Input.Id" id="modalGroupId" />
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="payGroupModalLabel">New Pay Group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label fw-semibold">Group Name <span class="text-danger">*</span></label>
                        <input asp-for="Input.Name" class="form-control" id="modalGroupName" placeholder="e.g., Site Supervisors" required />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.Code" class="form-label fw-semibold">Code <span class="text-danger">*</span></label>
                            <input asp-for="Input.Code" class="form-control text-uppercase" id="modalGroupCode" placeholder="e.g., SITE" required maxlength="20" />
                            <span asp-validation-for="Input.Code" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.PaymentFrequency" class="form-label fw-semibold">Payment Frequency</label>
                            <select asp-for="Input.PaymentFrequency" class="form-select" id="modalGroupFrequency">
                                <option value="Monthly">Monthly</option>
                                <option value="Fortnightly">Fortnightly (Bi-weekly)</option>
                                <option value="Weekly">Weekly</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.CutoffDay" class="form-label fw-semibold">Cutoff Day of Month</label>
                            <input asp-for="Input.CutoffDay" type="number" min="1" max="31" class="form-control" id="modalGroupCutoff" value="30" />
                            <small class="text-muted">Enter 31 for last day of month (auto-adjusts for 28/30 days)</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Input.Status" class="form-select" id="modalGroupStatus">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Input.Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Input.Description" class="form-control" id="modalGroupDesc" rows="2" placeholder="Brief note on who belongs in this cohort"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Save Pay Group</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Archive Custom Confirmation Modal -->
<div class="modal fade" id="archiveModal" tabindex="-1" aria-labelledby="archiveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom bg-warning-subtle text-warning-emphasis">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="archiveModalLabel">
                    <i class="bi bi-archive-fill text-warning"></i> Move to Archive
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="archiveModalBody">
                <!-- Content set by JS -->
            </div>
            <div class="modal-footer border-top bg-light" id="archiveModalFooter">
                <!-- Buttons set by JS -->
            </div>
        </div>
    </div>
</div>

<!-- Permanent Delete Custom Confirmation Modal -->
<div class="modal fade" id="permanentDeleteModal" tabindex="-1" aria-labelledby="permanentDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom" id="permDeleteModalHeader">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="permanentDeleteModalLabel">
                    <!-- Title set by JS -->
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="permDeleteModalBody">
                <!-- Content set by JS -->
            </div>
            <div class="modal-footer border-top bg-light" id="permDeleteModalFooter">
                <!-- Buttons set by JS -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var currentAssignTargetGroupId = null;

    function openAssignModal(groupId, groupName, groupCode) {
        currentAssignTargetGroupId = String(groupId);
        document.getElementById('assignGroupId').value = groupId;
        document.getElementById('assignModalLabel').innerHTML = 'Assign Staff &mdash; <span class="text-primary">' + groupName + '</span> <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">' + groupCode + '</span>';
        
        // Reset search
        document.getElementById('employeeSearchInput').value = '';
        
        // Initialize checkboxes based on each employee's current group
        var rows = document.querySelectorAll('#assignEmployeesTable .employee-row');
        rows.forEach(function(row) {
            row.style.display = '';
            var empGroupId = row.getAttribute('data-group-id');
            var chk = row.querySelector('.emp-checkbox');
            if (chk) {
                chk.checked = (empGroupId === currentAssignTargetGroupId);
            }
        });

        updateSelectionCount();
        var modal = new bootstrap.Modal(document.getElementById('assignEmployeesModal'));
        modal.show();
    }

    function updateSelectionCount() {
        var checked = document.querySelectorAll('#assignEmployeesTable .emp-checkbox:checked');
        var badge = document.getElementById('selectionCountBadge');
        if (badge) {
            badge.innerText = checked.length + ' selected';
        }
    }

    function filterEmployeeList() {
        var term = document.getElementById('employeeSearchInput').value.toLowerCase().trim();
        var rows = document.querySelectorAll('#assignEmployeesTable .employee-row');
        rows.forEach(function(row) {
            var text = row.getAttribute('data-search-text') || '';
            if (!term || text.indexOf(term) !== -1) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function selectAllVisible(check) {
        var rows = document.querySelectorAll('#assignEmployeesTable .employee-row');
        rows.forEach(function(row) {
            if (row.style.display !== 'none') {
                var chk = row.querySelector('.emp-checkbox');
                if (chk) chk.checked = check;
            }
        });
        updateSelectionCount();
    }

    function toggleMaster(master) {
        selectAllVisible(master.checked);
    }

    function openCreateModal() {
        document.getElementById('payGroupModalLabel').innerText = 'New Pay Group';
        document.getElementById('modalGroupId').value = '';
        document.getElementById('modalGroupName').value = '';
        document.getElementById('modalGroupCode').value = '';
        document.getElementById('modalGroupDesc').value = '';
        document.getElementById('modalGroupFrequency').value = 'Monthly';
        document.getElementById('modalGroupCutoff').value = '30';
        document.getElementById('modalGroupStatus').value = 'active';
        var modal = new bootstrap.Modal(document.getElementById('payGroupModal'));
        modal.show();
    }

    function openEditModal(id, name, code, desc, freq, cutoff, status) {
        document.getElementById('payGroupModalLabel').innerText = 'Edit Pay Group';
        document.getElementById('modalGroupId').value = id;
        document.getElementById('modalGroupName').value = name;
        document.getElementById('modalGroupCode').value = code;
        document.getElementById('modalGroupDesc').value = desc;
        document.getElementById('modalGroupFrequency').value = freq;
        document.getElementById('modalGroupCutoff').value = cutoff;
        document.getElementById('modalGroupStatus').value = status;
        var modal = new bootstrap.Modal(document.getElementById('payGroupModal'));
        modal.show();
    }

    function openArchiveModal(id, name, code, empCount) {
        var bodyEl = document.getElementById('archiveModalBody');
        var footerEl = document.getElementById('archiveModalFooter');
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        var token = tokenInput ? tokenInput.value : '';

        bodyEl.innerHTML = `
            <p class="mb-2">Are you sure you want to archive pay group <strong class="text-primary">${name}</strong> (<code>${code}</code>)?</p>
            ${empCount > 0 ? `<div class="alert alert-info py-2 px-3 small mb-2"><i class="bi bi-info-circle me-1"></i> Currently has <strong>${empCount} staff assigned</strong>. They will remain linked to this group.</div>` : ''}
            <p class="text-muted small mb-0">Archiving hides this pay group from active processing without deleting any historical payroll records. You can restore it at any time from the Archived tab.</p>
        `;

        footerEl.innerHTML = `
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <form method="post" action="?handler=Archive&id=${id}" class="d-inline">
                <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                <button type="submit" class="btn btn-warning text-dark px-3 fw-semibold">
                    <i class="bi bi-archive me-1"></i>Yes, Move to Archive
                </button>
            </form>
        `;

        var modal = new bootstrap.Modal(document.getElementById('archiveModal'));
        modal.show();
    }

    function openPermanentDeleteModal(id, name, code, empCount, runCount, hasRealRuns) {
        var headerEl = document.getElementById('permDeleteModalHeader');
        var titleEl = document.getElementById('permanentDeleteModalLabel');
        var bodyEl = document.getElementById('permDeleteModalBody');
        var footerEl = document.getElementById('permDeleteModalFooter');
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        var token = tokenInput ? tokenInput.value : '';

        headerEl.className = 'modal-header border-bottom';

        if (empCount > 0) {
            headerEl.classList.add('bg-warning-subtle', 'text-warning-emphasis');
            titleEl.innerHTML = '<i class="bi bi-shield-exclamation text-warning me-1"></i> Cannot Delete Pay Group';
            bodyEl.innerHTML = `
                <div class="alert alert-warning d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill fs-5 mt-1 text-warning flex-shrink-0"></i>
                    <div>
                        <strong class="d-block mb-1">Active Staff Assigned</strong>
                        <span><strong>${name}</strong> (${code}) currently has <strong>${empCount} employee(s)</strong> assigned to it.</span>
                    </div>
                </div>
                <p class="text-secondary small mb-0">
                    To maintain data integrity, please reassign all staff to another pay group before attempting permanent deletion.
                </p>
            `;
            footerEl.innerHTML = `
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
            `;
        } else if (hasRealRuns) {
            headerEl.classList.add('bg-warning-subtle', 'text-warning-emphasis');
            titleEl.innerHTML = '<i class="bi bi-shield-lock-fill text-warning me-1"></i> Protected Financial Audit Record';
            bodyEl.innerHTML = `
                <div class="alert alert-warning mb-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-info-circle-fill text-warning fs-5"></i>
                        <strong class="fs-6">Permanent Deletion Not Allowed</strong>
                    </div>
                    <p class="small mb-0">
                        <strong>${name}</strong> (${code}) has <strong>${runCount} historical payroll run(s)</strong> on record.
                    </p>
                </div>
                <p class="text-secondary small mb-2">
                    <strong>Why can't this be deleted?</strong><br />
                    Payroll runs are statutory financial audit records (salaries disbursed, tax calculations, PF/ESIC deductions, and bank transactions). Deleting this pay group would corrupt historical accounting records and audit trails.
                </p>
                <div class="p-2.5 px-3 bg-light border rounded small text-dark d-flex align-items-center gap-2 mt-3">
                    <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                    <span>This pay group is already safely <strong>Archived</strong>. It cannot be used for new payroll, but all past payslips and financial statements remain 100% auditable.</span>
                </div>
            `;
            footerEl.innerHTML = `
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Understood</button>
            `;
        } else {
            headerEl.classList.add('bg-danger-subtle', 'text-danger-emphasis');
            titleEl.innerHTML = '<i class="bi bi-trash3-fill text-danger me-1"></i> Confirm Permanent Deletion';
            bodyEl.innerHTML = `
                <p class="mb-3">Are you sure you want to permanently delete pay group <strong class="text-danger">${name}</strong> (<code>${code}</code>)?</p>
                <div class="alert alert-danger-subtle border border-danger-subtle text-danger-emphasis py-2 px-3 small rounded mb-0">
                    <i class="bi bi-exclamation-octagon-fill me-1"></i>
                    <strong>Warning:</strong> This pay group has no active staff and no payroll history. This action <strong>cannot be undone</strong>.
                </div>
            `;
            footerEl.innerHTML = `
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="?handler=PermanentDelete&id=${id}" class="d-inline">
                    <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash3-fill me-1"></i>Permanently Delete
                    </button>
                </form>
            `;
        }

        var modal = new bootstrap.Modal(document.getElementById('permanentDeleteModal'));
        modal.show();
    }

    @if (ViewData["ShowSaveModal"] as bool? == true)
    {
        <text>
        document.addEventListener("DOMContentLoaded", function() {
            var modalEl = document.getElementById('payGroupModal');
            if (modalEl) {
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        });
        </text>
    }
</script>
}
