@page
@model HRDesk.Web.Pages.WhatsApp.IndexModel
@{
    ViewData["Title"] = "WhatsApp Configuration";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h4 class="mb-0 text-primary"><i class="bi bi-whatsapp"></i> WhatsApp Integration</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted">Manage your HRDesk WhatsApp connection.</p>
                    
                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            @Model.Message
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="alert @(Model.WhatsAppStatus == "connected" ? "alert-success" : (Model.WhatsAppStatus == "qr_ready" ? "alert-warning" : "alert-secondary"))" role="alert">
                        <strong>Status:</strong>&nbsp;
                        @if (Model.WhatsAppStatus == "connected")
                        {
                            <span><i class="bi bi-check-circle-fill text-success me-1"></i>Connected &amp; Ready</span>
                        }
                        else if (Model.WhatsAppStatus == "qr_ready")
                        {
                            <span><i class="bi bi-qr-code me-1"></i>Awaiting QR Scan</span>
                        }
                        else if (Model.WhatsAppStatus == "initializing")
                        {
                            <span><span class="spinner-border spinner-border-sm me-2" role="status"></span>Initializing... (auto-refreshing)</span>
                        }
                        else if (Model.WhatsAppStatus == "disconnected")
                        {
                            <span><i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>Disconnected — Is the Node.js service running?</span>
                        }
                        else
                        {
                            <span>@Model.WhatsAppStatus</span>
                        }
                    </div>

                    @if (Model.WhatsAppStatus == "connected")
                    {
                        <div class="card border-success mt-4">
                            <div class="card-body">
                                <h5><i class="bi bi-check2-all text-success me-2"></i>Queue Status</h5>
                                <p>There are currently <strong>@Model.QueueLength</strong> messages in the outgoing queue.</p>
                                <p class="text-muted small">Messages are sent with a human-like delay to prevent blocks.</p>
                            </div>
                        </div>
                    }
                    else if (Model.WhatsAppStatus == "qr_ready" && !string.IsNullOrEmpty(Model.QrCodeData))
                    {
                        <div class="card mt-4 text-center p-4">
                            <h5>Scan to Link Device</h5>
                            <p class="text-muted">Open WhatsApp on your phone → <strong>Linked Devices</strong> → <strong>Link a Device</strong> → scan this QR code.</p>
                            <div class="d-flex justify-content-center my-3">
                                @* QR code is now a pre-rendered PNG from the Node.js service — no client-side library needed *@
                                <img src="@Model.QrCodeData" alt="WhatsApp QR Code" style="width:256px;height:256px;border:4px solid #e5e7eb;border-radius:12px;" />
                            </div>
                            <p class="small text-muted mt-2">This page refreshes every 3.5 seconds. The QR code expires after 60 seconds — a new one will appear automatically.</p>
                        </div>
                    }
                    else if (Model.WhatsAppStatus == "initializing")
                    {
                        <div class="card border-secondary mt-4 text-center p-4">
                            <div class="spinner-border text-secondary mx-auto mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                            <h5>Starting WhatsApp Session</h5>
                            <p class="text-muted mb-0">Connecting to WhatsApp servers... A QR code will appear shortly.</p>
                        </div>
                    }

                    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Unlinked Device or Stuck Status?</h6>
                            <p class="text-muted small mb-0">If you removed the device from WhatsApp on your phone, click Reset to generate a fresh QR code.</p>
                        </div>
                        <form method="post" asp-page-handler="ResetSession" onsubmit="return confirm('This will clear the stored WhatsApp session and generate a new QR code. Proceed?')">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-arrow-clockwise me-1"></i>Reset &amp; Relink Device
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.WhatsAppStatus == "initializing" || Model.WhatsAppStatus == "qr_ready")
    {
        <script>
            // Auto-refresh while waiting for QR or connection
            setTimeout(function () { window.location.reload(); }, 3500);
        </script>
    }
}
