@page "{pageNum:int?}"
@model HRDesk.Web.Pages.Attendance.RosterModel
@using HRDesk.Web.Models
@{
    ViewData["Title"] = "Shift Roster";
}

<div class="container-fluid px-0 pb-5">
    <!-- Header Section -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 mt-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h4 class="mb-0 fw-bold">Shift Roster</h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">
                    Weekly Schedule
                </span>
            </div>
            <p class="text-muted mb-0 small">Manage daily employee shift assignments, roster rotations, and week-offs.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#generateModal">
                <i class="bi bi-magic"></i>
                <span>Shift Generate</span>
            </button>
            <a asp-page="/Shifts/Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <i class="bi bi-clock-history"></i>
                <span>Manage Shifts</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Toolbar & Filter Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <!-- Filters Form -->
                <form method="get" class="d-flex flex-wrap gap-2 align-items-center flex-grow-1">
                    <input type="hidden" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                    <div class="input-group input-group-sm" style="max-width: 260px; min-width: 200px;">
                        <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="SearchQuery" class="form-control border-start-0" placeholder="Search employee..." value="@Model.SearchQuery">
                    </div>
                    <select name="DeptId" class="form-select form-select-sm" style="max-width: 200px; min-width: 160px;" onchange="this.form.submit()">
                        <option value="">All Departments</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id" selected="@(Model.DeptId == dept.Id)">@dept.DepartmentName</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-dark shadow-sm px-3">Filter</button>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery) || Model.DeptId.HasValue)
                    {
                        <a asp-page="./Roster" asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-secondary" title="Clear filters">
                            <i class="bi bi-x-lg me-1"></i>Reset
                        </a>
                    }
                </form>

                <!-- Week Navigator -->
                <div class="d-flex align-items-center gap-1 bg-body-tertiary p-1 rounded-3 border">
                    <a asp-page="./Roster" asp-route-StartDate="@Model.StartDate?.AddDays(-7).ToString("yyyy-MM-dd")" asp-route-SearchQuery="@Model.SearchQuery" asp-route-DeptId="@Model.DeptId" class="btn btn-sm btn-outline-secondary border-0" title="Previous Week">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <a asp-page="./Roster" asp-route-StartDate="" asp-route-SearchQuery="@Model.SearchQuery" asp-route-DeptId="@Model.DeptId" class="btn btn-sm btn-outline-primary border-0 fw-semibold px-2" title="Current Week">
                        Today
                    </a>
                    <div class="px-2 py-1 fw-bold text-nowrap small text-body-emphasis">
                        <i class="bi bi-calendar-event me-1 text-primary"></i>
                        @Model.StartDate?.ToString("dd MMM yyyy") &ndash; @Model.EndDate.ToString("dd MMM yyyy")
                    </div>
                    <a asp-page="./Roster" asp-route-StartDate="@Model.StartDate?.AddDays(7).ToString("yyyy-MM-dd")" asp-route-SearchQuery="@Model.SearchQuery" asp-route-DeptId="@Model.DeptId" class="btn btn-sm btn-outline-secondary border-0" title="Next Week">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>

            <!-- Status Legend -->
            <div class="d-flex flex-wrap align-items-center gap-3 mt-3 pt-2 border-top small text-muted">
                <span class="fw-semibold text-body-secondary me-1"><i class="bi bi-info-circle me-1"></i>Legend:</span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="badge rounded-pill bg-primary px-2">&nbsp;</span> Shift Assigned
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="badge rounded-pill bg-secondary px-2">&nbsp;</span> Week Off
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="badge rounded-pill bg-warning px-2">&nbsp;</span> On Leave
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="badge rounded-pill bg-body-tertiary border px-2">&nbsp;</span> Not Set
                </span>
                <span class="ms-auto text-muted fst-italic small">💡 Click any cell to quickly change shift or mark week off</span>
            </div>
        </div>
    </div>

    <!-- Roster Grid Card -->
    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="card-body p-0">
            @if (!Model.Employees.Any())
            {
                <div class="text-center py-5">
                    <div class="avatar-lg bg-body-tertiary text-muted rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                        <i class="bi bi-calendar-range fs-2"></i>
                    </div>
                    <h5 class="fw-bold mb-1">No Employees Found</h5>
                    <p class="text-muted small mb-3">There are no active employees matching your filter or no roster records.</p>
                    <button type="button" class="btn btn-primary btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#generateModal">
                        <i class="bi bi-magic me-1"></i>Generate Shift Roster
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive roster-container" style="max-height: 700px;">
                    <table class="table table-bordered mb-0 align-middle">
                        <thead class="table-header sticky-top" style="z-index: 10;">
                            <tr>
                                <th class="ps-4 sticky-col" style="min-width: 250px;">Employee</th>
                                @for (int i = 0; i < 7; i++)
                                {
                                    var date = Model.StartDate?.AddDays(i);
                                    var isToday = date == DateOnly.FromDateTime(DateTime.Now);
                                    <th class="text-center @(isToday ? "today-column" : "")" style="min-width: 140px;">
                                        <div class="small fw-normal text-muted">@date?.DayOfWeek</div>
                                        <div class="fw-bold @(isToday ? "text-primary" : "")">
                                            @date?.ToString("dd MMM")
                                            @if (isToday)
                                            {
                                                <span class="badge bg-primary rounded-pill ms-1" style="font-size: 0.65rem;">Today</span>
                                            }
                                        </div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model.Employees)
                            {
                                <tr>
                                    <td class="ps-4 sticky-col border-end">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm rounded-circle me-3 d-flex align-items-center justify-content-center fw-bold bg-primary-subtle text-primary" style="width: 38px; height: 38px; flex-shrink: 0;">
                                                @emp.EmployeeName.Substring(0, Math.Min(2, emp.EmployeeName.Length)).ToUpper()
                                            </div>
                                            <div class="overflow-hidden">
                                                <div class="fw-bold text-truncate" title="@emp.EmployeeName">
                                                    @emp.EmployeeName
                                                </div>
                                                <div class="text-muted small text-truncate">@(emp.Department?.DepartmentName ?? "No Dept")</div>
                                            </div>
                                        </div>
                                    </td>
                                    @for (int i = 0; i < 7; i++)
                                    {
                                        var date = (Model.StartDate ?? DateOnly.FromDateTime(DateTime.Today)).AddDays(i);
                                        var entry = Model.RosterEntries.FirstOrDefault(r => r.EmployeeId == emp.EmployeeId && r.RosterDate == date);
                                        <td class="p-2 text-center roster-cell" 
                                            data-emp-id="@emp.EmployeeId" 
                                            data-date="@date.ToString("yyyy-MM-dd")"
                                            data-current-shift="@entry?.ShiftId"
                                            data-is-weekoff="@(entry?.IsWeekOff ?? false)">
                                            
                                            @{
                                                var leave = Model.LeaveApplications.FirstOrDefault(l => l.EmployeeId == emp.EmployeeId && date >= l.StartDate && date <= l.EndDate);
                                                var attRecord = Model.DailyAttendanceRecords.FirstOrDefault(a => a.EmployeeId == emp.EmployeeId && a.RecordDate == date);
                                                bool isSandwichLeave = attRecord != null && !string.IsNullOrWhiteSpace(attRecord.Status) && 
                                                                       (attRecord.Status.Contains("PL") || attRecord.Status.Contains("SL") || attRecord.Status.Contains("CL") || attRecord.Status.Contains("EL"));
                                            }

                                            @if (leave != null || isSandwichLeave)
                                            {
                                                var leaveLabel = leave?.LeaveType?.Code ?? attRecord?.Status ?? "Leave";
                                                var dayType = leave?.DayType ?? "Full Day";
                                                
                                                <div class="p-2 bg-warning-subtle border border-warning text-warning-emphasis rounded-3 small cursor-pointer shadow-sm roster-slot" onclick="editCell(this)">
                                                    <div class="fw-bold"><i class="bi bi-person-slash me-1"></i>On Leave</div>
                                                    <div class="small text-truncate" style="font-size: 0.7rem;">@leaveLabel (@dayType)</div>
                                                </div>
                                            }
                                            else if (entry == null)
                                            {
                                                <div class="p-2 border border-dashed rounded-3 text-muted small cursor-pointer hover-slot roster-slot bg-body-tertiary" onclick="editCell(this)">
                                                    <span class="opacity-75"><i class="bi bi-plus-circle me-1"></i>Not Set</span>
                                                </div>
                                            }
                                            else if (entry.IsWeekOff)
                                            {
                                                <div class="p-2 bg-secondary-subtle border border-secondary text-secondary-emphasis rounded-3 small cursor-pointer fw-bold shadow-sm roster-slot" style="border-style: dashed !important;" onclick="editCell(this)">
                                                    <i class="bi bi-calendar-x me-1"></i>Week Off
                                                </div>
                                            }
                                            else
                                            {
                                                var bgColor = entry.Shift?.ColorCode ?? "#4f46e5";
                                                
                                                <div class="p-2 text-white rounded-3 small cursor-pointer shadow-sm roster-slot" style="background-color: @bgColor; border: 1px solid @bgColor;" onclick="editCell(this)">
                                                    <div class="fw-bold text-truncate" title="@entry.Shift?.ShiftName">@entry.Shift?.ShiftName</div>
                                                    <div class="small text-truncate" style="font-size: 0.75rem; opacity: 0.9;">@entry.Shift?.StartTime.ToString("hh:mm tt") - @entry.Shift?.EndTime.ToString("hh:mm tt")</div>
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Employees.Any())
                {
                    <div class="p-3 border-top">
                        <partial name="_Pagination" model="@(new PaginationViewModel { 
                            List = Model.Employees, 
                            QueryParams = new Dictionary<string, string?> {
                                { "StartDate", Model.StartDate?.ToString("yyyy-MM-dd") },
                                { "SearchQuery", Model.SearchQuery },
                                { "DeptId", Model.DeptId?.ToString() }
                            } 
                        })" />
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header border-bottom">
                <h6 class="modal-title fw-bold" id="modalTitle">Edit Shift</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="editEmpId" />
                <input type="hidden" id="editDate" />
                
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Select Shift</label>
                    <select id="editShiftId" class="form-select shadow-sm">
                        <option value="">-- No Shift --</option>
                        @foreach (var s in Model.Shifts)
                        {
                            <option value="@s.Id">@s.ShiftName (@s.StartTime.ToString("hh:mm tt"))</option>
                        }
                    </select>
                </div>
                
                <div class="form-check form-switch mb-3 p-2 bg-body-tertiary rounded border">
                    <input class="form-check-input ms-0 me-2" type="checkbox" id="editIsWeekOff">
                    <label class="form-check-label fw-semibold small" for="editIsWeekOff">Mark as Week Off</label>
                </div>
                
                <button type="button" class="btn btn-primary w-100 shadow-sm d-flex align-items-center justify-content-center gap-2" onclick="saveCell()">
                    <i class="bi bi-check-lg"></i>
                    <span>Save Change</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Generate Modal -->
<div class="modal fade" id="generateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="Generate">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-magic text-primary me-2"></i>Shift Generate
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-4">Select a date range and target employees to automatically assign default shifts and week-offs.</p>
                    <div class="row g-3">
                        <!-- Shift Type -->
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted mb-1">Shift Type <span class="text-danger">*</span></label>
                            <select name="newShiftId" id="generateShiftId" class="form-select shadow-sm" onchange="toggleMasterShiftOption()">
                                <option value="">Select Shift Type...</option>
                                @foreach (var s in Model.Shifts)
                                {
                                    <option value="@s.Id">@s.ShiftName (@s.StartTime.ToString("hh:mm tt"))</option>
                                }
                            </select>
                            <div class="form-text small">Leave empty to use each employee's assigned master shift.</div>
                        </div>

                        <!-- Department Filter -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted mb-1">Department</label>
                            <select id="filterDepartment" class="form-select shadow-sm" onchange="filterEmployeesByDept()">
                                <option value="">All Departments</option>
                                @foreach (var dept in Model.Employees.Select(e => e.Department?.DepartmentName).Where(d => d != null).Distinct().OrderBy(d => d))
                                {
                                    <option value="@dept">@dept</option>
                                }
                            </select>
                        </div>

                        <!-- Employee Multiselect Dropdown -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted mb-1">Target Employees <span class="text-danger">*</span></label>
                            <div class="dropdown w-100" id="employeeDropdown">
                                <button class="btn btn-outline-secondary w-100 text-start dropdown-toggle shadow-sm d-flex justify-content-between align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span id="selectedEmployeesLabel" class="text-truncate">Select Employee</span>
                                </button>
                                <div class="dropdown-menu w-100 p-2 shadow-lg" style="max-height: 250px; overflow-y: auto;">
                                    <div class="px-2 mb-2 d-flex justify-content-between border-bottom pb-2">
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="toggleAllCheckboxes(true)">Select All</button>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-danger" onclick="toggleAllCheckboxes(false)">Clear</button>
                                    </div>
                                    @foreach (var emp in Model.Employees.OrderBy(e => e.EmployeeName))
                                    {
                                        <div class="form-check px-4 py-1 emp-item" data-dept="@(emp.Department?.DepartmentName ?? "")">
                                            <input class="form-check-input employee-checkbox" type="checkbox" name="employeeIds" value="@emp.EmployeeId" id="emp_@emp.EmployeeId" onchange="updateSelectedLabel()">
                                            <label class="form-check-label small w-100 cursor-pointer" for="emp_@emp.EmployeeId">
                                                @emp.EmployeeName
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Options -->
                        <div class="col-12">
                            <div class="p-3 border rounded-3 bg-body-tertiary">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="updateMasterShift" id="updateMasterShift" value="true">
                                            <label class="form-check-label fw-semibold small" for="updateMasterShift">Update Master Shift permanently?</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6 border-start-md">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="overwrite" id="overwriteEntries" value="true">
                                            <label class="form-check-label fw-semibold text-danger small" for="overwriteEntries">Overwrite existing entries?</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Date Range -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted mb-1">From Date</label>
                            <input type="date" name="fromDate" class="form-control shadow-sm" required value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted mb-1">To Date</label>
                            <input type="date" name="toDate" class="form-control shadow-sm" required value="@DateTime.Now.AddMonths(1).AddDays(-DateTime.Now.Day).ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-magic me-1"></i>Generate Roster
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .roster-container { border-radius: 0; }
    .table-header th { background-color: var(--bg-surface); color: var(--text-main); font-weight: 600; border-bottom: 2px solid var(--border-color); padding: 0.75rem 0.5rem; }
    .sticky-col { position: sticky; left: 0; z-index: 5; background-color: var(--bg-surface) !important; }
    .roster-cell { min-width: 140px; vertical-align: middle; }
    .roster-slot { min-height: 52px; display: flex; flex-direction: column; justify-content: center; transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .roster-slot:hover { transform: translateY(-1px); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1) !important; }
    .hover-slot:hover { background-color: var(--bs-tertiary-bg); border-color: var(--primary-color) !important; }
    .today-column { background-color: rgba(79, 70, 229, 0.05); }
    .cursor-pointer { cursor: pointer; }
    @@media (min-width: 768px) {
        .border-start-md { border-left: 1px solid var(--border-color); }
    }
</style>

@section Scripts {
    <script>
        const editModal = new bootstrap.Modal(document.getElementById('editModal'));

        function editCell(element) {
            const td = element.closest('.roster-cell');
            const empId = td.dataset.empId;
            const date = td.dataset.date; // yyyy-mm-dd
            const shiftId = td.dataset.currentShift;
            const isWeekoff = td.dataset.isWeekoff === 'True';

            document.getElementById('editEmpId').value = empId;
            document.getElementById('editDate').value = date;
            document.getElementById('editShiftId').value = shiftId || "";
            document.getElementById('editIsWeekOff').checked = isWeekoff;
            
            // Format date for title (yyyy-mm-dd to dd/mm/yyyy)
            const parts = date.split('-');
            const displayDate = `${parts[2]}/${parts[1]}/${parts[0]}`;
            document.getElementById('modalTitle').innerText = 'Shift for ' + displayDate;
            
            editModal.show();
        }

        async function saveCell() {
            const empId = document.getElementById('editEmpId').value;
            const dateStr = document.getElementById('editDate').value;
            const shiftId = document.getElementById('editShiftId').value;
            const isWeekOff = document.getElementById('editIsWeekOff').checked;

            const formData = new FormData();
            formData.append('empId', empId);
            formData.append('dateStr', dateStr);
            if (shiftId) formData.append('shiftId', shiftId);
            formData.append('isWeekOff', isWeekOff);

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const response = await fetch('?handler=UpdateCell', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                }
            });

            if (response.ok) {
                location.reload();
            } else {
                alert('Error saving roster change.');
            }
        }

        function filterEmployeesByDept() {
            const dept = document.getElementById('filterDepartment').value;
            const items = document.querySelectorAll('.emp-item');
            
            items.forEach(item => {
                if (!dept || item.dataset.dept === dept) {
                    item.classList.remove('d-none');
                } else {
                    item.classList.add('d-none');
                }
            });
        }

        function toggleAllCheckboxes(checked) {
            const visibleCheckboxes = document.querySelectorAll('.emp-item:not(.d-none) .employee-checkbox');
            visibleCheckboxes.forEach(cb => cb.checked = checked);
            updateSelectedLabel();
        }

        function updateSelectedLabel() {
            const checkedBoxes = document.querySelectorAll('.employee-checkbox:checked');
            const label = document.getElementById('selectedEmployeesLabel');
            
            if (checkedBoxes.length === 0) {
                label.innerText = 'Select Employee';
            } else if (checkedBoxes.length === 1) {
                const empName = checkedBoxes[0].nextElementSibling.innerText.trim();
                label.innerText = empName;
            } else {
                label.innerText = checkedBoxes.length + ' Employees Selected';
            }
        }

        function toggleMasterShiftOption() {
            // Placeholder for custom master shift toggles if needed
        }

        document.addEventListener('DOMContentLoaded', function () {
            const dropdown = document.querySelector('#employeeDropdown .dropdown-menu');
            if (dropdown) {
                dropdown.addEventListener('click', function (e) {
                    e.stopPropagation();
                });
            }
        });
    </script>
}
