<!-- 3. Sync Date Range Modal -->
<div class="modal fade" id="syncRangeModal" tabindex="-1" aria-labelledby="syncRangeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="SyncRange" onsubmit="showLoading('Fetching Date Range Punches from TeamOffice Cloud...')">
                <div class="modal-header border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 bg-primary-subtle text-primary">
                            <i class="bi bi-calendar-range"></i>
                        </div>
                        <h5 class="modal-title fw-bold fs-6" id="syncRangeModalLabel">Sync Punches by Date Range</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Download all biometric punch records for a specific historical date range directly from TeamOffice Cloud:
                    </p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-semibold">From Date</label>
                            <input type="date" name="fromDate" value="@DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted text-uppercase fw-semibold">To Date</label>
                            <input type="date" name="toDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light-subtle px-4 py-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-4">Download & Sync</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 4. Map Biometric / HiveStaff Code Modal -->
<div class="modal fade" id="mapCodeModal" tabindex="-1" aria-labelledby="mapCodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="AddCodeMapping">
                <div class="modal-header border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 bg-primary-subtle text-primary">
                            <i class="bi bi-person-badge-fill fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold fs-6" id="mapCodeModalLabel">Map HiveStaff / Biometric Code</h5>
                            <div class="text-muted extra-small">Connect a TeamOffice/HiveStaff code to an HRDesk employee.</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label asp-for="NewBiometricCode" class="form-label small text-muted text-uppercase fw-semibold">HiveStaff / Biometric Code</label>
                        <input asp-for="NewBiometricCode" class="form-control font-monospace" placeholder="e.g. EMP#001 or EMP#040" required />
                        <div class="form-text extra-small">Exact code as it appears in TeamOffice / HiveStaff API (e.g. EMP#001).</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewMappingEmployeeId" class="form-label small text-muted text-uppercase fw-semibold">HRDesk Employee</label>
                        <select asp-for="NewMappingEmployeeId" class="form-select" required>
                            <option value="">-- Select Active Employee --</option>
                            @foreach (var emp in Model.ActiveEmployees)
                            {
                                <option value="@emp.EmployeeId">@emp.EmployeeName (#@emp.EmployeeId)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-2">
                        <label asp-for="NewMappingNotes" class="form-label small text-muted text-uppercase fw-semibold">Notes / Reference (Optional)</label>
                        <input asp-for="NewMappingNotes" class="form-control" placeholder="e.g. HiveStaff code for Sachin Mandal" />
                    </div>
                </div>
                <div class="modal-footer border-top bg-light-subtle px-4 py-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-4">Save Code Mapping</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .cursor-pointer { cursor: pointer; }
    .extra-small { font-size: 0.775rem; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
