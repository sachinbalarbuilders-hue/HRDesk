@page
@model HRDesk.Web.Pages.Masters.DeviceSettingsModel
@{
    ViewData["Title"] = "Biometric & Device Settings";
}

<div class="container-fluid pb-5">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 mt-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h4 class="mb-0 fw-bold">Biometric Terminals & Cloud Integrations</h4>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 small">
                    @Model.SyncMode Mode
                </span>
            </div>
            <p class="text-muted mb-0 small">Manage cloud REST API synchronization, hardware biometric terminals, and attendance polling.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Manual Sync Button -->
            <form method="post" asp-page-handler="SyncNow" class="d-inline" onsubmit="showLoading('Fetching Latest Punches from TeamOffice Cloud...')">
                <button type="submit" class="btn btn-success d-inline-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-cloud-arrow-down-fill"></i>
                    <span>Sync Punches Now</span>
                </button>
            </form>

            <button type="button" class="btn btn-outline-primary d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#syncRangeModal">
                <i class="bi bi-calendar-range"></i>
                <span>Sync Date Range</span>
            </button>

            <!-- Add Terminal / Integration Modal Trigger -->
            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addModal">
                <i class="bi bi-plus-lg"></i>
                <span>Add New Terminal</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.IsError ? "alert-danger border-danger-subtle" : "alert-success border-success-subtle") alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi @(Model.IsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") fs-5"></i>
            <div>@Model.Message</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-cpu fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Active Sync Mode</div>
                        <div class="fs-5 fw-bold text-body-emphasis">
                            @if (Model.SyncMode == "Local")
                            {
                                <span class="text-primary"><i class="bi bi-ethernet me-1"></i>Local Only (LAN)</span>
                            }
                            else
                            {
                                <span class="text-success"><i class="bi bi-cloud-arrow-down-fill me-1"></i>Cloud Only (API)</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-cloud-check fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">TeamOffice Cloud API</div>
                        <div class="fs-5 fw-bold text-success">Connected</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info-subtle text-info d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Last Cloud Sync</div>
                        <div class="small fw-semibold text-body-emphasis">@Model.LastSyncTime</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-warning-subtle text-warning d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-fingerprint fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Cloud Logs Imported</div>
                        <div class="fs-5 fw-bold text-body-emphasis">@Model.TotalCloudLogsCount Logs</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Unified Configured Terminals & Cloud Integrations Table -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-diagram-3 text-primary"></i>
                <h5 class="mb-0 fw-semibold fs-6">Configured Terminals & Integrations</h5>
            </div>
            <span class="text-muted extra-small font-monospace">Cursor: @Model.LastSyncedRecord</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small text-muted">
                    <tr>
                        <th class="ps-4 py-3" style="min-width: 220px;">Terminal / Provider</th>
                        <th style="min-width: 130px;">Type</th>
                        <th style="min-width: 180px;">Connection / Endpoint</th>
                        <th style="min-width: 140px;">Identifier / Unit</th>
                        <th style="min-width: 110px;">Frequency</th>
                        <th class="text-end pe-4" style="min-width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Row 1: TeamOffice Cloud API Integration -->
                    <tr class="table-success-subtle">
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle p-2 bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                    <i class="bi bi-cloud-arrow-down-fill fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-body-emphasis">TeamOffice Cloud API</div>
                                    <div class="text-muted extra-small">Automated HTTPS Background Sync</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-success text-white px-2 py-1">Cloud REST API</span>
                        </td>
                        <td>
                            <span class="badge font-monospace bg-body-tertiary text-body border px-2 py-1">
                                <i class="bi bi-globe me-1 text-success"></i>@Model.BaseUrl
                            </span>
                        </td>
                        <td>
                            <span class="text-muted extra-small">Corp:</span> <span class="fw-bold font-monospace small">@Model.CorporateId</span>
                            <span class="text-muted extra-small ms-1">(@Model.Username)</span>
                        </td>
                        <td>
                            <span class="badge bg-body-secondary text-body font-monospace px-2 py-1">
                                @Model.CloudSyncInterval min
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex align-items-center gap-1">
                                <!-- Test Cloud API -->
                                <form method="post" asp-page-handler="TestCloudApi" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success border-0 p-1 px-2" title="Test Cloud API Connection">
                                        <i class="bi bi-broadcast me-1"></i>Test
                                    </button>
                                </form>

                                <!-- Edit Cloud Config Modal Button -->
                                <button type="button" class="btn btn-sm btn-outline-primary border-0 p-1 px-2" data-bs-toggle="modal" data-bs-target="#editCloudModal" title="Edit Cloud API Settings">
                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                </button>

                                <!-- Delete Cloud Integration Button -->
                                <form method="post" asp-page-handler="DeleteCloudSettings" class="d-inline" onsubmit="return confirm('Are you sure you want to remove TeamOffice Cloud integration and reset credentials?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-1 px-2" title="Remove Cloud Integration">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>

                    <!-- Local Terminals Rows -->
                    @if (!Model.Devices.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <div class="small">No local hardware terminals configured. You can click <strong>Add New Terminal</strong> to add local LAN devices.</div>
                            </td>
                        </tr>
                    }
                    @foreach (var device in Model.Devices)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle p-2 bg-body-tertiary d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        <i class="bi bi-fingerprint text-primary fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-body-emphasis">@device.Name</div>
                                        <div class="text-muted extra-small">Local LAN Terminal</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">TCP Socket</span>
                            </td>
                            <td>
                                <span class="badge font-monospace bg-body-tertiary text-body border px-2 py-1">
                                    <i class="bi bi-ethernet me-1 text-primary"></i>@device.IpAddress:@device.Port
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                    Unit #@device.MachineNumber
                                </span>
                                <span class="text-muted font-monospace extra-small ms-1">Key: @(device.CommKey ?? 0)</span>
                            </td>
                            <td>
                                <span class="badge bg-body-secondary text-body font-monospace px-2 py-1">
                                    @Model.SyncIntervalMinutes min
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <!-- Test LAN Connection -->
                                    <form method="post" asp-page-handler="TestConnection" asp-route-id="@device.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-warning border-0 p-1 px-2" title="Test LAN Connection">
                                            <i class="bi bi-broadcast me-1"></i>Test
                                        </button>
                                    </form>

                                    <!-- Edit Button -->
                                    <button type="button" class="btn btn-sm btn-outline-primary border-0 p-1 px-2" data-bs-toggle="modal" data-bs-target="#editModal@(device.Id)" title="Edit Terminal">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </button>

                                    <!-- Delete Button -->
                                    <form method="post" asp-page-handler="DeleteDevice" asp-route-id="@device.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to remove terminal \'@device.Name\'?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-1 px-2" title="Remove Terminal">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>

                                <!-- Edit Local Terminal Modal -->
                                <div class="modal fade text-start" id="editModal@(device.Id)" tabindex="-1" aria-labelledby="editModalLabel@(device.Id)" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <form method="post" asp-page-handler="UpdateDevice">
                                                <input type="hidden" name="id" value="@device.Id" />
                                                <div class="modal-header border-bottom">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="rounded-circle p-2 bg-primary-subtle text-primary">
                                                            <i class="bi bi-sliders"></i>
                                                        </div>
                                                        <h5 class="modal-title fw-bold fs-6" id="editModalLabel@(device.Id)">Edit Terminal: @device.Name</h5>
                                                    </div>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    <div class="mb-3">
                                                        <label class="form-label small text-muted text-uppercase fw-semibold">Device Name</label>
                                                        <input type="text" name="name" value="@device.Name" class="form-control" placeholder="e.g. Main Reception" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small text-muted text-uppercase fw-semibold">IP Address</label>
                                                        <input type="text" name="ip" value="@device.IpAddress" class="form-control font-monospace" placeholder="e.g. 192.168.1.100" required />
                                                    </div>
                                                    <div class="row g-3 mb-3">
                                                        <div class="col-md-6">
                                                            <label class="form-label small text-muted text-uppercase fw-semibold">Port</label>
                                                            <input type="number" name="port" value="@device.Port" class="form-control" required />
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label small text-muted text-uppercase fw-semibold">Machine #</label>
                                                            <input type="number" name="machine" value="@device.MachineNumber" class="form-control" required />
                                                        </div>
                                                    </div>
                                                    <div class="row g-3 mb-3">
                                                        <div class="col-md-6">
                                                            <label class="form-label small text-muted text-uppercase fw-semibold">Comm Password (Key)</label>
                                                            <input type="number" name="commKey" value="@(device.CommKey ?? 0)" class="form-control" required />
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label small text-muted text-uppercase fw-semibold">LAN Polling (Mins)</label>
                                                            <input type="number" name="syncInterval" value="@Model.SyncIntervalMinutes" class="form-control" min="1" max="1440" required />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-top bg-light-subtle px-4 py-3">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-sm btn-primary px-4">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- HiveStaff & Biometric Code Mappings Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-badge text-primary"></i>
                <h5 class="mb-0 fw-semibold fs-6">HiveStaff & Biometric Code Mappings</h5>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0 extra-small">
                    @Model.CodeMappings.Count Mapped
                </span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#mapCodeModal">
                <i class="bi bi-plus-lg"></i>
                <span>Map Employee Code</span>
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small text-muted">
                    <tr>
                        <th class="ps-4 py-3" style="min-width: 180px;">HiveStaff / Machine Code</th>
                        <th style="min-width: 250px;">HRDesk Employee</th>
                        <th style="min-width: 200px;">Notes / Role</th>
                        <th class="text-end pe-4" style="min-width: 100px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.CodeMappings.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <div class="small">No custom biometric code mappings configured. System falls back to matching numerical IDs directly.</div>
                            </td>
                        </tr>
                    }
                    @foreach (var mapping in Model.CodeMappings)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-primary text-white font-monospace fs-6 px-3 py-1">
                                    <i class="bi bi-tag-fill me-1"></i>@mapping.BiometricCode
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle p-1 bg-body-tertiary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person text-secondary"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-body-emphasis">@mapping.EmployeeName</div>
                                        <div class="text-muted extra-small font-monospace">HRDesk ID: #@mapping.EmployeeId</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted small">@(string.IsNullOrEmpty(mapping.Notes) ? "—" : mapping.Notes)</span>
                            </td>
                            <td class="text-end pe-4">
                                <form method="post" asp-page-handler="DeleteCodeMapping" asp-route-id="@mapping.Id" class="d-inline" onsubmit="return confirm('Remove code mapping for \'@mapping.BiometricCode\'?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-1 px-2" title="Delete Mapping">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Fail-Safe Architecture Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-success fs-5"></i>
                <h5 class="mb-0 fw-semibold fs-6">Fail-Safe Dual-Sync Redundancy</h5>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">Protected Architecture</span>
        </div>
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-md-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle p-2 bg-success-subtle text-success mt-1">
                            <i class="bi bi-cloud-arrow-down-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-body-emphasis small">Cloud-to-Cloud Automation</div>
                            <div class="text-muted extra-small">Pulls biometric logs from TeamOffice Cloud every 5 minutes without needing an office PC.</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle p-2 bg-primary-subtle text-primary mt-1">
                            <i class="bi bi-ethernet"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-body-emphasis small">Local LAN Redundancy</div>
                            <div class="text-muted extra-small">If cloud internet drops, local service continues polling terminals over the office network.</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle p-2 bg-warning-subtle text-warning mt-1">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-body-emphasis small">Zero Duplicate Guarantee</div>
                            <div class="text-muted extra-small">Unique constraints on employee ID and punch time prevent duplicate log insertions.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODALS ================= -->

<!-- 1. Unified Add Modal (Local & Cloud Options) -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle p-2 bg-primary-subtle text-primary">
                        <i class="bi bi-plus-circle-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold fs-6" id="addModalLabel">Add Terminal or Cloud Integration</h5>
                        <div class="text-muted extra-small">Choose whether to configure a local network device or cloud API provider.</div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Nav Tabs -->
            <ul class="nav nav-tabs nav-fill px-4 pt-3 border-bottom bg-light-subtle" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold d-flex align-items-center justify-content-center gap-2 py-2" id="tab-local" data-bs-toggle="tab" data-bs-target="#pane-local" type="button" role="tab">
                        <i class="bi bi-hdd-network text-primary"></i>
                        <span>Local Hardware Terminal</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold d-flex align-items-center justify-content-center gap-2 py-2" id="tab-cloud" data-bs-toggle="tab" data-bs-target="#pane-cloud" type="button" role="tab">
                        <i class="bi bi-cloud-arrow-down-fill text-success"></i>
                        <span>TeamOffice Cloud API</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Tab Pane 1: Local Terminal -->
                <div class="tab-pane fade show active" id="pane-local" role="tabpanel">
                    <form method="post" asp-page-handler="AddDevice">
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label asp-for="NewDevice.Name" class="form-label small text-muted text-uppercase fw-semibold">Device Name</label>
                                <input asp-for="NewDevice.Name" class="form-control" placeholder="e.g. Main Gate Terminal" required />
                            </div>
                            <div class="mb-3">
                                <label asp-for="NewDevice.IpAddress" class="form-label small text-muted text-uppercase fw-semibold">IP Address</label>
                                <input asp-for="NewDevice.IpAddress" class="form-control font-monospace" placeholder="e.g. 192.168.1.201" required />
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="NewDevice.Port" class="form-label small text-muted text-uppercase fw-semibold">Port</label>
                                    <input asp-for="NewDevice.Port" class="form-control" value="5005" required />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NewDevice.MachineNumber" class="form-label small text-muted text-uppercase fw-semibold">Machine #</label>
                                    <input asp-for="NewDevice.MachineNumber" class="form-control" value="1" required />
                                </div>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="NewDevice.CommKey" class="form-label small text-muted text-uppercase fw-semibold">Comm Password (Key)</label>
                                    <input asp-for="NewDevice.CommKey" class="form-control" value="0" required />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="SyncIntervalMinutes" class="form-label small text-muted text-uppercase fw-semibold">LAN Polling (Mins)</label>
                                    <input asp-for="SyncIntervalMinutes" class="form-control" value="10" min="1" max="1440" required />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-top bg-light-subtle px-4 py-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-primary px-4">Add Local Terminal</button>
                        </div>
                    </form>
                </div>

                <!-- Tab Pane 2: Cloud API Setup -->
                <div class="tab-pane fade" id="pane-cloud" role="tabpanel">
                    <form method="post" asp-page-handler="SaveCloudSettings">
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label class="form-label small text-muted text-uppercase fw-semibold mb-2">Sync Operation Mode</label>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="card border p-2 text-center cursor-pointer @(Model.SyncMode == "Cloud" ? "border-success bg-success-subtle" : "")" for="mCloud">
                                            <input class="form-check-input mb-1" type="radio" asp-for="SyncMode" value="Cloud" id="mCloud" checked="@(Model.SyncMode == "Cloud")" />
                                            <span class="small fw-bold d-block"><i class="bi bi-cloud-arrow-down-fill text-success me-1"></i>Cloud Only (API)</span>
                                        </label>
                                    </div>
                                    <div class="col-6">
                                        <label class="card border p-2 text-center cursor-pointer @(Model.SyncMode == "Local" ? "border-primary bg-primary-subtle" : "")" for="mLocal">
                                            <input class="form-check-input mb-1" type="radio" asp-for="SyncMode" value="Local" id="mLocal" checked="@(Model.SyncMode == "Local")" />
                                            <span class="small fw-bold d-block"><i class="bi bi-ethernet text-primary me-1"></i>Local Only (LAN)</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="CorporateId" class="form-label small text-muted text-uppercase fw-semibold">Corporate ID</label>
                                    <input asp-for="CorporateId" class="form-control font-monospace" placeholder="e.g. Tbalar1121" required />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Username" class="form-label small text-muted text-uppercase fw-semibold">API Username</label>
                                    <input asp-for="Username" class="form-control font-monospace" placeholder="e.g. Tbalar1121" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label small text-muted text-uppercase fw-semibold">API Password</label>
                                    <input asp-for="Password" type="password" class="form-control font-monospace" placeholder="•••••••• (Leave blank to keep existing)" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CloudSyncInterval" class="form-label small text-muted text-uppercase fw-semibold">Sync Interval (Mins)</label>
                                    <input asp-for="CloudSyncInterval" type="number" class="form-control" min="1" max="1440" required />
                                </div>
                            </div>

                            <div class="mb-2">
                                <label asp-for="BaseUrl" class="form-label small text-muted text-uppercase fw-semibold">API Base URL</label>
                                <input asp-for="BaseUrl" class="form-control font-monospace" placeholder="https://api.etimeoffice.com/api" required />
                            </div>
                        </div>
                        <div class="modal-footer border-top bg-light-subtle px-4 py-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-success px-4">Save Cloud Configuration</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. Edit Cloud API Modal -->
