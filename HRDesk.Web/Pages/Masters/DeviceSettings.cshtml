@page
@model HRDesk.Web.Pages.Masters.DeviceSettingsModel
@{
    ViewData["Title"] = "Device Settings";
}

<div class="container-fluid pb-5">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 mt-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h4 class="mb-0 fw-bold">Biometric Devices</h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">
                    @Model.Devices.Count @(Model.Devices.Count == 1 ? "Device" : "Devices")
                </span>
            </div>
            <p class="text-muted mb-0 small">Manage biometric hardware terminals and automated attendance synchronization.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addDeviceModal">
                <i class="bi bi-plus-lg"></i>
                <span>Add Device</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.IsError ? "alert-danger border-danger-subtle" : "alert-success border-success-subtle") alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi @(Model.IsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") fs-5"></i>
            <div>@Model.Message</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-hdd-network fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Configured Terminals</div>
                        <div class="fs-4 fw-bold text-body-emphasis">@Model.Devices.Count</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-stopwatch fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Sync Frequency</div>
                        <div class="fs-4 fw-bold text-body-emphasis">Every @Model.SyncIntervalMinutes min</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-info-subtle text-info d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-ethernet fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Protocol</div>
                        <div class="fs-4 fw-bold text-body-emphasis">TCP / IP</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-warning-subtle text-warning d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Service Status</div>
                        <div class="fs-4 fw-bold text-body-emphasis">Active Polling</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Devices Table Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-semibold fs-6">Registered Devices</h5>
            <span class="text-muted small">Real-time attendance capture</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small text-muted">
                    <tr>
                        <th class="ps-4 py-3" style="min-width: 200px;">Device Name</th>
                        <th style="min-width: 160px;">IP Address</th>
                        <th style="min-width: 100px;">Port</th>
                        <th style="min-width: 120px;">Machine #</th>
                        <th style="min-width: 110px;">Comm Key</th>
                        <th class="text-end pe-4" style="min-width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Devices.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="mb-3">
                                    <i class="bi bi-hdd-network fs-1 text-secondary opacity-50"></i>
                                </div>
                                <h6 class="fw-semibold mb-1">No Biometric Devices Configured</h6>
                                <p class="small text-muted mb-3">Add your first biometric attendance terminal to enable automatic synchronization.</p>
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addDeviceModal">
                                    <i class="bi bi-plus-lg me-1"></i> Add Device
                                </button>
                            </td>
                        </tr>
                    }
                    @foreach (var device in Model.Devices)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle p-2 bg-body-tertiary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-fingerprint text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-body-emphasis">@device.Name</div>
                                        <div class="text-muted extra-small">ID: @device.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge font-monospace bg-body-tertiary text-body border px-2 py-1">
                                    <i class="bi bi-globe2 me-1 text-muted"></i>@device.IpAddress
                                </span>
                            </td>
                            <td>
                                <span class="fw-medium text-body-secondary">@device.Port</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                    Unit #@device.MachineNumber
                                </span>
                            </td>
                            <td>
                                <span class="text-muted font-monospace small">@device.CommKey</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <!-- Test Connection -->
                                    <form method="post" asp-page-handler="TestConnection" asp-route-id="@device.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-warning border-0 p-1 px-2" title="Test Connection">
                                            <i class="bi bi-broadcast me-1"></i>Test
                                        </button>
                                    </form>

                                    <!-- Edit Button -->
                                    <button type="button" class="btn btn-sm btn-outline-primary border-0 p-1 px-2" data-bs-toggle="modal" data-bs-target="#editModal@(device.Id)" title="Edit Configuration">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </button>

                                    <!-- Delete Button -->
                                    <form method="post" asp-page-handler="DeleteDevice" asp-route-id="@device.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to remove device \'@device.Name\'?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-1 px-2" title="Remove Device">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>

                                <!-- Edit Modal -->
                                <div class="modal fade text-start" id="editModal@(device.Id)" tabindex="-1" aria-labelledby="editModalLabel@(device.Id)" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <form method="post" asp-page-handler="UpdateDevice">
                                                <input type="hidden" name="id" value="@device.Id" />
                                                <div class="modal-header border-bottom">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="rounded-circle p-2 bg-primary-subtle text-primary">
                                                            <i class="bi bi-sliders"></i>
                                                        </div>
                                                        <h5 class="modal-title fw-bold fs-6" id="editModalLabel@(device.Id)">Edit Device Configuration</h5>
                                                    </div>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    <div class="mb-3">
                                                        <label class="form-label small text-muted text-uppercase fw-semibold">Device Name</label>
                                                        <input type="text" name="name" value="@device.Name" class="form-control" placeholder="e.g. Main Reception" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small text-muted text-uppercase fw-semibold">IP Address</label>
                                                        <input type="text" name="ip" value="@device.IpAddress" class="form-control font-monospace" placeholder="e.g. 192.168.1.100" required />
                                                    </div>
                                                    <div class="row g-3 mb-3">
                                                        <div class="col-md-6">
                                                            <label class="form-label small text-muted text-uppercase fw-semibold">Port</label>
                                                            <input type="number" name="port" value="@device.Port" class="form-control" required />
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label small text-muted text-uppercase fw-semibold">Machine #</label>
                                                            <input type="number" name="machine" value="@device.MachineNumber" class="form-control" required />
                                                        </div>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small text-muted text-uppercase fw-semibold">Communication Password (Comm Key)</label>
                                                        <input type="number" name="commKey" value="@device.CommKey" class="form-control" required />
                                                        <div class="form-text extra-small">Default is 0 if no password was configured on device.</div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-top bg-light-subtle px-4 py-3">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-sm btn-primary px-4">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Global Settings Row -->
    <div class="row g-4">
        <!-- Frequency Configuration -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-primary"></i>
                        <h5 class="mb-0 fw-semibold fs-6">Synchronization Settings</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-page-handler="UpdateSyncInterval">
                        <label asp-for="SyncIntervalMinutes" class="form-label small text-muted text-uppercase fw-semibold">
                            Sync Interval (Minutes)
                        </label>
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-body-tertiary border-end-0">
                                <i class="bi bi-stopwatch text-muted"></i>
                            </span>
                            <input asp-for="SyncIntervalMinutes" id="syncInput" type="number" class="form-control border-start-0" min="1" max="1440" required />
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check2 me-1"></i> Update
                            </button>
                        </div>

                        <!-- Preset Interval Buttons -->
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <span class="text-muted extra-small me-1">Quick presets:</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small" onclick="setPreset(2)">2m</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small" onclick="setPreset(5)">5m</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small" onclick="setPreset(10)">10m</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small" onclick="setPreset(15)">15m</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 extra-small" onclick="setPreset(30)">30m</button>
                        </div>

                        <div class="p-3 bg-body-tertiary rounded-3 text-muted small">
                            <i class="bi bi-info-circle me-1 text-primary"></i>
                            <strong>Recommended:</strong> 5–10 minutes. The Windows background service will immediately adapt to this schedule for real-time punch downloads.
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Service Information -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-info"></i>
                        <h5 class="mb-0 fw-semibold fs-6">How Synchronization Operates</h5>
                    </div>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <p class="text-muted small mb-3">
                        The background Windows service continuously monitors all registered biometric hardware over your local network:
                    </p>

                    <div class="d-flex flex-column gap-2 mb-3">
                        <div class="d-flex align-items-start gap-2 text-muted small">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <div><strong>Automatic Retrieval:</strong> Connects to each terminal and downloads new biometric punches into <code>attendance_logs</code>.</div>
                        </div>
                        <div class="d-flex align-items-start gap-2 text-muted small">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <div><strong>Network Resilient:</strong> Automatically retries if any device goes offline temporarily without halting others.</div>
                        </div>
                        <div class="d-flex align-items-start gap-2 text-muted small">
                            <i class="bi bi-check-circle-fill text-success mt-1"></i>
                            <div><strong>Optimized Polling:</strong> Lower intervals provide instant punch visibility while higher intervals conserve device battery and network bandwidth.</div>
                        </div>
                    </div>

                    <div class="border-top pt-3 d-flex align-items-center justify-content-between">
                        <span class="text-muted extra-small">Automated Attendance Engine</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Operational</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Device Modal -->
<div class="modal fade" id="addDeviceModal" tabindex="-1" aria-labelledby="addDeviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="AddDevice">
                <div class="modal-header border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 bg-primary-subtle text-primary">
                            <i class="bi bi-plus-circle"></i>
                        </div>
                        <h5 class="modal-title fw-bold fs-6" id="addDeviceModalLabel">Add New Biometric Device</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label asp-for="NewDevice.Name" class="form-label small text-muted text-uppercase fw-semibold">Device Name</label>
                        <input asp-for="NewDevice.Name" class="form-control" placeholder="e.g. Main Gate Terminal" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewDevice.IpAddress" class="form-label small text-muted text-uppercase fw-semibold">IP Address</label>
                        <input asp-for="NewDevice.IpAddress" class="form-control font-monospace" placeholder="e.g. 192.168.1.201" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="NewDevice.Port" class="form-label small text-muted text-uppercase fw-semibold">Port</label>
                            <input asp-for="NewDevice.Port" class="form-control" value="4370" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewDevice.MachineNumber" class="form-label small text-muted text-uppercase fw-semibold">Machine #</label>
                            <input asp-for="NewDevice.MachineNumber" class="form-control" value="1" required />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label asp-for="NewDevice.CommKey" class="form-label small text-muted text-uppercase fw-semibold">Communication Password (Comm Key)</label>
                        <input asp-for="NewDevice.CommKey" class="form-control" value="0" required />
                        <div class="form-text extra-small">Default is 0 if no password was configured on device.</div>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light-subtle px-4 py-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-4">Add Device</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setPreset(mins) {
        document.getElementById('syncInput').value = mins;
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
