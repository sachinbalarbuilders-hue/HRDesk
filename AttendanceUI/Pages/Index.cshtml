@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <!-- Total Employees -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-stat h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted fw-semibold">Total Employees</span>
                    <div class="stat-icon bg-soft-primary">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <h2 class="mb-1 fw-bold text-dark">@Model.TotalEmployees</h2>
                <small class="text-success"><i class="bi bi-arrow-up-short"></i> Active</small>
            </div>
        </div>
    </div>

    <!-- Present Today -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-stat h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted fw-semibold">Present Today</span>
                    <div class="stat-icon bg-soft-success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
                <h2 class="mb-1 fw-bold text-dark">@Model.PresentToday</h2>
                <small class="text-muted">@DateTime.Now.ToString("dd MMM yyyy")</small>
            </div>
        </div>
    </div>

    <!-- On Leave Today -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-stat h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted fw-semibold">On Leave Today</span>
                    <div class="stat-icon bg-soft-warning">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                </div>
                <h2 class="mb-1 fw-bold text-dark">@Model.OnLeaveToday</h2>
                <a asp-page="/Leaves/Applications/Index" class="small text-primary text-decoration-none stretched-link">View Details <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <!-- Late Arrivals -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-stat h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted fw-semibold">Late Arrivals Today</span>
                    <div class="stat-icon bg-soft-danger text-danger">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
                <h2 class="mb-1 fw-bold text-dark">@Model.LateToday</h2>
                <a asp-page="/AttendanceLogs/Index" class="small text-primary text-decoration-none stretched-link">View Logs <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-broadcast me-2 text-primary"></i>Machine Connectivity Status</h5>
                    <p class="text-muted small mb-0">Monitor real-time health and last synchronization of biometric devices</p>
                </div>
                <div class="text-end">
                    <span class="badge rounded-pill bg-light text-muted border py-2 px-3">
                        <i class="bi bi-clock-history me-1"></i> Auto-updates every sync
                    </span>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    @foreach (var machine in Model.MachineStatuses)
                    {
                        <div class="col">
                            <div class="p-3 border rounded-3 device-card bg-light bg-opacity-10">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center">
                                        <span class="status-indicator @machine.StatusClass" id="indicator-@machine.Id"></span>
                                        <span class="fw-bold text-dark">@machine.Name</span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-primary p-0 text-decoration-none" 
                                            onclick="checkMachineStatus(@machine.Id, this)" title="Verify Connection">
                                        <i class="bi bi-arrow-clockwise"></i> Verify
                                    </button>
                                </div>
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-pc-display me-1"></i> IP: @machine.IpAddress
                                </div>
                                <div class="sync-time-text @(machine.LastSync.HasValue ? "" : "text-danger")" id="sync-@machine.Id">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-cloud-check me-1"></i> 
                                        @if (machine.LastSync.HasValue)
                                        {
                                            var diff = DateTime.Now - machine.LastSync.Value;
                                            if (diff.TotalMinutes < 1) { <span>Just now</span> }
                                            else if (diff.TotalMinutes < 60) { <span>@( (int)diff.TotalMinutes) min ago</span> }
                                            else if (diff.TotalHours < 24) { <span>@( (int)diff.TotalHours) hours ago</span> }
                                            else { <span>@machine.LastSync.Value.ToString("dd MMM, hh:mm tt")</span> }
                                        }
                                        else
                                        {
                                            <span>Never synchronized</span>
                                        }
                                        </span>
                                        @if (machine.RecordsSynced > 0)
                                        {
                                            <span class="badge bg-soft-info text-info small">@machine.RecordsSynced records</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
</div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="fw-bold mb-1 text-dark d-flex align-items-center">
                        <div class="bg-soft-danger text-danger rounded p-2 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                            🎉
                        </div>
                        Team Celebrations
                    </h5>
                </div>
                <div class="text-end">
                    <button class="btn btn-dark btn-sm rounded-circle me-1" onclick="scrollCeleb(-300)"><i class="bi bi-chevron-left"></i></button>
                    <button class="btn btn-dark btn-sm rounded-circle" onclick="scrollCeleb(300)"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
            <div class="card-body p-4">
                @if (Model.Celebrations.Any())
                {
                    <div class="d-flex gap-4 overflow-hidden scroll-smooth pb-3" id="celeb-container" style="overflow-x: auto !important; scroll-snap-type: x mandatory;">
                        @foreach (var celeb in Model.Celebrations)
                        {
                            bool isBirthday = celeb.Type == "Birthday";
                            string bgClass = isBirthday ? "bg-gradient-birthday" : "bg-gradient-anniversary";
                            string badgeClass = isBirthday ? "bg-danger" : "bg-success";
                            string icon = isBirthday ? "bi-cake2" : "bi-award";
                            string message = isBirthday 
                                ? "Many, Many Happy returns of the day! Our entire Balar Builders family wishes you the best on your special day! 🎂" 
                                : "Congratulations on your work anniversary! Today is a special day to celebrate your hard work and dedication. We truly appreciate everything you do! 🏆";
                            string daysLeftText = celeb.DaysLeft == 0 ? "Today" : (celeb.DaysLeft == 1 ? "1 day left" : $"{celeb.DaysLeft} days left");
                            string daysLeftBg = celeb.DaysLeft == 0 ? "bg-success" : (isBirthday ? "bg-warning text-dark" : "bg-success");
                            if(celeb.DaysLeft != 0 && isBirthday) daysLeftBg = "bg-danger";

                            string waMessage = Uri.EscapeDataString(isBirthday 
                                ? $"🎉 Many, Many Happy returns of the day, {celeb.EmployeeName}! Our entire Balar Builders family wishes you a very Happy Birthday & wishes you the best on your special day! 🎂✨"
                                : $"🏆 Congratulations, {celeb.EmployeeName} on your work anniversary! It's a special day to celebrate your great work & dedication to your job over the year. We appreciate all that you have done & wish you all the best for many more Successful years to come! 🌟");

                            <div id="celeb-card-@celeb.EmployeeName.Replace(" ", "-")-@celeb.Type.Replace(" ", "-")" class="card border shadow-sm rounded-4 flex-shrink-0" style="width: 300px; scroll-snap-align: start; background-color: #fff;">
                                <div class="@bgClass rounded-top-4 position-relative" style="height: 100px;">
                                    <div class="position-absolute top-0 end-0 p-3 text-white opacity-50">
                                        <i class="bi @icon fs-4"></i>
                                    </div>
                                </div>
                                <div class="position-relative text-center" style="margin-top: -40px;">
                                    <div class="bg-white rounded-circle mx-auto shadow-sm" style="width: 80px; height: 80px; line-height: 72px; text-align: center; border: 4px solid @(isBirthday ? "#ff4081" : "#00c853");">
                                        <h3 class="mb-0 fw-bold text-dark d-inline-block" style="vertical-align: middle;">@celeb.Initials</h3>
                                    </div>
                                </div>
                                <div class="card-body text-center pt-2">
                                    <h5 class="fw-bold mb-2">@celeb.EmployeeName</h5>
                                    <span class="badge rounded-pill @badgeClass px-3 py-2 mb-3"><i class="bi @icon me-1"></i> @celeb.Type</span>
                                    <p class="text-muted small mb-3 px-2" style="min-height: 45px;">@message</p>
                                    
                                    <hr class="text-muted opacity-25 mb-3 mt-1" data-html2canvas-ignore="true">
                                    <div class="d-flex justify-content-between align-items-center mb-3" data-html2canvas-ignore="true">
                                        <div class="text-start">
                                            <small class="text-muted d-block" style="font-size: 0.75rem;">Date</small>
                                        </div>
                                        <div class="text-center">
                                            <span class="fw-semibold text-dark small">@celeb.CelebrationDate.ToString("dd MMM yyyy")</span>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge rounded-pill @daysLeftBg">@(celeb.DaysLeft == 0 ? "🎉 " : "")@daysLeftText</span>
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex mt-2" data-html2canvas-ignore="true">
                                        <button onclick="openShareModal('celeb-card-@celeb.EmployeeName.Replace(" ", "-")-@celeb.Type.Replace(" ", "-")', `@waMessage`)" class="btn btn-sm btn-success w-100 rounded-pill fw-bold shadow-sm" style="background-color: #25D366; border-color: #25D366;" title="Share Image & Text">
                                            <i class="bi bi-whatsapp me-1"></i> Share to WhatsApp
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                        <p>No upcoming celebrations found.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-page="/Attendance/Process" class="btn btn-outline-primary">
                        <i class="bi bi-gear me-2"></i> Process Attendance
                    </a>
                    <a asp-page="/Payroll/Process" class="btn btn-outline-success">
                        <i class="bi bi-cash-stack me-2"></i> Process Payroll
                    </a>
                    <a asp-page="/Employees/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-person-plus me-2"></i> Manage Employees
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    
    <!-- Share Modal -->
    <div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="shareModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold" id="shareModalLabel"><i class="bi bi-whatsapp text-success me-2"></i>Share Celebration</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-3">
                    <p class="text-muted small mb-3">Customize your message before sending it to the WhatsApp group. The image template will be generated and copied automatically.</p>
                    <div class="form-floating mb-3">
                        <textarea class="form-control" placeholder="Leave a message here" id="shareMessageText" style="height: 120px"></textarea>
                        <label for="shareMessageText">WhatsApp Message</label>
                    </div>
                    <input type="hidden" id="shareElementId" />
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success rounded-pill fw-bold" id="confirmShareBtn" onclick="executeShare()">
                        <i class="bi bi-send me-1"></i> Share to WhatsApp
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openShareModal(elementId, rawText) {
            document.getElementById('shareElementId').value = elementId;
            document.getElementById('shareMessageText').value = decodeURIComponent(rawText);
            const modal = new bootstrap.Modal(document.getElementById('shareModal'));
            modal.show();
        }

        async function executeShare() {
            const btn = document.getElementById('confirmShareBtn');
            const elementId = document.getElementById('shareElementId').value;
            const customText = document.getElementById('shareMessageText').value;
            const encodedText = encodeURIComponent(customText);
            
            const el = document.getElementById(elementId);
            if (!el) return;
            
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-hourglass-split bi-spin me-1"></i> Generating Image...';
            btn.disabled = true;

            try {
                const canvas = await html2canvas(el, { 
                    scale: 3, 
                    backgroundColor: '#ffffff',
                    useCORS: true
                });
                
                canvas.toBlob(async (blob) => {
                    const file = new File([blob], "celebration.png", { type: "image/png" });
                    
                    // Try Mobile Native Share
                    if (navigator.canShare && navigator.canShare({ files: [file] })) {
                        try {
                            await navigator.share({
                                files: [file],
                                title: 'Celebration',
                                text: customText
                            });
                            closeModalAndReset(btn, originalHtml);
                            return; 
                        } catch (err) {
                            console.log("Native share cancelled or failed", err);
                        }
                    }
                    
                    // Desktop Strategy (To support WhatsApp Image Captions)
                    try {
                        // 1. Copy the custom text to the clipboard
                        await navigator.clipboard.writeText(customText);
                        
                        // 2. Download the image automatically
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `Celebration-Template.png`;
                        a.click();
                        
                        alert("✅ Text copied to your clipboard!\n\nTo send as a single message with a caption:\n1. Drag the downloaded image into your WhatsApp group.\n2. Press Ctrl+V to paste the text into the caption box!\n3. Hit Send!");
                        
                        // We don't automatically open the URL with text because it conflicts with the caption workflow
                    } catch (err) {
                        console.error("Desktop share failed", err);
                        alert("Failed to copy text. You can manually copy the text and download the template.");
                    }
                    
                    closeModalAndReset(btn, originalHtml);
                }, 'image/png');
                
            } catch (err) {
                console.error("Error generating image template", err);
                alert("Failed to prepare share.");
                closeModalAndReset(btn, originalHtml);
            }
        }

        function closeModalAndReset(btn, originalHtml) {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
            const modalEl = document.getElementById('shareModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if(modalInstance) {
                modalInstance.hide();
            }
        }

        function scrollCeleb(amount) {
            const container = document.getElementById('celeb-container');
            if(container) {
                container.scrollBy({ left: amount, behavior: 'smooth' });
            }
        }

        async function checkMachineStatus(id, btn, silent = false) {
            const icon = btn.querySelector('i');
            const indicator = document.getElementById(`indicator-${id}`);
            
            if (icon) icon.classList.add('bi-spin');
            if (btn) btn.disabled = true;

            try {
                const response = await fetch(`?handler=CheckConnection&id=${id}`);
                const result = await response.json();
                
                if (result.success) {
                    indicator.className = 'status-indicator status-online status-pulse';
                    if (!silent) alert(`Success: ${result.message}`);
                } else {
                    indicator.className = 'status-indicator status-offline';
                    if (!silent) alert(`Failed: ${result.message}`);
                }
            } catch (error) {
                console.error('Error checking status:', error);
                if (!silent) alert('An error occurred while checking connection.');
            } finally {
                if (icon) icon.classList.remove('bi-spin');
                if (btn) btn.disabled = false;
            }
        }

        // Auto-check on load
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('[onclick^="checkMachineStatus"]').forEach(btn => {
                const onclick = btn.getAttribute('onclick');
                const id = onclick.match(/\d+/)[0];
                checkMachineStatus(id, btn, true);
            });
        });
    </script>
    <style>
        .bg-gradient-anniversary {
            background: linear-gradient(135deg, #00e676, #00b0ff);
        }
        .bg-gradient-birthday {
            background: linear-gradient(135deg, #ff9100, #ff1744);
        }
        .scroll-smooth {
            scroll-behavior: smooth;
        }
        #celeb-container::-webkit-scrollbar {
            display: none;
        }
        #celeb-container {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .bi-spin {
            display: inline-block;
            animation: spin 1s linear infinite;
        }
    </style>
}
