@page
@model AttendanceUI.Pages.Regularizations.CreateModel

@{
    ViewData["Title"] = "New Regularization Request";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-soft-primary stat-icon me-3">
                            <i class="bi bi-plus-circle"></i>
                        </div>
                        <div>
                            <h4 class="mb-0">New Regularization Request</h4>
                            <p class="text-muted small mb-0">Create a new request to regularize attendance records.</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger soft-alert mb-4" role="alert"></div>
                        
                        <div class="row g-3">
                            <!-- Employee Selection -->
                            <div class="col-12">
                                <label asp-for="Regularization.EmployeeId" class="form-label fw-medium">
                                    <i class="bi bi-person me-1"></i> Employee
                                </label>
                                <select asp-for="Regularization.EmployeeId" class="form-select select-modern" asp-items="ViewBag.EmployeeId"></select>
                                <span asp-validation-for="Regularization.EmployeeId" class="text-danger small"></span>
                            </div>

                            <!-- Request Type -->
                            <div class="col-md-6">
                                <label asp-for="Regularization.RequestType" class="form-label fw-medium">
                                    <i class="bi bi-tag me-1"></i> Request Type
                                </label>
                                <select asp-for="Regularization.RequestType" class="form-select select-modern" id="Regularization_RequestType">
                                    <option value="Late Coming">Late Coming</option>
                                    <option value="Early Go">Early Go</option>
                                    <option value="Missed Punch">Missed Punch</option>
                                </select>
                                <span asp-validation-for="Regularization.RequestType" class="text-danger small"></span>
                            </div>

                            <!-- Waive Penalty -->
                            <div class="col-12" id="waivePenaltyGroup">
                                <div class="px-3 py-2 bg-light rounded-3 border">
                                    <div class="form-check form-switch d-flex justify-content-between align-items-center p-0">
                                        <label class="form-check-label fw-medium" for="waivePenalty">
                                            <i class="bi bi-shield-check me-1"></i> Waive Attendance Penalty
                                        </label>
                                        <input class="form-check-input ms-2" type="checkbox" role="switch" id="waivePenalty" asp-for="Regularization.WaivePenalty" checked>
                                    </div>
                                    <div class="form-text text-muted small">
                                        If unchecked, the request is recorded for tracking but penalties (like Half Day for lateness) will still apply.
                                    </div>
                                </div>
                            </div>

                            <!-- Application Number -->
                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-medium mb-0">
                                            <i class="bi bi-hash me-1"></i> Application Number
                                        </label>
                                        <div class="form-check form-switch small">
                                            <input class="form-check-input" type="checkbox" id="autoAppNo" asp-for="AutoGenerate">
                                            <label class="form-check-label" for="autoAppNo">Auto-generate</label>
                                        </div>
                                    </div>
                                    <div class="input-group">
                                        <input asp-for="Regularization.ApplicationNumber" class="form-control" readonly id="ApplicationNumber" value="@ViewData["NextAppNo"]" />
                                        <span class="input-group-text bg-white text-muted small" id="appNoLoading" style="display:none;">
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span> Loading...
                                        </span>
                                    </div>
                                    <div class="form-text text-muted small mt-1">
                                        Tracking number for this application. Leave blank if not required.
                                    </div>
                                </div>
                            </div>

                            <!-- Request Entries -->
                            <div class="col-12 mt-2">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <label class="form-label fw-medium mb-0 fs-5 text-primary">
                                        <i class="bi bi-calendar-range me-1"></i> Request Dates & Details
                                    </label>
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-medium" id="btnAddDate">
                                        <i class="bi bi-plus-lg me-1"></i>Add Another Date
                                    </button>
                                </div>
                                <div id="requestEntriesContainer" class="d-flex flex-column gap-3">
                                    <!-- Dynamic rows go here -->
                                </div>
                            </div>

                            <!-- Reason -->
                            <div class="col-12">
                                <label asp-for="Regularization.Reason" class="form-label fw-medium">
                                    <i class="bi bi-chat-left-text me-1"></i> Reason / Remarks
                                </label>
                                <textarea asp-for="Regularization.Reason" class="form-control" rows="4" placeholder="Briefly explain the reason for this request..."></textarea>
                                <span asp-validation-for="Regularization.Reason" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4 py-2">
                                <i class="bi bi-check-circle"></i> Submit Request
                            </button>
                            <a asp-page="Index" class="btn btn-light d-flex align-items-center gap-2 px-4 py-2 text-dark">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .select-modern { background-color: #fff; }
    .border-dashed { border-style: dashed !important; }
    .soft-alert { background-color: #fee2e2; border: none; color: #991b1b; border-radius: 0.5rem; }
    .bg-soft-warning { background-color: #fef3c7; }
    .bg-soft-primary { background-color: #e0e7ff; }
</style>

<template id="requestRowTemplate">
    <div class="request-entry p-3 bg-white border rounded-3 position-relative mb-3 shadow-sm" data-index="{index}">
        <button type="button" class="btn-close position-absolute top-0 end-0 m-2 btn-remove-row" aria-label="Close" style="display:none;"></button>
        
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-medium"><i class="bi bi-calendar3 me-1"></i> Date</label>
                <input name="Requests[{index}].RequestDate" class="form-control request-date" type="date" value="{today}" required />
            </div>
            
            <div class="col-12 punch-status-group" style="display:none;">
                <div class="card border border-primary bg-light border-dashed">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 text-primary fw-bold">Current Machine Punches</h6>
                            <span class="badge bg-soft-primary text-primary px-2 py-1 shift-info">Shift: --:-- - --:--</span>
                        </div>
                        <div class="row g-2 text-center">
                            <div class="col-6">
                                <div class="p-2 border rounded bg-white">
                                    <div class="text-muted small">Clock In</div>
                                    <div class="fw-bold status-in-time">--:--</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border rounded bg-white">
                                    <div class="text-muted small">Clock Out</div>
                                    <div class="fw-bold status-out-time">--:--</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 punch-location-group" style="display:none;">
                <label class="form-label fw-medium">What needs to be filled?</label>
                <div class="d-flex flex-wrap gap-3 p-3 bg-light rounded-3 border">
                    <div class="form-check">
                        <input class="form-check-input target-in" type="radio" name="Requests[{index}].PunchTarget" id="targetIn_{index}" value="in" checked>
                        <label class="form-check-label" for="targetIn_{index}">Punch In Only</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input target-out" type="radio" name="Requests[{index}].PunchTarget" id="targetOut_{index}" value="out">
                        <label class="form-check-label" for="targetOut_{index}">Punch Out Only</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input target-both" type="radio" name="Requests[{index}].PunchTarget" id="targetBoth_{index}" value="both">
                        <label class="form-check-label" for="targetBoth_{index}">Both (Full Day)</label>
                    </div>
                </div>
            </div>

            <div class="col-md-6 punch-in-time-group" style="display:none;">
                <div class="p-3 bg-soft-warning rounded-3 border border-warning border-dashed h-100">
                    <label class="form-label fw-medium text-dark"><i class="bi bi-box-arrow-in-right me-1"></i> Punch IN Time</label>
                    <input name="Requests[{index}].PunchTimeIn" class="form-control punch-in-time" type="datetime-local" />
                </div>
            </div>

            <div class="col-md-6 punch-out-time-group" style="display:none;">
                <div class="p-3 bg-soft-warning rounded-3 border border-warning border-dashed h-100">
                    <label class="form-label fw-medium text-dark"><i class="bi bi-box-arrow-left me-1"></i> Punch OUT Time</label>
                    <input name="Requests[{index}].PunchTimeOut" class="form-control punch-out-time" type="datetime-local" />
                </div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            var rowCount = 0;

            function getTodayDateString() {
                var today = new Date();
                var dd = String(today.getDate()).padStart(2, '0');
                var mm = String(today.getMonth() + 1).padStart(2, '0');
                var yyyy = today.getFullYear();
                return yyyy + '-' + mm + '-' + dd;
            }

            function formatDateTimeForInput(dateStr, timeStr) {
                if (!dateStr || !timeStr) return "";
                return dateStr + "T" + timeStr;
            }

            function addRow() {
                var template = $("#requestRowTemplate").html();
                var html = template.replace(/\{index\}/g, rowCount).replace(/\{today\}/g, getTodayDateString());
                $("#requestEntriesContainer").append(html);
                
                var $newRow = $("#requestEntriesContainer .request-entry[data-index='" + rowCount + "']");
                rowCount++;
                
                updateRemoveButtons();
                updateVisibilityForType();
                fetchPunchesForRow($newRow);

                $newRow.find(".request-date").change(function() {
                    fetchPunchesForRow($newRow);
                    if ($newRow.index() === 0) {
                        updateAppNo();
                    }
                });

                $newRow.find("input[type='radio']").change(function() {
                    updateVisibilityForRow($newRow);
                });
                
                if (rowCount === 1) {
                    updateAppNo();
                }
            }

            function updateRemoveButtons() {
                var rows = $(".request-entry");
                if (rows.length > 1) {
                    rows.find(".btn-remove-row").show();
                } else {
                    rows.find(".btn-remove-row").hide();
                }
            }

            $(document).on("click", ".btn-remove-row", function() {
                $(this).closest(".request-entry").remove();
                updateRemoveButtons();
            });

            $("#btnAddDate").click(addRow);

            function updateVisibilityForType() {
                var type = $("#Regularization_RequestType").val();
                if (type === "Missed Punch") {
                    $("#waivePenaltyGroup").hide();
                    $("#waivePenalty").prop("checked", true);
                    $(".request-entry").each(function() {
                        var $row = $(this);
                        $row.find(".punch-status-group, .punch-location-group").fadeIn(200);
                        updateVisibilityForRow($row);
                    });
                } else {
                    $("#waivePenaltyGroup").show();
                    $(".request-entry").each(function() {
                        var $row = $(this);
                        $row.find(".punch-status-group, .punch-location-group, .punch-in-time-group, .punch-out-time-group").fadeOut(200);
                    });
                }
            }

            function updateVisibilityForRow($row) {
                var type = $("#Regularization_RequestType").val();
                if (type !== "Missed Punch") return;

                var target = $row.find("input[type='radio']:checked").val();
                
                if (target === "in") {
                    $row.find(".punch-in-time-group").show();
                    $row.find(".punch-out-time-group").hide();
                } else if (target === "out") {
                    $row.find(".punch-in-time-group").hide();
                    $row.find(".punch-out-time-group").show();
                } else {
                    $row.find(".punch-in-time-group, .punch-out-time-group").show();
                }
                autoFillTimesForRow($row);
            }

            function autoFillTimesForRow($row) {
                var shift = $row.data("shift");
                if (!shift) return;

                var target = $row.find("input[type='radio']:checked").val();
                var date = $row.find(".request-date").val();

                if (target === "in" || target === "both") {
                    $row.find(".punch-in-time").val(formatDateTimeForInput(date, shift.start));
                } else {
                    $row.find(".punch-in-time").val('');
                }

                if (target === "out" || target === "both") {
                    $row.find(".punch-out-time").val(formatDateTimeForInput(date, shift.end));
                } else {
                    $row.find(".punch-out-time").val('');
                }
            }

            function fetchPunchesForRow($row) {
                var type = $("#Regularization_RequestType").val();
                if (type !== "Missed Punch") return;

                var empId = $("#Regularization_EmployeeId").val();
                var date = $row.find(".request-date").val();
                if (!empId || !date) return;

                $.get("?handler=ExistingPunch&employeeId=" + empId + "&date=" + date, function (data) {
                    $row.data("shift", data.shift);

                    if (data.punch) {
                        $row.find(".status-in-time").text(data.punch.inTime || "Missing").toggleClass("text-danger", !data.punch.inTime).toggleClass("text-success", !!data.punch.inTime);
                        $row.find(".status-out-time").text(data.punch.outTime || "Missing").toggleClass("text-danger", !data.punch.outTime).toggleClass("text-success", !!data.punch.outTime);
                        
                        // Smart Auto-selection
                        if (data.punch.inTime && !data.punch.outTime) {
                            $row.find(".target-out").prop("checked", true);
                        } else if (!data.punch.inTime && data.punch.outTime) {
                            $row.find(".target-in").prop("checked", true);
                        } else if (!data.punch.inTime && !data.punch.outTime) {
                            $row.find(".target-both").prop("checked", true);
                        }
                    } else {
                        $row.find(".status-in-time, .status-out-time").text("Missing").addClass("text-danger").removeClass("text-success");
                        $row.find(".target-both").prop("checked", true);
                    }

                    if (data.shift) {
                        $row.find(".shift-info").text("Shift: " + data.shift.start + " - " + data.shift.end);
                    } else {
                        $row.find(".shift-info").text("Shift: Not Assigned");
                    }
                    
                    updateVisibilityForRow($row);
                });
            }

            function updateAppNo() {
                if (!$("#autoAppNo").is(":checked")) return;
                var $firstRow = $(".request-entry").first();
                if ($firstRow.length === 0) return;
                var date = $firstRow.find(".request-date").val();
                if (!date) return;
                $("#appNoLoading").show();
                $("#ApplicationNumber").val('Generating...');
                $.get("?handler=NextAppNo&date=" + date, function (data) {
                    $("#ApplicationNumber").val(data.nextAppNo);
                    $("#appNoLoading").hide();
                });
            }

            $("#Regularization_RequestType").change(function() {
                updateVisibilityForType();
                if ($(this).val() === "Missed Punch") {
                    $(".request-entry").each(function() {
                        fetchPunchesForRow($(this));
                    });
                }
            });

            $("#Regularization_EmployeeId").change(function() {
                var type = $("#Regularization_RequestType").val();
                if (type === "Missed Punch") {
                    $(".request-entry").each(function() {
                        fetchPunchesForRow($(this));
                    });
                }
            });

            $("#autoAppNo").change(function() {
                if($(this).is(":checked")) {
                    $("#ApplicationNumber").prop("readonly", true);
                    updateAppNo();
                } else {
                    $("#ApplicationNumber").prop("readonly", false).val("").focus();
                }
            });

            // Init first row
            addRow();
        });
    </script>
}
