@page
@model AttendanceUI.Pages.WhatsApp.IndexModel
@{
    ViewData["Title"] = "WhatsApp Configuration";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h4 class="mb-0 text-primary"><i class="bi bi-whatsapp"></i> WhatsApp Integration</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted">Manage your HRDesk WhatsApp connection.</p>
                    
                    <div class="alert @(Model.WhatsAppStatus == "connected" ? "alert-success" : "alert-warning")" role="alert">
                        <strong>Status:</strong> 
                        @if (Model.WhatsAppStatus == "connected")
                        {
                            <span>Connected & Ready</span>
                        }
                        else if (Model.WhatsAppStatus == "qr_ready")
                        {
                            <span>Awaiting QR Scan</span>
                        }
                        else if (Model.WhatsAppStatus == "disconnected")
                        {
                            <span>Disconnected (Is the Node.js service running?)</span>
                        }
                        else
                        {
                            <span>@Model.WhatsAppStatus</span>
                        }
                    </div>

                    @if (Model.WhatsAppStatus == "connected")
                    {
                        <div class="card border-success mt-4">
                            <div class="card-body">
                                <h5>Queue Status</h5>
                                <p>There are currently <strong>@Model.QueueLength</strong> messages in the outgoing queue.</p>
                                <p class="text-muted small">Messages are sent slowly (30-60s delay) to prevent bans.</p>
                            </div>
                        </div>
                    }
                    else if (Model.WhatsAppStatus == "qr_ready" && !string.IsNullOrEmpty(Model.QrCodeData))
                    {
                        <div class="card mt-4 text-center p-4">
                            <h5>Scan to Link Device</h5>
                            <p class="text-muted">Open WhatsApp on your phone, go to Linked Devices, and scan this code.</p>
                            <div id="qrcode" class="d-flex justify-content-center my-3"></div>
                            
                            <p class="small text-danger mt-2">Note: This page does not auto-refresh. Please refresh the page after scanning.</p>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.WhatsAppStatus == "qr_ready" && !string.IsNullOrEmpty(Model.QrCodeData))
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                var qrData = "@Html.Raw(Model.QrCodeData)";
                new QRCode(document.getElementById("qrcode"), {
                    text: qrData,
                    width: 256,
                    height: 256,
                    colorDark : "#000000",
                    colorLight : "#ffffff",
                    correctLevel : QRCode.CorrectLevel.M
                });
            });
        </script>
    }
}
